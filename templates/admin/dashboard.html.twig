{% extends 'base.html.twig' %}

{% block title %}Tableau de bord Admin | DevSpot{% endblock %}

{% block body %}
    {% set activationRate = stats.totalUsers > 0 ? ((stats.totalApplicants + stats.totalRecruiters) / stats.totalUsers * 100)|round : 0 %}

    <section class="w-full max-w-7xl space-y-8 font-sans">
        <div class="theme-settings-card rounded-[2.75rem] p-8 sm:p-10">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                <div>
                    <p class="premium-kicker mb-4 inline-flex rounded-full px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.24em]">
                        Admin panel
                    </p>
                    <h1 class="ui-title text-4xl font-semibold tracking-tight">Tableau de bord administrateur</h1>
                    <p class="ui-text-muted mt-2 text-[15px]">Bienvenue sur votre espace d'administration.</p>
                </div>
                <div class="premium-card-soft rounded-[1.75rem] p-4 lg:min-w-80">
                    <p class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Connecté en tant que</p>
                    <p class="ui-title mt-2 text-lg font-semibold break-all">{{ app.user.email }}</p>
                </div>
            </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <article class="premium-stat-card rounded-[1.9rem] p-6">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="ui-text-muted text-sm font-medium">Utilisateurs totaux</p>
                        <p class="ui-title mt-2 text-3xl font-bold">{{ stats.totalUsers }}</p>
                    </div>
                    <span class="premium-icon premium-icon-info">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 8v6"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M23 11h-6"></path>
                        </svg>
                    </span>
                </div>
                <p class="ui-text-muted mt-4 text-xs">Tous les comptes de la plateforme.</p>
            </article>

            <article class="premium-stat-card rounded-[1.9rem] p-6">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="ui-text-muted text-sm font-medium">Candidats</p>
                        <p class="ui-title mt-2 text-3xl font-bold">{{ stats.totalApplicants }}</p>
                    </div>
                    <span class="premium-icon premium-icon-success">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m13 2-8 12h6l-1 8 9-13h-6z"></path>
                        </svg>
                    </span>
                </div>
                <p class="ui-text-muted mt-4 text-xs">Développeurs actifs et visibles.</p>
            </article>

            <article class="premium-stat-card rounded-[1.9rem] p-6">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="ui-text-muted text-sm font-medium">Recruteurs</p>
                        <p class="ui-title mt-2 text-3xl font-bold">{{ stats.totalRecruiters }}</p>
                    </div>
                    <span class="premium-icon premium-icon-violet">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V5a4 4 0 1 1 8 0v2"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16l-1 12H5z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 11v4"></path>
                        </svg>
                    </span>
                </div>
                <p class="ui-text-muted mt-4 text-xs">Entreprises et équipes RH.</p>
            </article>

            <article class="premium-stat-card rounded-[1.9rem] p-6">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="ui-text-muted text-sm font-medium">Messages</p>
                        <p class="ui-title mt-2 text-3xl font-bold">{{ stats.unreadMessages }}</p>
                    </div>
                    <span class="premium-icon premium-icon-warning">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 6h18v12H3z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m3 7 9 6 9-6"></path>
                        </svg>
                    </span>
                </div>
                <p class="ui-text-muted mt-4 text-xs">Messages non lus à traiter.</p>
            </article>
        </div>

        <div class="grid gap-6 xl:grid-cols-[1.35fr_0.95fr]">
            <div class="space-y-6">
                <div class="theme-settings-card rounded-[2.35rem] p-6 sm:p-8">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h2 class="ui-title text-2xl font-semibold tracking-tight">Gestion de la plateforme</h2>
                            <p class="ui-text-muted mt-2 max-w-2xl text-[15px]">Accédez rapidement aux modules de supervision et aux espaces de modération les plus utilisés.</p>
                        </div>
                        <span class="premium-kicker rounded-full px-3 py-1.5 text-xs font-semibold">Pilotage global</span>
                    </div>

                    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <a href="{{ path('app_admin_users') }}" class="premium-action-card group rounded-[1.75rem] p-6">
                            <span class="premium-icon premium-icon-info">
                                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </span>
                            <h3 class="ui-title mt-4 font-semibold">Gérer les utilisateurs</h3>
                            <p class="ui-text-muted mt-2 text-sm">{{ stats.totalUsers }} utilisateurs enregistrés.</p>
                            <span class="ui-link-accent mt-4 inline-flex items-center text-sm font-semibold">Ouvrir le module →</span>
                        </a>

                        <a href="{{ path('app_admin_profiles') }}" class="premium-action-card group rounded-[1.75rem] p-6">
                            <span class="premium-icon premium-icon-success">
                                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5h18v14H3z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9h8"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 13h5"></path>
                                </svg>
                            </span>
                            <h3 class="ui-title mt-4 font-semibold">Profils développeur</h3>
                            <p class="ui-text-muted mt-2 text-sm">{{ stats.totalProfiles }} profils à superviser.</p>
                            <span class="ui-link-accent mt-4 inline-flex items-center text-sm font-semibold">Ouvrir le module →</span>
                        </a>

                        <a href="{{ path('app_admin_companies') }}" class="premium-action-card group rounded-[1.75rem] p-6">
                            <span class="premium-icon premium-icon-violet">
                                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 21h18"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 21V7l7-4 7 4v14"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 10h6"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 14h6"></path>
                                </svg>
                            </span>
                            <h3 class="ui-title mt-4 font-semibold">Gérer les entreprises</h3>
                            <p class="ui-text-muted mt-2 text-sm">{{ stats.totalCompanies }} entreprises suivies.</p>
                            <span class="ui-link-accent mt-4 inline-flex items-center text-sm font-semibold">Ouvrir le module →</span>
                        </a>

                        <a href="{{ path('app_admin_messages') }}" class="premium-action-card group rounded-[1.75rem] p-6">
                            <span class="premium-icon premium-icon-warning">
                                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </span>
                            <h3 class="ui-title mt-4 font-semibold">Messages de contact</h3>
                            <p class="ui-text-muted mt-2 text-sm">{{ stats.totalMessages }} messages reçus.</p>
                            <span class="ui-link-accent mt-4 inline-flex items-center text-sm font-semibold">Ouvrir le module →</span>
                        </a>
                    </div>
                </div>

                <div class="theme-settings-card rounded-[2.35rem] p-6">
                    <div class="mb-6 flex items-center justify-between gap-3">
                        <h2 class="ui-title text-xl font-semibold">Derniers utilisateurs</h2>
                        <a href="{{ path('app_admin_users') }}" class="ui-link-accent text-sm font-semibold">Voir tous →</a>
                    </div>

                    <div class="space-y-3">
                        {% if recentUsers is not empty %}
                            {% for user in recentUsers %}
                                <div class="premium-list-row flex items-center justify-between gap-4 rounded-[1.4rem] p-4">
                                    <div class="min-w-0 flex-1">
                                        <p class="ui-title truncate text-sm font-semibold">{{ user.email }}</p>
                                        <div class="mt-2">
                                            {% if 'ROLE_APPLICANT' in user.roles %}
                                                <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-semibold u-border-pale-emerald u-bg-pale-emerald u-text-pale-emerald">Candidat</span>
                                            {% elseif 'ROLE_RECRUITER' in user.roles %}
                                                <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-semibold u-border-pale-purple u-bg-pale-purple u-text-pale-purple">Recruteur</span>
                                            {% else %}
                                                <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-semibold u-border-pale-blue u-bg-pale-blue u-text-pale-blue">Admin</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <p class="ui-text-muted shrink-0 text-xs">{{ user.createdAt|date('d/m/Y') }}</p>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="premium-card-soft rounded-[1.4rem] p-4">
                                <p class="ui-text-muted text-sm">Aucun utilisateur récent à afficher.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <aside class="space-y-6">
                <div class="theme-settings-card rounded-[2.35rem] p-6">
                    <h3 class="ui-title text-lg font-semibold">Statistiques clés</h3>
                    <div class="mt-4 space-y-3">
                        <div class="premium-divider flex items-center justify-between gap-3 border-b py-2">
                            <span class="ui-text-muted text-sm">Profils complets</span>
                            <span class="ui-title font-semibold">{{ stats.totalProfiles }}</span>
                        </div>
                        <div class="premium-divider flex items-center justify-between gap-3 border-b py-2">
                            <span class="ui-text-muted text-sm">Entreprises</span>
                            <span class="ui-title font-semibold">{{ stats.totalCompanies }}</span>
                        </div>
                        <div class="flex items-center justify-between gap-3 py-2">
                            <span class="ui-text-muted text-sm">Taux d'activation</span>
                            <span class="ui-pill ui-pill-success rounded-full px-2.5 py-1 text-xs font-semibold">{{ activationRate }}%</span>
                        </div>
                    </div>
                </div>

                <div class="theme-settings-card rounded-[2.35rem] p-6">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <h3 class="ui-title text-lg font-semibold">Messages</h3>
                        {% if stats.unreadMessages > 0 %}
                            <span class="ui-pill ui-pill-danger rounded-full px-2.5 py-1 text-xs font-semibold">{{ stats.unreadMessages }}</span>
                        {% endif %}
                    </div>

                    <div class="space-y-2">
                        {% if recentMessages %}
                            {% for message in recentMessages[:3] %}
                                <div class="premium-list-row rounded-[1.4rem] border-l-2 p-4 {{ not message.isRead ? 'u-border-pale-red' : 'premium-divider' }}">
                                    <p class="ui-title truncate text-sm font-semibold">{{ message.subject }}</p>
                                    <p class="ui-text-muted mt-1 text-xs">{{ message.recruiterEmail }}</p>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="premium-card-soft rounded-[1.4rem] p-4">
                                <p class="ui-text-muted text-sm">Aucun message.</p>
                            </div>
                        {% endif %}
                    </div>

                    <a href="{{ path('app_admin_messages') }}" class="ui-link-accent mt-4 inline-flex text-sm font-semibold">Voir tous les messages →</a>
                </div>

                <div class="theme-settings-card rounded-[2.35rem] p-6">
                    <h3 class="ui-title text-lg font-semibold">Actions rapides</h3>
                    <div class="mt-4 space-y-3">
                        <button onclick="alert('Fonctionnalité à implémenter')" class="premium-action-card flex w-full items-center gap-3 rounded-[1.4rem] p-4 text-left">
                            <span class="premium-icon premium-icon-success">
                                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 19h16"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 15h12"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 11h8"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 7h4"></path>
                                </svg>
                            </span>
                            <span>
                                <span class="ui-title block text-sm font-semibold">Générer rapport</span>
                                <span class="ui-text-muted block text-xs">Créer un export récapitulatif.</span>
                            </span>
                        </button>

                        <button onclick="alert('Fonctionnalité à implémenter')" class="premium-action-card flex w-full items-center gap-3 rounded-[1.4rem] p-4 text-left">
                            <span class="premium-icon premium-icon-info">
                                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 19h16"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5h16v10H4z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m4 15 4-4 3 3 5-5 4 4"></path>
                                </svg>
                            </span>
                            <span>
                                <span class="ui-title block text-sm font-semibold">Exporter données</span>
                                <span class="ui-text-muted block text-xs">Préparer les données de supervision.</span>
                            </span>
                        </button>

                        <button onclick="alert('Fonctionnalité à implémenter')" class="premium-action-card flex w-full items-center gap-3 rounded-[1.4rem] p-4 text-left">
                            <span class="premium-icon premium-icon-violet">
                                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
                                </svg>
                            </span>
                            <span>
                                <span class="ui-title block text-sm font-semibold">Paramètres</span>
                                <span class="ui-text-muted block text-xs">Ajuster les préférences globales.</span>
                            </span>
                        </button>
                    </div>
                </div>
            </aside>
        </div>
    </section>
{% endblock %}
