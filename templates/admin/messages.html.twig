{% extends 'base.html.twig' %}

{% block title %}Gérer les messages | DevSpot Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        summary::-webkit-details-marker {
            display: none;
        }

        summary::marker {
            content: '';
        }

        .admin-messages-sort-button {
            display: inline-flex;
            width: 100%;
            align-items: center;
            gap: 0.45rem;
            color: inherit;
            font: inherit;
            background: transparent;
            border: 0;
            padding: 0;
            cursor: pointer;
            text-align: left;
        }

        .admin-messages-sort-indicator {
            color: #94a3b8;
            font-size: 0.7rem;
            line-height: 1;
        }

        .admin-messages-sort-button.is-active .admin-messages-sort-indicator {
            color: #cbd5e1;
        }

        .admin-messages-status-unread {
            border: 1px solid var(--ui-warning-border);
            background: var(--ui-warning-bg);
            color: var(--ui-warning-text);
        }

        .admin-messages-status-read {
            border: 1px solid var(--ui-success-border);
            background: var(--ui-success-bg);
            color: var(--ui-success-text);
        }

        .admin-messages-action-reply {
            border: 1px solid var(--ui-info-border);
            background: var(--ui-info-bg);
            color: var(--ui-info-text);
        }

        .admin-messages-action-danger {
            border: 1px solid var(--ui-danger-border);
            background: var(--ui-danger-bg);
            color: var(--ui-danger-text);
        }

        .admin-messages-action-reply,
        .admin-messages-action-danger {
            transition: transform 0.2s ease, filter 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        }

        .admin-messages-action-reply:hover,
        .admin-messages-action-danger:hover {
            transform: translateY(-1px);
            filter: brightness(0.98);
        }

        :root[data-theme="dark"] .admin-messages-action-reply:hover,
        :root[data-theme="dark"] .admin-messages-action-danger:hover {
            filter: brightness(1.08);
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            const initAdminMessagesTable = () => {
                const root = document.querySelector('[data-admin-messages-root="true"]');
                if (!root || root.dataset.initialized === 'true') {
                    return;
                }

                root.dataset.initialized = 'true';

                const normalizeText = (value) => String(value ?? '')
                    .trim()
                    .toLowerCase()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '');

                const searchInput = root.querySelector('[data-admin-messages-search="true"]');
                const searchCount = root.querySelector('[data-admin-messages-search-count="true"]');
                const table = root.querySelector('[data-admin-messages-table="true"]');
                const tableBody = table ? table.querySelector('tbody') : null;
                const emptySearchRow = root.querySelector('[data-admin-messages-empty-search="true"]');

                const getRows = () => Array.from(root.querySelectorAll('tr[data-admin-message-row="true"]'));

                const applySearch = () => {
                    if (!searchInput) {
                        return;
                    }

                    const query = normalizeText(searchInput.value);
                    const rows = getRows();
                    let visible = 0;

                    rows.forEach((row) => {
                        const haystack = normalizeText(row.dataset.searchText || row.innerText || row.textContent || '');
                        const matches = !query || haystack.includes(query);
                        row.classList.toggle('hidden', !matches);
                        if (matches) {
                            visible += 1;
                        }
                    });

                    if (searchCount) {
                        if (query) {
                            searchCount.textContent = `${visible} résultat${visible > 1 ? 's' : ''} sur ${rows.length}`;
                            searchCount.classList.remove('hidden');
                        } else {
                            searchCount.classList.add('hidden');
                        }
                    }

                    if (emptySearchRow) {
                        emptySearchRow.classList.toggle('hidden', !query || visible !== 0);
                    }
                };

                if (searchInput) {
                    searchInput.addEventListener('input', applySearch);
                }

                const sortButtons = root.querySelectorAll('[data-admin-messages-sort-button="true"]');
                if (tableBody && sortButtons.length) {
                    const getCellComparableValue = (row, columnIndex, type) => {
                        const cell = row.children[columnIndex];
                        if (!cell) {
                            return '';
                        }

                        const rawValue = cell.dataset.value || cell.innerText || cell.textContent || '';
                        if (type === 'number') {
                            return Number(rawValue) || 0;
                        }

                        return normalizeText(rawValue);
                    };

                    const updateSortIndicators = (activeButton, direction) => {
                        sortButtons.forEach((button) => {
                            const indicator = button.querySelector('[data-admin-messages-sort-indicator="true"]');
                            button.classList.remove('is-active');
                            button.setAttribute('aria-pressed', 'false');

                            if (indicator) {
                                indicator.textContent = '↕';
                            }

                            const header = button.closest('th');
                            if (header) {
                                header.setAttribute('aria-sort', 'none');
                            }
                        });

                        activeButton.classList.add('is-active');
                        activeButton.setAttribute('aria-pressed', 'true');

                        const activeIndicator = activeButton.querySelector('[data-admin-messages-sort-indicator="true"]');
                        if (activeIndicator) {
                            activeIndicator.textContent = direction === 'asc' ? '↑' : '↓';
                        }

                        const activeHeader = activeButton.closest('th');
                        if (activeHeader) {
                            activeHeader.setAttribute('aria-sort', direction === 'asc' ? 'ascending' : 'descending');
                        }
                    };

                    sortButtons.forEach((button) => {
                        button.addEventListener('click', () => {
                            const columnIndex = Number.parseInt(button.dataset.columnIndex || '', 10);
                            if (Number.isNaN(columnIndex)) {
                                return;
                            }

                            const type = button.dataset.type || 'text';
                            const nextDirection = button.dataset.direction === 'asc' ? 'desc' : 'asc';
                            button.dataset.direction = nextDirection;

                            sortButtons.forEach((otherButton) => {
                                if (otherButton !== button) {
                                    otherButton.dataset.direction = '';
                                }
                            });

                            const rows = getRows();
                            rows.sort((rowA, rowB) => {
                                const valueA = getCellComparableValue(rowA, columnIndex, type);
                                const valueB = getCellComparableValue(rowB, columnIndex, type);

                                if (valueA === valueB) {
                                    return 0;
                                }

                                if (nextDirection === 'asc') {
                                    return valueA > valueB ? 1 : -1;
                                }

                                return valueA < valueB ? 1 : -1;
                            });

                            rows.forEach((row) => tableBody.appendChild(row));
                            updateSortIndicators(button, nextDirection);
                            applySearch();
                        });
                    });
                }

                applySearch();
            };

            document.addEventListener('DOMContentLoaded', initAdminMessagesTable);
            document.addEventListener('turbo:load', initAdminMessagesTable);
        })();
    </script>
{% endblock %}

{% block body %}
<section class="favorites-showcase-page relative z-[1] w-full max-w-[86rem] self-start px-5 pb-8 pt-2 font-sans sm:px-8 sm:pb-10 sm:pt-3 lg:px-10 lg:pb-12 lg:pt-4" data-admin-messages-root="true">
    <div class="favorite-showcase-hero mx-auto max-w-3xl text-center">
        <p class="favorite-showcase-kicker">Administration</p>
        <h1 class="ui-title mt-6 text-3xl font-semibold tracking-tight sm:text-4xl">Messages de contact.</h1>
        <p class="ui-text-secondary mx-auto mt-4 max-w-2xl text-[13px] leading-relaxed sm:text-[15px]">
            Supervise les demandes entrantes, retrouve rapidement un échange et traite les messages depuis une vue admin unique.
        </p>
    </div>

    <div class="mt-10 lg:mt-12">
        <div class="w-full rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
            <div class="space-y-6">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="min-w-[260px] w-full lg:w-1/2 lg:flex-none">
                        <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3 transition focus-within:border-emerald-400/40 focus-within:ring-2 focus-within:ring-emerald-500/20">
                            <svg class="h-5 w-5 shrink-0 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="11" cy="11" r="8"></circle>
                                <path stroke-linecap="round" d="m21 21-4.35-4.35"></path>
                            </svg>
                            <input
                                type="text"
                                placeholder="Rechercher par sujet, email, nom ou contenu..."
                                class="w-full bg-transparent text-sm text-white placeholder-slate-500 outline-none"
                                data-admin-messages-search="true"
                                aria-label="Rechercher un message"
                                spellcheck="false"
                            >
                        </div>
                        <p class="mt-2 hidden text-xs text-slate-400" data-admin-messages-search-count="true"></p>
                    </div>

                    <div class="flex items-center gap-2">
                        <button type="button" class="favorite-showcase-toolbar-pill inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/12 hover:text-white">
                            Filtres
                        </button>
                        <a href="{{ path('app_admin_messages') }}" class="favorite-showcase-toolbar-pill inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/12 hover:text-white">
                            Réinitialiser
                        </a>
                        <span class="favorite-showcase-toolbar-count inline-flex h-9 min-w-9 items-center justify-center rounded-full px-3 text-sm font-bold">{{ totalMessages }}</span>
                    </div>
                </div>

            {% if messages|length > 0 %}
                <div class="w-full overflow-hidden rounded-[1.5rem] border border-white/10 bg-slate-950/30">
                    <div class="overflow-x-auto">
                        <table class="w-full" data-admin-messages-table="true">
                        <thead>
                            <tr class="border-b border-white/15 bg-slate-950/65">
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300" aria-sort="none">
                                    <button type="button" class="admin-messages-sort-button" data-admin-messages-sort-button="true" data-column-index="0" data-type="text" data-direction="" aria-pressed="false">
                                        <span>Sujet</span><span class="admin-messages-sort-indicator" data-admin-messages-sort-indicator="true">↕</span>
                                    </button>
                                </th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300" aria-sort="none">
                                    <button type="button" class="admin-messages-sort-button" data-admin-messages-sort-button="true" data-column-index="1" data-type="text" data-direction="" aria-pressed="false">
                                        <span>Expéditeur</span><span class="admin-messages-sort-indicator" data-admin-messages-sort-indicator="true">↕</span>
                                    </button>
                                </th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300" aria-sort="none">
                                    <button type="button" class="admin-messages-sort-button" data-admin-messages-sort-button="true" data-column-index="2" data-type="text" data-direction="" aria-pressed="false">
                                        <span>Statut</span><span class="admin-messages-sort-indicator" data-admin-messages-sort-indicator="true">↕</span>
                                    </button>
                                </th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300" aria-sort="none">
                                    <button type="button" class="admin-messages-sort-button" data-admin-messages-sort-button="true" data-column-index="3" data-type="number" data-direction="" aria-pressed="false">
                                        <span>Reçu le</span><span class="admin-messages-sort-indicator" data-admin-messages-sort-indicator="true">↕</span>
                                    </button>
                                </th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Aperçu</th>
                                <th class="px-6 py-4 text-center text-sm font-semibold text-slate-300">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/10">
                            {% for message in messages %}
                                {% set preview = message.message|length > 160 ? message.message|slice(0, 160) ~ '...' : message.message %}
                                {% set replySubject = ('Re: ' ~ (message.subject ?: 'Message DevSpot'))|url_encode %}
                                {% set replyBody = ('Bonjour ' ~ (message.recruiterName ?: '') ~ ',' ~ "\n\n")|url_encode %}
                                <tr
                                    data-admin-message-row="true"
                                    data-search-text="{{ ((message.subject ?: '') ~ ' ' ~ (message.recruiterEmail ?: '') ~ ' ' ~ (message.recruiterName ?: '') ~ ' ' ~ (message.message ?: ''))|lower }}"
                                    class="transition-colors duration-200 {{ loop.index is odd ? 'bg-white/[0.04] hover:bg-white/[0.08]' : 'bg-white/[0.02] hover:bg-white/[0.06]' }}"
                                >
                                    <td class="px-6 py-4 align-top" data-value="{{ message.subject ?: '' }}">
                                        <p class="text-sm font-semibold text-slate-100">{{ message.subject ?: 'Sans sujet' }}</p>
                                    </td>
                                    <td class="px-6 py-4 align-top" data-value="{{ (message.recruiterName ?: '') ~ ' ' ~ (message.recruiterEmail ?: '') }}">
                                        <div class="min-w-[15rem]">
                                            <p class="text-sm font-medium text-slate-100">{{ message.recruiterEmail ?: '-' }}</p>
                                            <p class="mt-1 text-xs text-slate-400">{{ message.recruiterName ?: 'Nom inconnu' }}</p>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 align-top" data-value="{{ message.isRead ? 'read' : 'unread' }}">
                                        <span class="{{ message.isRead ? 'admin-messages-status-read' : 'admin-messages-status-unread' }} inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold">
                                            {{ message.isRead ? 'Lu' : 'Non lu' }}
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 align-top text-sm text-slate-300" data-value="{{ message.createdAt ? message.createdAt|date('U') : 0 }}">
                                        {{ message.createdAt ? message.createdAt|date('d/m/Y H:i') : '-' }}
                                    </td>
                                    <td class="px-6 py-4 align-top text-sm leading-6 text-slate-300" title="{{ message.message }}">
                                        <div class="max-w-[26rem]">
                                            {{ preview ?: '-' }}
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 align-top text-center">
                                        <details class="group relative inline-block text-left">
                                            <summary class="flex cursor-pointer list-none items-center justify-center gap-2 rounded-lg bg-white/5 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-white/10">
                                                <span>Gérer</span>
                                                <svg class="h-3.5 w-3.5 text-slate-300 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="m5 7 5 6 5-6"></path>
                                                </svg>
                                            </summary>
                                            <div class="absolute right-0 top-full z-40 mt-2 min-w-[220px] space-y-2 rounded-xl border border-white/10 bg-slate-950/95 p-3 shadow-2xl shadow-black/50">
                                                <a href="mailto:{{ message.recruiterEmail }}?subject={{ replySubject }}&body={{ replyBody }}" class="admin-messages-action-reply block w-full rounded-lg px-3 py-2 text-center text-xs font-semibold">
                                                    Répondre
                                                </a>
                                                <form method="post" action="{{ path('app_admin_messages_delete', {id: message.id}) }}" onsubmit="return confirm('Supprimer ce message de contact ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_message_delete_' ~ message.id) }}">
                                                    <button type="submit" class="admin-messages-action-danger w-full rounded-lg px-3 py-2 text-xs font-semibold">
                                                        Supprimer
                                                    </button>
                                                </form>
                                            </div>
                                        </details>
                                    </td>
                                </tr>
                            {% endfor %}
                            <tr class="hidden" data-admin-messages-empty-search="true">
                                <td colspan="6" class="px-6 py-10 text-center text-sm text-slate-400">Aucun message ne correspond à la recherche.</td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                </div>

                {% if totalPages > 1 %}
                    <div class="flex items-center justify-between rounded-[1.5rem] border border-white/10 bg-slate-950/30 px-5 py-4">
                        <p class="text-sm text-slate-400">Page {{ currentPage }} / {{ totalPages }}</p>
                        <div class="flex items-center gap-2">
                            {% if currentPage > 1 %}
                                <a href="{{ path('app_admin_messages', {page: currentPage - 1}) }}" class="rounded-lg bg-white/5 px-3 py-2 text-sm font-semibold text-slate-200 hover:bg-white/10">Précédent</a>
                            {% endif %}
                            {% if currentPage < totalPages %}
                                <a href="{{ path('app_admin_messages', {page: currentPage + 1}) }}" class="rounded-lg bg-white/5 px-3 py-2 text-sm font-semibold text-slate-200 hover:bg-white/10">Suivant</a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <div class="favorite-showcase-empty rounded-[2.2rem] px-6 py-10 text-center sm:px-8">
                    <p class="ui-title text-xl font-semibold">Aucun message trouvé</p>
                    <p class="ui-text-secondary mx-auto mt-3 max-w-2xl text-sm leading-relaxed sm:text-[15px]">
                        Les messages de contact apparaitront ici dès qu'un recruteur écrira à un profil.
                    </p>
                </div>
            {% endif %}
            </div>
        </div>
    </div>

    <p class="favorite-showcase-footnote mt-10 text-center text-sm sm:text-[15px]">
        Trie rapidement les demandes, réponds directement par email et garde la boite de contact propre côté administration.
    </p>
</section>
{% endblock %}
