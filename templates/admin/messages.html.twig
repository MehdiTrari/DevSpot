{% extends 'base.html.twig' %}

{% block title %}Messages de contact | DevSpot Admin{% endblock %}

{% block body %}
    <section class="w-full space-y-8 font-sans">
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-semibold tracking-tight text-white">Messages de contact</h1>
                    <p class="mt-2 text-[15px] text-slate-400">Supervise les échanges entrants et traite les demandes en attente.</p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="{{ path('app_admin_messages') }}" class="favorite-showcase-toolbar-pill inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/12 hover:text-white">
                        Réinitialiser
                    </a>
                    <button type="button" class="favorite-showcase-toolbar-pill inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/12 hover:text-white">
                        Filtres
                    </button>
                    <span class="favorite-showcase-toolbar-count inline-flex h-9 min-w-9 items-center justify-center rounded-full px-3 text-sm font-bold">{{ messages|length }}</span>
                </div>
            </div>
        </div>

        {% if messages|length > 0 %}
            <div class="theme-settings-card rounded-[2.35rem] p-6 sm:p-8">
                <div class="space-y-4">
                    {% for message in messages %}
                        <article class="premium-action-card rounded-[1.75rem] p-6">
                            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                                <div class="min-w-0 flex-1">
                                    <div class="mb-2 flex flex-wrap items-center gap-3">
                                        <h2 class="ui-title text-lg font-semibold">{{ message.subject }}</h2>
                                        {% if not message.isRead %}
                                            <span class="ui-pill ui-pill-warning rounded-full px-2.5 py-1 text-xs font-semibold">Non lu</span>
                                        {% else %}
                                            <span class="ui-pill ui-pill-muted rounded-full px-2.5 py-1 text-xs font-semibold">Lu</span>
                                        {% endif %}
                                    </div>
                                    <p class="ui-text-secondary text-sm">De : <span class="ui-title font-medium">{{ message.recruiterEmail }}</span></p>
                                    <p class="ui-text-muted mt-1 text-sm">Nom : {{ message.recruiterName }}</p>
                                </div>
                                <p class="ui-text-muted shrink-0 whitespace-nowrap text-xs">{{ message.createdAt|date('d/m/Y à H:i') }}</p>
                            </div>

                            <div class="premium-card-soft mt-4 rounded-[1.25rem] p-4">
                                <p class="ui-text-primary text-sm leading-relaxed">{{ message.message[:200] }}{% if message.message|length > 200 %}...{% endif %}</p>
                            </div>

                            <div class="premium-divider mt-4 flex gap-2 border-t pt-4 sm:justify-end">
                                <button class="ui-button-warning rounded-lg px-4 py-2 text-sm font-medium" onclick="alert('Réponse à implémenter')">
                                    Répondre
                                </button>
                                <button class="ui-button-danger rounded-lg px-4 py-2 text-sm font-medium" onclick="alert('Suppression à implémenter')">
                                    Supprimer
                                </button>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="theme-settings-card rounded-[2.35rem] p-12 text-center">
                <p class="ui-text-muted">Aucun message trouvé.</p>
            </div>
        {% endif %}
    </section>
{% endblock %}
