{% extends 'base.html.twig' %}

{% block title %}Historique de moderation | DevSpot Admin{% endblock %}

{% block body %}
<section class="w-full space-y-8 font-sans">
    <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <h1 class="text-4xl font-semibold tracking-tight text-white">Historique de moderation</h1>
                <p class="mt-2 text-[15px] text-slate-400">Trace immuable des decisions prises par l'equipe administrative.</p>
            </div>
            <a href="{{ path('app_admin_dashboard') }}" class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-slate-200 transition-all hover:bg-white/10">
                Retour dashboard
            </a>
        </div>
    </div>

    <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-6 shadow-xl shadow-black/40 backdrop-blur-xl">
        <form method="get" action="{{ path('app_admin_moderation_history') }}" class="grid gap-3 md:grid-cols-4">
            <input type="text" name="adminEmail" value="{{ filters.adminEmail }}" placeholder="Filtrer par admin" class="rounded-xl border border-white/10 bg-slate-900/80 px-4 py-2.5 text-sm text-white placeholder:text-slate-500">
            <input type="text" name="targetEmail" value="{{ filters.targetEmail }}" placeholder="Filtrer par cible" class="rounded-xl border border-white/10 bg-slate-900/80 px-4 py-2.5 text-sm text-white placeholder:text-slate-500">
            <select name="action" class="rounded-xl border border-white/10 bg-slate-900/80 px-4 py-2.5 text-sm text-white">
                <option value="">Toutes les actions</option>
                {% for availableAction in availableActions %}
                    <option value="{{ availableAction }}" {% if filters.action == availableAction %}selected{% endif %}>{{ availableAction }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="rounded-xl bg-emerald-500/20 px-4 py-2.5 text-sm font-semibold text-emerald-300 hover:bg-emerald-500/30">
                Filtrer
            </button>
        </form>
    </div>

    <div class="rounded-2xl border border-white/10 bg-slate-900/50 shadow-2xl shadow-black/40 backdrop-blur-xl">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[980px]">
                <thead>
                    <tr class="border-b border-white/10 bg-slate-950/50">
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Date</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Action</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Admin</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Cible</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Motif</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Metadata</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/10">
                    {% for log in logs %}
                        <tr class="align-top hover:bg-white/5">
                            <td class="px-6 py-4 text-sm text-slate-300">{{ log.createdAt ? log.createdAt|date('d/m/Y H:i:s') : '-' }}</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-semibold text-emerald-300">{{ log.action }}</span>
                            </td>
                            <td class="px-6 py-4 text-sm text-white">{{ log.adminUser ? log.adminUser.email : 'Admin supprime' }}</td>
                            <td class="px-6 py-4 text-sm text-white">{{ log.targetUser ? log.targetUser.email : (log.metadata.targetUserEmail|default('Utilisateur supprime')) }}</td>
                            <td class="px-6 py-4 text-sm text-slate-200">{{ log.reason ?: '-' }}</td>
                            <td class="px-6 py-4 text-xs text-slate-400">
                                {% if log.metadata %}
                                    <pre class="max-w-[360px] overflow-x-auto whitespace-pre-wrap rounded-xl bg-slate-950/70 p-3">{{ log.metadata|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="px-6 py-10 text-center text-sm text-slate-400">Aucune action ne correspond aux filtres.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>
{% endblock %}
