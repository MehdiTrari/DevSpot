{% extends 'base.html.twig' %}

{% block title %}Gérer les profils | DevSpot Admin{% endblock %}

{% block body %}
<section class="favorites-showcase-page relative z-[1] w-full max-w-[86rem] self-start px-5 pb-8 pt-2 font-sans sm:px-8 sm:pb-10 sm:pt-3 lg:px-10 lg:pb-12 lg:pt-4">
    <div class="favorite-showcase-hero mx-auto max-w-3xl text-center">
        <p class="favorite-showcase-kicker">Administration</p>
        <h1 class="ui-title mt-6 text-3xl font-semibold tracking-tight sm:text-4xl">Profils développeur.</h1>
        <p class="ui-text-secondary mx-auto mt-4 max-w-2xl text-[13px] leading-relaxed sm:text-[15px]">
            Visualise rapidement les profils publiés, contrôle leur qualité et garde un suivi clair de l'activité développeur.
        </p>
    </div>

    <div class="mt-10 lg:mt-12">
        <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
            <div class="space-y-6">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="min-w-[260px] w-full lg:w-1/2 lg:flex-none">
                        <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3 transition focus-within:border-emerald-400/40 focus-within:ring-2 focus-within:ring-emerald-500/20">
                            <svg class="h-5 w-5 shrink-0 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
                            <input
                                id="admin-profiles-search"
                                type="text"
                                placeholder="Rechercher par email, titre, compétence..."
                                class="w-full bg-transparent text-sm text-white placeholder-slate-500 outline-none"
                            >
                        </div>
                        <p id="admin-profiles-search-count" class="mt-2 hidden text-xs text-slate-400"></p>
                    </div>

                    <div class="flex items-center gap-2">
                        <button type="button" class="favorite-showcase-toolbar-pill inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/12 hover:text-white">
                            Filtres
                        </button>
                        <a href="{{ path('app_admin_profiles') }}" class="favorite-showcase-toolbar-pill inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/12 hover:text-white">
                            Réinitialiser
                        </a>
                        <span class="favorite-showcase-toolbar-count inline-flex h-9 min-w-9 items-center justify-center rounded-full px-3 text-sm font-bold">{{ totalProfiles }}</span>
                    </div>
                </div>

                {% if profiles|length == 0 %}
                    <div class="favorite-showcase-empty rounded-[2.2rem] px-6 py-10 text-center sm:px-8">
                        <p class="ui-title text-xl font-semibold">Aucun profil développeur trouvé</p>
                        <p class="ui-text-secondary mx-auto mt-3 max-w-2xl text-sm leading-relaxed sm:text-[15px]">
                            Les profils apparaîtront ici dès qu'ils seront créés par les utilisateurs.
                        </p>
                    </div>
                {% else %}
                    <div data-admin-profile-empty-state="true" class="favorite-showcase-empty hidden rounded-[2.2rem] px-6 py-10 text-center sm:px-8">
                        <p class="ui-title text-xl font-semibold">Aucun résultat</p>
                        <p class="ui-text-secondary mx-auto mt-3 max-w-2xl text-sm leading-relaxed sm:text-[15px]">
                            Aucun profil ne correspond à ta recherche.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
                        {% for profile in profiles %}
                            <article data-admin-profile-entry="true" class="flex h-full flex-col rounded-2xl border border-white/10 bg-slate-900/50 p-6 shadow-xl shadow-black/40 backdrop-blur-xl transition-all hover:border-emerald-500/30 hover:bg-slate-900/65">
                                <div class="mb-4 flex items-start justify-between gap-3">
                                    <div class="min-w-0 flex-1">
                                        <h3 class="truncate text-lg font-semibold text-white">{{ profile.user.email }}</h3>
                                        <p class="mt-1 text-sm text-slate-400">{{ profile.headline ?: 'Pas de headline' }}</p>
                                    </div>
                                    <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold {{ profile.moderatedAt ? 'u-border-pale-yellow u-bg-pale-yellow u-text-pale-yellow' : 'u-border-success u-bg-success u-text-success' }}">{{ profile.moderatedAt ? 'Modéré' : 'Actif' }}</span>
                                </div>

                                <div class="space-y-2 text-sm">
                                    {% if profile.profileSkills|length > 0 %}
                                        <p class="text-slate-400">Compétences: <span class="text-white">{{ profile.profileSkills|length }}</span></p>
                                    {% endif %}
                                    <p class="text-slate-500">Créé le {{ profile.createdAt|date('d/m/Y') }}</p>
                                </div>

                                <div class="mt-6 space-y-3 lg:mt-auto lg:pt-4">
                                    <a href="{{ path('app_public_profile_show', { slug: profile.slug }) }}" class="u-border-info u-bg-info u-text-info inline-flex w-full items-center justify-center rounded-full border px-4 py-2.5 text-sm font-semibold transition-opacity hover:opacity-90">
                                        Voir le profil
                                    </a>

                                    <button
                                        type="button"
                                        data-open-moderation-modal="true"
                                        data-moderation-action="{{ path('app_admin_profiles_moderate', { id: profile.id }) }}"
                                        data-moderation-token="{{ csrf_token('admin_profile_moderate_' ~ profile.id) }}"
                                        data-moderation-reason="{{ profile.moderationReason ?: '' }}"
                                        data-moderation-email="{{ profile.user.email }}"
                                        data-moderation-submit-label="Envoyer"
                                        class="u-border-pale-yellow u-bg-pale-yellow u-text-pale-yellow inline-flex w-full items-center justify-center rounded-full border px-4 py-2.5 text-sm font-semibold transition-opacity hover:opacity-90"
                                    >
                                        {{ profile.moderatedAt ? 'Re-modérer / notifier' : 'Modérer le profil' }}
                                    </button>
                                </div>
                            </article>
                        {% endfor %}
                    </div>

                    {% if totalPages > 1 %}
                        <div class="flex items-center justify-between rounded-[1.5rem] border border-white/10 bg-slate-950/30 px-5 py-4">
                            <p class="text-sm text-slate-400">Page {{ currentPage }} / {{ totalPages }}</p>
                            <div class="flex items-center gap-2">
                                {% if currentPage > 1 %}
                                    <a href="{{ path('app_admin_profiles', {page: currentPage - 1}) }}" class="rounded-lg bg-white/5 px-3 py-2 text-sm font-semibold text-slate-200 hover:bg-white/10">Précédent</a>
                                {% endif %}
                                {% if currentPage < totalPages %}
                                    <a href="{{ path('app_admin_profiles', {page: currentPage + 1}) }}" class="rounded-lg bg-white/5 px-3 py-2 text-sm font-semibold text-slate-200 hover:bg-white/10">Suivant</a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>

    <p class="favorite-showcase-footnote mt-10 text-center text-sm sm:text-[15px]">
        Supervisez les profils actifs, identifiez rapidement les anomalies et gardez une vue claire sur la qualité du vivier.
    </p>
</section>

<div id="admin-moderation-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center p-4" aria-hidden="true">
    <div data-moderation-modal-close="true" class="absolute inset-0 backdrop-blur-md" style="background: rgba(9, 15, 24, 0.28); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);"></div>

    <div class="theme-settings-card relative z-[1] w-full max-w-md rounded-[2.35rem] p-6 shadow-2xl shadow-black/50 sm:max-w-lg sm:p-7">
        <div class="flex items-start justify-between gap-3">
            <div>
                <span class="inline-flex rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-emerald-300">Modération</span>
                <h2 class="ui-title mt-4 text-2xl font-semibold tracking-tight">Notifier l'utilisateur</h2>
                <p id="admin-moderation-target" class="ui-text-secondary mt-2 text-sm"></p>
            </div>
            <button type="button" data-moderation-modal-close="true" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-slate-300 transition hover:bg-white/10 hover:text-white" aria-label="Fermer la modale">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m5 5 10 10"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" d="m15 5-10 10"></path>
                </svg>
            </button>
        </div>

        <form id="admin-moderation-form" method="post" class="mt-5 space-y-4">
            <input id="admin-moderation-token" type="hidden" name="_token" value="">

            <div class="space-y-3">
                <label for="admin-moderation-reason" class="ui-title block text-sm font-semibold">Message de modération</label>
                <textarea
                    id="admin-moderation-reason"
                    name="reason"
                    required
                    minlength="6"
                    rows="4"
                    placeholder="Expliquez pourquoi ce profil doit etre revu..."
                    class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-3.5 py-2.5 text-sm text-white placeholder:text-slate-500 outline-none transition focus:border-amber-400/50 focus:ring-2 focus:ring-amber-500/20"
                ></textarea>
                <p class="ui-text-soft text-xs">Ce message sera envoyé au candidat.</p>
            </div>

            <div class="flex items-center justify-end gap-2">
                <button type="button" data-moderation-modal-close="true" class="u-border-pale-slate u-bg-pale-slate u-text-pale-slate inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-semibold transition-opacity hover:opacity-90">
                    Annuler
                </button>
                <button id="admin-moderation-submit" type="submit" class="u-border-success u-bg-success u-text-success inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-semibold transition-opacity hover:opacity-90">
                    Envoyer
                </button>
            </div>
        </form>
    </div>
</div>

<script>
(() => {
    const init = () => {
        const input = document.getElementById('admin-profiles-search');
        const countEl = document.getElementById('admin-profiles-search-count');
        if (!input || !countEl) return;
        if (input.dataset.init === '1') return;
        input.dataset.init = '1';

        const cards = Array.from(document.querySelectorAll('[data-admin-profile-entry="true"]'));
        const emptyState = document.querySelector('[data-admin-profile-empty-state="true"]');
        if (!cards.length) return;

        input.addEventListener('input', () => {
            const q = input.value.trim().toLowerCase();
            let visible = 0;

            cards.forEach(card => {
                const text = card.textContent.toLowerCase();
                const match = !q || text.includes(q);
                card.style.display = match ? '' : 'none';
                if (match) visible++;
            });

            if (q) {
                countEl.textContent = `${visible} résultat${visible !== 1 ? 's' : ''} sur ${cards.length}`;
                countEl.classList.remove('hidden');
            } else {
                countEl.classList.add('hidden');
            }

            if (emptyState) {
                emptyState.classList.toggle('hidden', visible !== 0 || !q);
            }
        });

        const modal = document.getElementById('admin-moderation-modal');
        const modalForm = document.getElementById('admin-moderation-form');
        const tokenInput = document.getElementById('admin-moderation-token');
        const reasonInput = document.getElementById('admin-moderation-reason');
        const submitButton = document.getElementById('admin-moderation-submit');
        const target = document.getElementById('admin-moderation-target');
        if (!modal || !modalForm || !tokenInput || !reasonInput || !submitButton || !target) return;

        if (modal.parentElement !== document.body) {
            document.body.appendChild(modal);
        }

        const closeModal = () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            modal.setAttribute('aria-hidden', 'true');
            modalForm.removeAttribute('action');
            tokenInput.value = '';
            reasonInput.value = '';
            target.textContent = '';
            document.body.classList.remove('overflow-hidden');
        };

        const openModal = (button) => {
            const action = button.dataset.moderationAction;
            const token = button.dataset.moderationToken;
            const reason = button.dataset.moderationReason ?? '';
            const submitLabel = button.dataset.moderationSubmitLabel ?? 'Envoyer';
            const email = button.dataset.moderationEmail ?? '';

            if (!action || !token) return;

            modalForm.action = action;
            tokenInput.value = token;
            reasonInput.value = reason;
            submitButton.textContent = submitLabel;
            target.textContent = email ? `Compte: ${email}` : '';

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('overflow-hidden');
            reasonInput.focus();
            reasonInput.setSelectionRange(reasonInput.value.length, reasonInput.value.length);
        };

        document.querySelectorAll('[data-open-moderation-modal="true"]').forEach((button) => {
            button.addEventListener('click', () => openModal(button));
        });

        modal.querySelectorAll('[data-moderation-modal-close="true"]').forEach((button) => {
            button.addEventListener('click', closeModal);
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
                closeModal();
            }
        });
    };

    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('turbo:load', init);
})();
</script>
{% endblock %}
