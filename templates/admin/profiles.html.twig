{% extends 'base.html.twig' %}

{% block title %}Gérer les profils | DevSpot Admin{% endblock %}

{% block body %}
<section class="w-full space-y-8 font-sans">
    <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h1 class="text-2xl font-semibold tracking-tight text-white">Profils développeur</h1>
                <p class="mt-2 text-[15px] text-slate-400">Visualise rapidement les profils publiés, contrôle leur qualité et garde un suivi clair de l'activité développeur.</p>
            </div>
            <div class="flex items-center gap-2">
                <a href="{{ path('app_admin_profiles') }}" class="favorite-showcase-toolbar-pill inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/12 hover:text-white">
                    Réinitialiser
                </a>
                <button type="button" class="favorite-showcase-toolbar-pill inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/12 hover:text-white">
                    Filtres
                </button>
                <span class="favorite-showcase-toolbar-count inline-flex h-9 min-w-9 items-center justify-center rounded-full px-3 text-sm font-bold">{{ profiles|length }}</span>
            </div>
        </div>
    </div>

    <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
            {% if profiles|length == 0 %}
                <div class="favorite-showcase-empty rounded-[2.2rem] px-6 py-10 text-center sm:px-8">
                    <p class="ui-title text-xl font-semibold">Aucun profil développeur trouvé</p>
                    <p class="ui-text-secondary mx-auto mt-3 max-w-2xl text-sm leading-relaxed sm:text-[15px]">
                        Les profils apparaîtront ici dès qu'ils seront créés par les utilisateurs.
                    </p>
                </div>
            {% else %}
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {% for profile in profiles %}
                        <article class="rounded-2xl border border-white/10 bg-slate-900/50 p-6 shadow-xl shadow-black/40 backdrop-blur-xl transition-all hover:border-emerald-500/30 hover:bg-slate-900/65">
                            <div class="mb-4 flex items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <h3 class="truncate text-lg font-semibold text-white">{{ profile.user.email }}</h3>
                                    <p class="mt-1 text-sm text-slate-400">{{ profile.headline ?: 'Pas de headline' }}</p>
                                </div>
                                <span class="inline-flex items-center rounded-full bg-emerald-500/20 px-2.5 py-1 text-xs font-semibold text-emerald-400">Actif</span>
                            </div>

                            <div class="space-y-2 text-sm">
                                {% if profile.profileSkills|length > 0 %}
                                    <p class="text-slate-400">Compétences: <span class="text-white">{{ profile.profileSkills|length }}</span></p>
                                {% endif %}
                                <p class="text-slate-500">Créé le {{ profile.createdAt|date('d/m/Y') }}</p>
                            </div>

                            <button class="mt-4 w-full rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-2.5 text-sm font-semibold text-emerald-300 transition hover:bg-emerald-500/20" onclick="alert('Détails à implémenter')">
                                Voir le profil
                            </button>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
    </div>

    <p class="favorite-showcase-footnote mt-10 text-center text-sm sm:text-[15px]">
        Supervisez les profils actifs, identifiez rapidement les anomalies et gardez une vue claire sur la qualité du vivier.
    </p>
</section>
{% endblock %}
