{% extends 'base.html.twig' %}

{% block title %}Gérer les profils | DevSpot Admin{% endblock %}

{% block body %}
<section class="w-full space-y-8 font-sans">
    
    {# HEADER #}
    <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
        <div class="flex items-center justify-between">
            <div>
                <a href="{{ path('app_admin_dashboard') }}" class="text-emerald-400 hover:text-emerald-300 text-sm mb-2 inline-block">← Retour au tableau de bord</a>
                <h1 class="text-4xl font-semibold tracking-tight text-white">Profils développeur</h1>
                <p class="mt-2 text-[15px] text-slate-400">{{ profiles|length }} profils au total</p>
            </div>
        </div>
    </div>

    {# GRILLE DES PROFILS #}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for profile in profiles %}
            <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-6 shadow-xl shadow-black/40 backdrop-blur-xl hover:border-emerald-500/30 transition-all">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex-1">
                        <h3 class="text-lg font-semibold text-white">{{ profile.user.email }}</h3>
                        <p class="text-sm text-slate-400 mt-1">{{ profile.headline ?: 'Pas de headline' }}</p>
                    </div>
                    <span class="inline-flex items-center px-2 py-1 rounded text-xs font-semibold {{ profile.moderatedAt ? 'bg-amber-500/20 text-amber-300' : 'bg-emerald-500/20 text-emerald-400' }}">{{ profile.moderatedAt ? 'Modéré' : 'Actif' }}</span>
                </div>
                
                <div class="space-y-2 text-sm">
                    {% if profile.profileSkills|length > 0 %}
                        <div>
                            <p class="text-slate-400">Compétences: <span class="text-white">{{ profile.profileSkills|length }}</span></p>
                        </div>
                    {% endif %}
                    <p class="text-slate-500">Créé le {{ profile.createdAt|date('d/m/Y') }}</p>
                </div>

                <a href="{{ path('app_public_profile_show', { slug: profile.slug }) }}" class="mt-4 inline-flex w-full items-center justify-center py-2 px-4 rounded-lg bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30 transition-colors text-sm font-medium">
                    Voir le profil
                </a>

                <form method="post" action="{{ path('app_admin_profiles_moderate', { id: profile.id }) }}" class="mt-3 space-y-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_profile_moderate_' ~ profile.id) }}">
                    <input type="text" name="reason" value="{{ profile.moderationReason ?: '' }}" placeholder="Motif de modération" class="w-full rounded-lg border border-white/10 bg-slate-950/70 px-3 py-2 text-sm text-white placeholder:text-slate-500">
                    <button type="submit" class="w-full py-2 px-4 rounded-lg bg-amber-500/20 text-amber-300 hover:bg-amber-500/30 transition-colors text-sm font-medium">
                        {{ profile.moderatedAt ? 'Re-modérer / notifier' : 'Modérer le profil' }}
                    </button>
                </form>
            </div>
        {% endfor %}
    </div>

    {% if profiles|length == 0 %}
        <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-12 text-center shadow-xl shadow-black/40 backdrop-blur-xl">
            <p class="text-slate-400">Aucun profil développeur trouvé</p>
        </div>
    {% endif %}
</section>
{% endblock %}
