{% extends 'base.html.twig' %}

{% block title %}Gérer les profils | DevSpot Admin{% endblock %}

{% block body %}
<section class="w-full space-y-8 font-sans">
    
    {# HEADER #}
    <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
        <div class="flex items-center justify-between">
            <div>
                <a href="{{ path('app_admin_dashboard') }}" class="text-emerald-400 hover:text-emerald-300 text-sm mb-2 inline-block">← Retour au tableau de bord</a>
                <h1 class="text-4xl font-semibold tracking-tight text-white">Profils développeur</h1>
                <p class="mt-2 text-[15px] text-slate-400">{{ profiles|length }} profils au total</p>
            </div>
        </div>
    </div>

    {# GRILLE DES PROFILS #}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for profile in profiles %}
            <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-6 shadow-xl shadow-black/40 backdrop-blur-xl hover:border-emerald-500/30 hover:bg-slate-900/60 transition-all">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex-1">
                        <h3 class="text-lg font-semibold text-white">{{ profile.user.email }}</h3>
                        <p class="text-sm text-slate-400 mt-1">{{ profile.headline ?: 'Pas de headline' }}</p>
                    </div>
                    <span class="inline-flex items-center px-2 py-1 rounded text-xs font-semibold bg-emerald-500/20 text-emerald-400">Actif</span>
                </div>
                
                <div class="space-y-2 text-sm">
                    {% if profile.profileSkills|length > 0 %}
                        <div>
                            <p class="text-slate-400">Compétences: <span class="text-white">{{ profile.profileSkills|length }}</span></p>
                        </div>
                    {% endif %}
                    <p class="text-slate-500">Créé le {{ profile.createdAt|date('d/m/Y') }}</p>
                </div>

                <button class="mt-4 w-full py-2 px-4 rounded-lg bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30 transition-colors text-sm font-medium" onclick="alert('Détails à implémenter')">
                    Voir le profil
                </button>
            </div>
        {% endfor %}
    </div>

    {% if profiles|length == 0 %}
        <div class="rounded-2xl border border-white/10 bg-slate-900/50 p-12 text-center shadow-xl shadow-black/40 backdrop-blur-xl">
            <p class="text-slate-400">Aucun profil développeur trouvé</p>
        </div>
    {% endif %}
</section>
{% endblock %}
