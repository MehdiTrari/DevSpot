{% extends 'base.html.twig' %}

{% block title %}Gérer les utilisateurs | DevSpot Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body.admin-users-modal-open main {
            transform: none !important;
            animation: none !important;
        }

        summary::-webkit-details-marker {
            display: none;
        }

        summary::marker {
            content: '';
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const initAdminUsersDynamic = () => {
            const root = document.querySelector('[data-admin-users-root="true"]');
            if (!root || root.dataset.asyncInitialized === 'true') {
                return;
            }
            root.dataset.asyncInitialized = 'true';

            const filterModal = root.querySelector('[data-admin-users-filter-modal="true"]');
            const openFilterButton = root.querySelector('[data-admin-users-open-filters="true"]');
            const closeFilterButtons = root.querySelectorAll('[data-admin-users-close-filters="true"]');
            const pageBody = document.body;

            const openFilterModal = () => {
                if (!filterModal) {
                    return;
                }

                pageBody.classList.add('overflow-hidden');
                pageBody.classList.add('admin-users-modal-open');
                filterModal.classList.remove('hidden');
                filterModal.classList.add('flex');
            };

            const closeFilterModal = () => {
                if (!filterModal) {
                    return;
                }

                filterModal.classList.add('hidden');
                filterModal.classList.remove('flex');

                pageBody.classList.remove('overflow-hidden');
                pageBody.classList.remove('admin-users-modal-open');
            };

            window.AdminUsersFilters = {
                open: openFilterModal,
                close: closeFilterModal,
            };

            if (openFilterButton) {
                openFilterButton.addEventListener('click', openFilterModal);
            }

            closeFilterButtons.forEach((button) => {
                button.addEventListener('click', closeFilterModal);
            });

            if (filterModal) {
                filterModal.addEventListener('click', (event) => {
                    if (event.target === filterModal) {
                        closeFilterModal();
                    }
                });

                document.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape' && !filterModal.classList.contains('hidden')) {
                        closeFilterModal();
                    }
                });
            }

            let activeRequest = null;

            const setLoading = (isLoading) => {
                if (isLoading) {
                    root.classList.add('opacity-70', 'pointer-events-none');
                } else {
                    root.classList.remove('opacity-70', 'pointer-events-none');
                }
            };

            const replaceRootFromHtml = (htmlText) => {
                const parser = new DOMParser();
                const nextDocument = parser.parseFromString(htmlText, 'text/html');
                const nextRoot = nextDocument.querySelector('[data-admin-users-root="true"]');

                if (!nextRoot) {
                    return false;
                }

                root.replaceWith(nextRoot);
                initAdminUsersDynamic();
                return true;
            };

            const visitAsync = async (url) => {
                if (activeRequest) {
                    activeRequest.abort();
                }

                activeRequest = new AbortController();
                setLoading(true);

                try {
                    const response = await fetch(url, {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        credentials: 'same-origin',
                        signal: activeRequest.signal,
                    });

                    if (!response.ok) {
                        window.location.assign(url);
                        return;
                    }

                    const htmlText = await response.text();
                    const replaced = replaceRootFromHtml(htmlText);
                    if (!replaced) {
                        window.location.assign(url);
                    }
                } catch (error) {
                    if (error.name !== 'AbortError') {
                        window.location.assign(url);
                    }
                } finally {
                    setLoading(false);
                }
            };

            root.querySelectorAll('[data-admin-users-pagination="true"]').forEach((link) => {
                link.addEventListener('click', (event) => {
                    event.preventDefault();
                    const url = link.getAttribute('href');
                    if (!url) {
                        return;
                    }
                    window.history.pushState({ adminUsersAsync: true }, '', url);
                    visitAsync(url);
                });
            });

            const filterForm = root.querySelector('[data-admin-users-filters="true"]');
            if (filterForm) {
                const submitFilterForm = () => {
                    const url = new URL(filterForm.action, window.location.origin);
                    const formData = new FormData(filterForm);
                    for (const [key, value] of formData.entries()) {
                        if (String(value).trim() !== '') {
                            url.searchParams.set(key, String(value));
                        } else {
                            url.searchParams.delete(key);
                        }
                    }

                    url.searchParams.delete('page');

                    window.history.pushState({ adminUsersAsync: true }, '', url.toString());
                    visitAsync(url.toString());
                    closeFilterModal();
                };

                filterForm.addEventListener('submit', (event) => {
                    event.preventDefault();
                    submitFilterForm();
                });

                filterForm.querySelectorAll('[data-admin-users-autosubmit="true"]').forEach((field) => {
                    field.addEventListener('change', () => {
                        submitFilterForm();
                    });
                });
            }
        };

        window.addEventListener('popstate', () => {
            if (window.location.pathname !== '{{ path('app_admin_users') }}') {
                return;
            }

            const root = document.querySelector('[data-admin-users-root="true"]');
            if (!root) {
                return;
            }

            fetch(window.location.href, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                },
                credentials: 'same-origin',
            })
                .then((response) => response.text())
                .then((htmlText) => {
                    const parser = new DOMParser();
                    const nextDocument = parser.parseFromString(htmlText, 'text/html');
                    const nextRoot = nextDocument.querySelector('[data-admin-users-root="true"]');
                    if (nextRoot) {
                        root.replaceWith(nextRoot);
                        initAdminUsersDynamic();
                    }
                });
        });

        document.addEventListener('DOMContentLoaded', initAdminUsersDynamic);
        document.addEventListener('turbo:load', initAdminUsersDynamic);
    </script>
{% endblock %}

{% block body %}
<section class="w-full space-y-8 font-sans transition-opacity duration-200" data-admin-users-root="true">
    
    {# HEADER #}
    <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h1 class="text-4xl font-semibold tracking-tight text-white">Gérer les utilisateurs</h1>
                <p class="mt-2 text-[15px] text-slate-400">{{ totalUsersFiltered }} utilisateur(s) trouvé(s)</p>
            </div>
            <div class="flex items-center gap-2">
                <a href="{{ path('app_admin_users') }}" class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-slate-200 transition-all hover:bg-white/10" data-admin-users-pagination="true">
                    Réinitialiser
                </a>
                <button type="button" data-admin-users-open-filters="true" onclick="window.AdminUsersFilters && window.AdminUsersFilters.open(); return false;" class="relative z-20 inline-flex items-center justify-center rounded-xl border border-emerald-300/20 bg-emerald-500/20 px-6 py-3 text-base font-bold tracking-tight text-emerald-200 shadow-lg shadow-emerald-900/20 transition-all hover:scale-[1.01] hover:bg-emerald-500/30">
                    Filtres
                </button>
            </div>
        </div>
    </div>

    <div class="fixed inset-0 z-[80] hidden items-center justify-center bg-slate-950/55 p-4 backdrop-blur-[2px]" data-admin-users-filter-modal="true" onclick="window.AdminUsersFilters && window.AdminUsersFilters.close();">
        <div class="w-full max-w-3xl rounded-2xl border border-white/10 bg-slate-900/95 p-6 shadow-2xl shadow-black/50 backdrop-blur-xl" onclick="event.stopPropagation();">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-lg font-semibold text-white">Filtres utilisateurs</h2>
                <button type="button" data-admin-users-close-filters="true" onclick="window.AdminUsersFilters && window.AdminUsersFilters.close(); return false;" class="rounded-lg bg-white/5 px-3 py-1.5 text-sm font-semibold text-slate-300 hover:bg-white/10">Fermer</button>
            </div>

            <form method="get" action="{{ path('app_admin_users') }}" class="grid grid-cols-1 gap-3 md:grid-cols-2" data-admin-users-filters="true">
                <input type="text" name="q" value="{{ filters.q }}" placeholder="Rechercher par email" class="rounded-xl border border-white/10 bg-slate-900/80 px-4 py-2.5 text-sm text-white placeholder:text-slate-500 md:col-span-2">

                <fieldset class="rounded-xl border border-white/10 bg-slate-900/50 p-3">
                    <legend class="px-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Rôle</legend>
                    <div class="mt-2 flex flex-wrap gap-2">
                        <label class="inline-flex cursor-pointer items-center">
                            <input type="radio" name="role" value="" class="peer sr-only" {% if not filters.role %}checked{% endif %}>
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:bg-white/10 peer-checked:border-emerald-400/40 peer-checked:bg-emerald-500/20 peer-checked:text-emerald-200">Tous</span>
                        </label>
                        <label class="inline-flex cursor-pointer items-center">
                            <input type="radio" name="role" value="ROLE_APPLICANT" class="peer sr-only" {% if filters.role == 'ROLE_APPLICANT' %}checked{% endif %}>
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:bg-white/10 peer-checked:border-emerald-400/40 peer-checked:bg-emerald-500/20 peer-checked:text-emerald-200">Candidat</span>
                        </label>
                        <label class="inline-flex cursor-pointer items-center">
                            <input type="radio" name="role" value="ROLE_RECRUITER" class="peer sr-only" {% if filters.role == 'ROLE_RECRUITER' %}checked{% endif %}>
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:bg-white/10 peer-checked:border-emerald-400/40 peer-checked:bg-emerald-500/20 peer-checked:text-emerald-200">Recruteur</span>
                        </label>
                        <label class="inline-flex cursor-pointer items-center">
                            <input type="radio" name="role" value="ROLE_ADMIN" class="peer sr-only" {% if filters.role == 'ROLE_ADMIN' %}checked{% endif %}>
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:bg-white/10 peer-checked:border-emerald-400/40 peer-checked:bg-emerald-500/20 peer-checked:text-emerald-200">Admin</span>
                        </label>
                    </div>
                </fieldset>

                <fieldset class="rounded-xl border border-white/10 bg-slate-900/50 p-3">
                    <legend class="px-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Statut</legend>
                    <div class="mt-2 flex flex-wrap gap-2">
                        <label class="inline-flex cursor-pointer items-center">
                            <input type="radio" name="status" value="" class="peer sr-only" {% if not filters.status %}checked{% endif %}>
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:bg-white/10 peer-checked:border-emerald-400/40 peer-checked:bg-emerald-500/20 peer-checked:text-emerald-200">Tous</span>
                        </label>
                        <label class="inline-flex cursor-pointer items-center">
                            <input type="radio" name="status" value="pending" class="peer sr-only" {% if filters.status == 'pending' %}checked{% endif %}>
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:bg-white/10 peer-checked:border-yellow-400/40 peer-checked:bg-yellow-500/20 peer-checked:text-yellow-200">PENDING</span>
                        </label>
                        <label class="inline-flex cursor-pointer items-center">
                            <input type="radio" name="status" value="active" class="peer sr-only" {% if filters.status == 'active' %}checked{% endif %}>
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:bg-white/10 peer-checked:border-emerald-400/40 peer-checked:bg-emerald-500/20 peer-checked:text-emerald-200">ACTIVE</span>
                        </label>
                        <label class="inline-flex cursor-pointer items-center">
                            <input type="radio" name="status" value="suspended" class="peer sr-only" {% if filters.status == 'suspended' %}checked{% endif %}>
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:bg-white/10 peer-checked:border-orange-400/40 peer-checked:bg-orange-500/20 peer-checked:text-orange-200">SUSPENDED</span>
                        </label>
                        <label class="inline-flex cursor-pointer items-center">
                            <input type="radio" name="status" value="banned" class="peer sr-only" {% if filters.status == 'banned' %}checked{% endif %}>
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:bg-white/10 peer-checked:border-red-400/40 peer-checked:bg-red-500/20 peer-checked:text-red-200">BANNED</span>
                        </label>
                    </div>
                </fieldset>

                <div class="md:col-span-2 pt-1">
                    <button type="submit" class="w-full rounded-xl bg-emerald-500/20 px-4 py-2.5 text-sm font-semibold text-emerald-300 hover:bg-emerald-500/30">Appliquer</button>
                </div>
            </form>
        </div>
    </div>

    {% if pendingUsersCount > 0 %}
        <div class="rounded-2xl border border-yellow-400/30 bg-yellow-500/10 p-4 text-yellow-200 shadow-xl backdrop-blur-xl">
            <div class="flex min-h-10 flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p class="m-0 text-sm font-medium leading-none sm:flex sm:h-9 sm:items-center">
                    Alerte modération : {{ pendingUsersCount }} compte(s) en attente.
                </p>
                <a href="{{ path('app_admin_users', {status: 'pending'}) }}" data-admin-users-pagination="true" class="inline-flex items-center justify-center rounded-lg bg-yellow-400/20 px-3 py-2 text-xs font-semibold text-yellow-100 hover:bg-yellow-400/30">
                    Voir uniquement les pending
                </a>
            </div>
        </div>
    {% endif %}

    {# TABLEAU DES UTILISATEURS #}
    <div class="rounded-2xl border border-white/10 bg-slate-900/50 overflow-hidden shadow-2xl shadow-black/40 backdrop-blur-xl">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-white/10 bg-slate-950/50">
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Prénom</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Nom</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Email</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Rôle</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Statut</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-slate-300">Inscrit le</th>
                        <th class="px-6 py-4 text-center text-sm font-semibold text-slate-300">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/10">
                    {% for user in users %}
                        {% set firstName = user.developerProfile ? user.developerProfile.firstName : (user.recruiterProfile ? user.recruiterProfile.firstName : '-') %}
                        {% set lastName = user.developerProfile ? user.developerProfile.lastName : (user.recruiterProfile ? user.recruiterProfile.lastName : '-') %}
                        {% set isCurrentAdmin = app.user and app.user.id == user.id %}
                        {% set isPending = user.status and user.status.value == 'pending' %}
                        <tr class="transition-colors {{ isPending ? 'bg-yellow-500/5 hover:bg-yellow-500/10' : 'hover:bg-white/5' }}">
                            <td class="px-6 py-4 text-slate-200 text-sm">{{ firstName ?: '-' }}</td>
                            <td class="px-6 py-4 text-slate-200 text-sm">{{ lastName ?: '-' }}</td>
                            <td class="px-6 py-4 text-white">{{ user.email }}</td>
                            <td class="px-6 py-4">
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-500/20 text-red-400">Admin</span>
                                {% elseif 'ROLE_RECRUITER' in user.roles %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/20 text-purple-400">Recruteur</span>
                                {% else %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400">Candidat</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">
                                {% if user.status %}
                                    {% set statusValue = user.status.value %}
                                    {% if statusValue == 'active' %}
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400">ACTIVE</span>
                                    {% elseif statusValue == 'pending' %}
                                        <div class="space-y-2">
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-yellow-500/20 text-yellow-300">PENDING</span>
                                            <p class="text-xs text-yellow-200/90">En attente de validation whitelist.</p>
                                            <div class="flex flex-wrap gap-2">
                                                <form method="post" action="{{ path('app_admin_users_validate', {id: user.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_user_validate_' ~ user.id) }}">
                                                    <button type="submit" class="rounded-lg bg-emerald-500/20 px-3 py-1.5 text-xs font-semibold text-emerald-300 hover:bg-emerald-500/30">Accepter</button>
                                                </form>
                                                <form method="post" action="{{ path('app_admin_users_reject', {id: user.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_user_reject_' ~ user.id) }}">
                                                    <button type="submit" class="rounded-lg bg-red-500/20 px-3 py-1.5 text-xs font-semibold text-red-300 hover:bg-red-500/30">Refuser</button>
                                                </form>
                                            </div>
                                        </div>
                                    {% elseif statusValue == 'suspended' %}
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-orange-500/20 text-orange-400">SUSPENDED</span>
                                    {% elseif statusValue == 'banned' %}
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-500/20 text-red-400">BANNED</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-slate-500/20 text-slate-300">{{ statusValue|upper }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-slate-500/20 text-slate-300">N/A</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-slate-400 text-sm">{{ user.createdAt ? user.createdAt|date('d/m/Y') : '-' }}</td>
                            <td class="px-6 py-4">
                                <details class="group">
                                    <summary class="flex cursor-pointer list-none items-center justify-center gap-2 rounded-lg bg-white/5 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-white/10">
                                        <span>Gérer</span>
                                        <svg class="h-3.5 w-3.5 text-slate-300 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m5 7 5 6 5-6"></path>
                                        </svg>
                                    </summary>
                                    <div class="mt-2 min-w-[240px] space-y-2 rounded-xl border border-white/10 bg-slate-950/90 p-3 shadow-xl">
                                        {% if not user.status or user.status.value not in ['banned', 'deleted'] %}
                                            <form method="post" action="{{ path('app_admin_users_update_role', {id: user.id}) }}" class="flex items-center gap-2">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_user_role_' ~ user.id) }}">
                                                <select name="role" class="w-full rounded-lg border border-white/10 bg-slate-900 px-2.5 py-2 text-xs text-white" {% if isCurrentAdmin %}disabled{% endif %}>
                                                    <option value="ROLE_APPLICANT" {% if 'ROLE_APPLICANT' in user.roles and 'ROLE_RECRUITER' not in user.roles and 'ROLE_ADMIN' not in user.roles %}selected{% endif %}>Candidat</option>
                                                    <option value="ROLE_RECRUITER" {% if 'ROLE_RECRUITER' in user.roles and 'ROLE_ADMIN' not in user.roles %}selected{% endif %}>Recruteur</option>
                                                    <option value="ROLE_ADMIN" {% if 'ROLE_ADMIN' in user.roles %}selected{% endif %}>Admin</option>
                                                </select>
                                                <button type="submit" class="rounded-lg bg-blue-500/20 px-3 py-2 text-xs font-semibold text-blue-300 hover:bg-blue-500/30 disabled:opacity-50" {% if isCurrentAdmin %}disabled{% endif %}>OK</button>
                                            </form>
                                        {% endif %}

                                        {% if user.status and user.status.value == 'suspended' %}
                                            <form method="post" action="{{ path('app_admin_users_validate', {id: user.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_user_validate_' ~ user.id) }}">
                                                <button type="submit" class="w-full rounded-lg bg-emerald-500/20 px-3 py-2 text-xs font-semibold text-emerald-300 hover:bg-emerald-500/30" {% if isCurrentAdmin %}disabled{% endif %}>Remettre en ACTIVE</button>
                                            </form>
                                        {% endif %}

                                        {% if user.status and user.status.value in ['active', 'pending'] %}
                                            <form method="post" action="{{ path('app_admin_users_suspend', {id: user.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_user_suspend_' ~ user.id) }}">
                                                <button type="submit" class="w-full rounded-lg bg-orange-500/20 px-3 py-2 text-xs font-semibold text-orange-300 hover:bg-orange-500/30" {% if isCurrentAdmin %}disabled{% endif %}>Suspendre</button>
                                            </form>
                                        {% endif %}

                                        {% if user.status and user.status.value in ['active', 'suspended', 'pending'] %}
                                            <form method="post" action="{{ path('app_admin_users_ban', {id: user.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_user_ban_' ~ user.id) }}">
                                                <button type="submit" class="w-full rounded-lg bg-red-500/20 px-3 py-2 text-xs font-semibold text-red-300 hover:bg-red-500/30" {% if isCurrentAdmin %}disabled{% endif %}>Bannir</button>
                                            </form>
                                        {% endif %}

                                        <form method="post" action="{{ path('app_admin_users_delete', {id: user.id}) }}" onsubmit="return confirm('Supprimer définitivement ce compte et TOUTES ses données associées ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_user_delete_' ~ user.id) }}">
                                            <button type="submit" class="w-full rounded-lg bg-rose-500/20 px-3 py-2 text-xs font-semibold text-rose-300 hover:bg-rose-500/30" {% if isCurrentAdmin %}disabled{% endif %}>Supprimer</button>
                                        </form>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="px-6 py-10 text-center text-sm text-slate-400">Aucun utilisateur ne correspond aux filtres.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if totalPages > 1 %}
        <div class="flex items-center justify-between rounded-2xl border border-white/10 bg-slate-900/50 px-5 py-4 shadow-xl shadow-black/40 backdrop-blur-xl">
            <p class="text-sm text-slate-400">Page {{ currentPage }} / {{ totalPages }}</p>
            <div class="flex items-center gap-2">
                {% if currentPage > 1 %}
                    <a href="{{ path('app_admin_users', {page: currentPage - 1, q: filters.q, role: filters.role, status: filters.status}) }}" class="rounded-lg bg-white/5 px-3 py-2 text-sm font-semibold text-slate-200 hover:bg-white/10" data-admin-users-pagination="true">Précédent</a>
                {% endif %}
                {% if currentPage < totalPages %}
                    <a href="{{ path('app_admin_users', {page: currentPage + 1, q: filters.q, role: filters.role, status: filters.status}) }}" class="rounded-lg bg-white/5 px-3 py-2 text-sm font-semibold text-slate-200 hover:bg-white/10" data-admin-users-pagination="true">Suivant</a>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <p class="text-xs text-slate-500">Les actions d'administration sont journalisées. Les admins ne peuvent pas bannir ou supprimer leur propre compte.</p>
</section>
{% endblock %}
