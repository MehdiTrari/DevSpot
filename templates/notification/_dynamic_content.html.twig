<div class="space-y-6">
    <div class="theme-settings-card rounded-[2.75rem] p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 id="notifications-title" class="ui-title text-3xl font-semibold tracking-tight">Notifications</h1>
                <p class="ui-text-muted mt-1 text-sm">{{ unreadCount }} notification(s) non lue(s)</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                {% if unreadCount > 0 %}
                    <form method="post" data-notification-async="true" data-turbo="false" action="{{ path('app_notifications_mark_all_read', {filter: currentFilter, page: currentPage}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('notification_read_all') }}">
                        <button type="submit" class="ui-button-warning inline-flex cursor-pointer items-center gap-2 rounded-full px-4 py-1.5 text-xs font-semibold focus-visible:outline-none focus-visible:ring-2">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>
                            Tout marquer comme lu
                        </button>
                    </form>
                {% endif %}
                <a data-notification-filter="true" data-turbo="false" href="{{ path('app_notifications_index', {filter: 'all'}) }}" class="ui-pill rounded-full px-4 py-1.5 text-xs font-semibold transition-colors {{ currentFilter == 'all' ? 'ui-pill-info' : 'ui-pill-muted' }}">Toutes</a>
                <a data-notification-filter="true" data-turbo="false" href="{{ path('app_notifications_index', {filter: 'unread'}) }}" class="ui-pill rounded-full px-4 py-1.5 text-xs font-semibold transition-colors {{ currentFilter == 'unread' ? 'ui-pill-danger' : 'ui-pill-muted' }}">Non lues</a>
                <a data-notification-filter="true" data-turbo="false" href="{{ path('app_notifications_index', {filter: 'read'}) }}" class="ui-pill rounded-full px-4 py-1.5 text-xs font-semibold transition-colors {{ currentFilter == 'read' ? 'ui-pill-success' : 'ui-pill-muted' }}">Lues</a>
            </div>
        </div>
    </div>

    <div class="space-y-4">
        {% for notification in notifications %}
            {# ── Color coding by notification type ── #}
            {% set notifType = notification.type.value|default('') %}
            {% if notification.isRead %}
                {% set panelClass = 'ui-panel' %}
                {% set pillClass = 'ui-pill-muted' %}
                {% set iconColor = 'ui-text-muted' %}
            {% elseif notifType in ['content_reported', 'profile_incomplete', 'job_offer_expired', 'profile_moderated', 'admin_message'] %}
                {% set panelClass = 'ui-panel-warning' %}
                {% set pillClass = 'ui-pill-warning' %}
                {% set iconColor = 'text-amber-500' %}
            {% elseif notifType in ['account_suspended', 'account_banned', 'account_rejected'] %}
                {% set panelClass = 'ui-panel-danger' %}
                {% set pillClass = 'ui-pill-danger' %}
                {% set iconColor = 'text-rose-500' %}
            {% elseif notifType in ['new_user_pending', 'role_request', 'slug_change_request', 'new_message'] %}
                {% set panelClass = 'ui-panel-info' %}
                {% set pillClass = 'ui-pill-info' %}
                {% set iconColor = 'text-blue-500' %}
            {% else %}
                {% set panelClass = 'ui-panel-success' %}
                {% set pillClass = 'ui-pill-success' %}
                {% set iconColor = 'text-emerald-500' %}
            {% endif %}

            <article class="rounded-[1.75rem] p-5 shadow-xl backdrop-blur-xl transition-colors {{ panelClass }}">
                <div class="flex items-start gap-4">
                    {# ── Icon per category ── #}
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/60 dark:bg-white/10 {{ iconColor }}">
                        {% if notifType in ['content_reported', 'profile_incomplete', 'job_offer_expired', 'profile_moderated', 'admin_message'] %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
                        {% elseif notifType in ['account_suspended', 'account_banned', 'account_rejected'] %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                        {% elseif notifType in ['new_user_pending', 'role_request', 'slug_change_request'] %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128H5.228A2 2 0 0 1 3.24 17.5a4.125 4.125 0 0 1 7.533-2.493m4.014.286A9.004 9.004 0 0 0 12 12.75a9.004 9.004 0 0 0-2.787.436"/></svg>
                        {% elseif notifType in ['new_message'] %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H4.5a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5H4.5A2.25 2.25 0 0 0 2.25 6.75m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0l-7.5-4.615A2.25 2.25 0 0 1 2.25 6.993V6.75"/></svg>
                        {% elseif notifType in ['account_approved', 'account_pending'] %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                        {% elseif notifType in ['profile_favorited'] %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-1.244-.75 25.18 25.18 0 0 1-2.688-2.041C5.005 15.66 2.25 12.554 2.25 8.495 2.25 5.42 4.715 3 7.688 3c1.714 0 3.312.834 4.312 2.12C13 3.834 14.598 3 16.313 3 19.285 3 21.75 5.42 21.75 8.495c0 4.059-2.755 7.165-5.434 9.61a25.175 25.175 0 0 1-2.688 2.04 15.274 15.274 0 0 1-1.244.75l-.022.013-.007.003-.002.001a.75.75 0 0 1-.708 0l-.002-.001Z"/></svg>
                        {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/></svg>
                        {% endif %}
                    </div>

                    <div class="min-w-0 flex-1 space-y-1.5">
                        <div class="flex flex-wrap items-center gap-2">
                            <h2 class="ui-title text-sm font-semibold">{{ notification.title }}</h2>
                            {% if notification.isRead %}
                                <span class="ui-pill ui-pill-muted rounded-full px-2.5 py-0.5 text-[11px] font-semibold">Lue</span>
                            {% else %}
                                <span class="ui-pill {{ pillClass }} rounded-full px-2.5 py-0.5 text-[11px] font-semibold">Nouvelle</span>
                            {% endif %}
                        </div>

                        {% if notifType == 'profile_moderated' %}
                            <p class="ui-text-secondary text-sm leading-relaxed">Ce message de modération est consultable dans une fenêtre dédiée.</p>
                        {% else %}
                            <p class="ui-text-secondary text-sm leading-relaxed">{{ notification.content }}</p>
                        {% endif %}

                        {% if notification.senderDisplayName %}
                            <p class="ui-text-soft text-xs">Envoye par {{ notification.senderDisplayName }}</p>
                        {% endif %}

                        <div class="flex flex-wrap items-center gap-3">
                            <p class="ui-text-soft text-xs">{{ notification.createdAt ? notification.createdAt|date('d/m/Y H:i') : '' }}</p>
                            {% if notifType == 'profile_moderated' %}
                                <button
                                    type="button"
                                    data-notification-modal-open="true"
                                    data-notification-modal-title="{{ notification.title|e('html_attr') }}"
                                    data-notification-modal-content="{{ notification.content|e('html_attr') }}"
                                    data-notification-modal-date="{{ (notification.createdAt ? notification.createdAt|date('d/m/Y H:i') : '')|e('html_attr') }}"
                                    data-notification-modal-link="{{ (notification.link ?? '')|e('html_attr') }}"
                                    class="ui-button-warning inline-flex items-center gap-1 rounded-full px-3 py-1.5 text-xs font-semibold"
                                >
                                    Ouvrir le message
                                </button>
                            {% endif %}
                            {% if notification.link %}
                                <a href="{{ notification.link }}" class="ui-link-accent inline-flex items-center gap-1 text-xs font-semibold">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd"/></svg>
                                    Voir la page
                                </a>
                            {% endif %}
                        </div>
                    </div>

                    <div class="flex shrink-0 items-center gap-2">
                        {% if not notification.isRead %}
                            <form method="post" data-notification-async="true" data-turbo="false" action="{{ path('app_notifications_mark_read', {id: notification.id, filter: currentFilter, page: currentPage}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('notification_read_' ~ notification.id) }}">
                                <button type="submit" class="ui-button-warning inline-flex cursor-pointer items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>
                                    Marquer comme lue
                                </button>
                            </form>
                        {% endif %}

                        <form method="post" data-notification-async="true" data-turbo="false" action="{{ path('app_notifications_delete', {id: notification.id, filter: currentFilter, page: currentPage}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('notification_delete_' ~ notification.id) }}">
                            <button type="submit" class="ui-button-danger inline-flex items-center justify-center rounded-full p-2" aria-label="Supprimer la notification">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022 1.005 11.36A2.75 2.75 0 0 0 7.76 20h4.48a2.75 2.75 0 0 0 2.742-2.689l1.005-11.36.149.022a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 1 .7.798l-.5 5.5a.75.75 0 0 1-1.498-.136l.5-5.5a.75.75 0 0 1 .798-.662Zm2.84 0a.75.75 0 0 1 .798.662l.5 5.5a.75.75 0 1 1-1.498.136l-.5-5.5a.75.75 0 0 1 .7-.798Z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            </article>
        {% else %}
            <div class="theme-settings-card rounded-[2.35rem] p-8 text-center text-sm">
                <p class="ui-text-muted">Aucune notification pour le moment.</p>
            </div>
        {% endfor %}

        {% if totalPages > 1 %}
            <div class="theme-settings-card flex items-center justify-between rounded-[2rem] px-4 py-3 text-sm">
                <p class="ui-text-muted">Page {{ currentPage }} / {{ totalPages }}</p>
                <div class="flex items-center gap-2">
                    {% if currentPage > 1 %}
                        <a data-notification-filter="true" data-turbo="false" href="{{ path('app_notifications_index', {filter: currentFilter, page: currentPage - 1}) }}" class="ui-button-secondary rounded-lg px-3 py-1.5 font-semibold">Précédent</a>
                    {% endif %}
                    {% if currentPage < totalPages %}
                        <a data-notification-filter="true" data-turbo="false" href="{{ path('app_notifications_index', {filter: currentFilter, page: currentPage + 1}) }}" class="ui-button-secondary rounded-lg px-3 py-1.5 font-semibold">Suivant</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</div>
