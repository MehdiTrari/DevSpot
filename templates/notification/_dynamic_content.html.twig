{% set isAdmin = is_granted('ROLE_ADMIN') %}

<div class="space-y-6">
    <div class="rounded-3xl border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h1 id="notifications-title" class="text-3xl font-semibold tracking-tight text-white">Notifications</h1>
                <p class="mt-1 text-sm text-slate-400">{{ unreadCount }} notification(s) non lue(s)</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                {% if unreadCount > 0 %}
                    <form method="post" data-notification-async="true" data-turbo="false" action="{{ path('app_notifications_mark_all_read', {filter: currentFilter, page: currentPage}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('notification_read_all') }}">
                        <button type="submit" class="rounded-full border border-emerald-300/30 bg-emerald-500/20 px-4 py-1.5 text-xs font-semibold text-emerald-200 transition-colors hover:bg-emerald-500/30">Tout marquer comme lu</button>
                    </form>
                {% endif %}
                <a data-notification-filter="true" data-turbo="false" href="{{ path('app_notifications_index') }}" class="rounded-full border px-4 py-1.5 text-xs font-semibold transition-colors {{ currentFilter is not defined or not currentFilter ? 'border-emerald-400/40 bg-emerald-500/20 text-emerald-200' : 'border-white/10 bg-white/5 text-slate-300 hover:bg-white/10' }}">Toutes</a>
                <a data-notification-filter="true" data-turbo="false" href="{{ path('app_notifications_index', {filter: 'unread'}) }}" class="rounded-full border px-4 py-1.5 text-xs font-semibold transition-colors {{ currentFilter == 'unread' ? 'border-emerald-400/40 bg-emerald-500/20 text-emerald-200' : 'border-white/10 bg-white/5 text-slate-300 hover:bg-white/10' }}">Non lues</a>
                <a data-notification-filter="true" data-turbo="false" href="{{ path('app_notifications_index', {filter: 'read'}) }}" class="rounded-full border px-4 py-1.5 text-xs font-semibold transition-colors {{ currentFilter == 'read' ? 'border-emerald-400/40 bg-emerald-500/20 text-emerald-200' : 'border-white/10 bg-white/5 text-slate-300 hover:bg-white/10' }}">Lues</a>
            </div>
        </div>
    </div>

    <div class="space-y-3">
        {% for notification in notifications %}
            <article class="rounded-2xl border p-4 shadow-xl backdrop-blur-xl transition-colors {{ notification.isRead ? 'border-white/10 bg-slate-900/40' : 'border-emerald-400/25 bg-emerald-500/10' }}">
                <div class="flex items-start gap-4">
                    <div class="min-w-0 flex-1 space-y-1">
                        <h2 class="text-sm font-semibold text-white">{{ notification.title }}</h2>
                        {% if isAdmin %}
                            <p class="text-sm text-slate-300">{{ notification.content }}</p>
                            <p class="text-xs text-slate-500">{{ notification.createdAt ? notification.createdAt|date('d/m/Y H:i') : '' }}</p>
                            {% if notification.link %}
                                <a href="{{ notification.link }}" class="inline-flex items-center text-xs font-semibold text-emerald-300 hover:text-emerald-200">Voir le détail</a>
                            {% endif %}
                        {% endif %}
                    </div>

                    <div class="flex shrink-0 items-center gap-2">
                        {% if not notification.isRead %}
                            <form method="post" data-notification-async="true" data-turbo="false" action="{{ path('app_notifications_mark_read', {id: notification.id, filter: currentFilter, page: currentPage}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('notification_read_' ~ notification.id) }}">
                                <button type="submit" class="rounded-lg border border-emerald-300/25 bg-emerald-500/20 px-3 py-1.5 text-xs font-semibold text-emerald-200 hover:bg-emerald-500/30">Marquer comme lue</button>
                            </form>
                        {% else %}
                            <span class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300">Déjà lue</span>
                        {% endif %}

                        <form method="post" data-notification-async="true" data-turbo="false" action="{{ path('app_notifications_delete', {id: notification.id, filter: currentFilter, page: currentPage}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('notification_delete_' ~ notification.id) }}">
                            <button type="submit" class="inline-flex items-center justify-center rounded-lg border border-rose-400/20 bg-rose-500/10 p-2 text-rose-300 transition-colors hover:bg-rose-500/20" aria-label="Supprimer la notification">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 6V4h8v2" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l1 14h10l1-14" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 11v6" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 11v6" />
                                </svg>
                                <span class="sr-only">Supprimer</span>
                            </button>
                        </form>
                    </div>
                </div>
            </article>
        {% else %}
            <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-8 text-center text-sm text-slate-400 shadow-xl backdrop-blur-xl">
                Aucune notification pour le moment.
            </div>
        {% endfor %}

        {% if totalPages > 1 %}
            <div class="flex items-center justify-between rounded-2xl border border-white/10 bg-slate-900/40 px-4 py-3 text-sm shadow-xl backdrop-blur-xl">
                <p class="text-slate-400">Page {{ currentPage }} / {{ totalPages }}</p>
                <div class="flex items-center gap-2">
                    {% if currentPage > 1 %}
                        <a data-notification-filter="true" data-turbo="false" href="{{ path('app_notifications_index', {filter: currentFilter, page: currentPage - 1}) }}" class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 font-semibold text-slate-200 transition-colors hover:bg-white/10">Précédent</a>
                    {% endif %}
                    {% if currentPage < totalPages %}
                        <a data-notification-filter="true" data-turbo="false" href="{{ path('app_notifications_index', {filter: currentFilter, page: currentPage + 1}) }}" class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 font-semibold text-slate-200 transition-colors hover:bg-white/10">Suivant</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</div>
