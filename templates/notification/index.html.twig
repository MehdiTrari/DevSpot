{% extends 'base.html.twig' %}

{% block title %}Notifications | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-6xl self-start space-y-8 font-sans" aria-labelledby="notifications-title">
        <div id="notifications-dynamic-content">
            {% include 'notification/_dynamic_content.html.twig' with {
                notifications: notifications,
                currentFilter: currentFilter,
                unreadCount: unreadCount
            } %}
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const initNotificationsFilters = () => {
            const container = document.getElementById('notifications-dynamic-content');
            if (!container || container.dataset.filtersInitialized === 'true') {
                return;
            }
            container.dataset.filtersInitialized = 'true';

            let pendingController = null;

            const loadNotifications = async (url) => {
                if (pendingController) {
                    pendingController.abort();
                }

                pendingController = new AbortController();
                container.setAttribute('aria-busy', 'true');
                container.classList.add('opacity-60', 'pointer-events-none');

                try {
                    const response = await fetch(url, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'text/html',
                        },
                        credentials: 'same-origin',
                        signal: pendingController.signal,
                    });

                    if (!response.ok) {
                        window.location.href = url;

                        return;
                    }

                    const html = await response.text();
                    container.innerHTML = html;
                    window.history.replaceState({}, '', url);
                } catch (error) {
                    if (error.name !== 'AbortError') {
                        window.location.href = url;
                    }
                } finally {
                    container.removeAttribute('aria-busy');
                    container.classList.remove('opacity-60', 'pointer-events-none');
                }
            };

            document.addEventListener('click', (event) => {
                const target = event.target.closest('[data-notification-filter="true"]');
                if (!target) {
                    return;
                }

                event.preventDefault();
                const url = target.getAttribute('href');
                if (!url) {
                    return;
                }

                loadNotifications(url);
            });

            document.addEventListener('submit', async (event) => {
                const form = event.target.closest('form[data-notification-async="true"]');
                if (!form) {
                    return;
                }

                event.preventDefault();

                const submitButton = form.querySelector('button[type="submit"]');
                if (submitButton) {
                    submitButton.setAttribute('disabled', 'disabled');
                    submitButton.classList.add('opacity-70', 'cursor-not-allowed');
                }

                container.setAttribute('aria-busy', 'true');
                container.classList.add('opacity-60', 'pointer-events-none');

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'text/html',
                        },
                        body: new FormData(form),
                        credentials: 'same-origin',
                    });

                    if (!response.ok) {
                        window.location.href = form.action;

                        return;
                    }

                    const html = await response.text();
                    container.innerHTML = html;
                } catch (_error) {
                    window.location.href = form.action;
                } finally {
                    container.removeAttribute('aria-busy');
                    container.classList.remove('opacity-60', 'pointer-events-none');
                }
            });
        };

        document.addEventListener('DOMContentLoaded', initNotificationsFilters);
        document.addEventListener('turbo:load', initNotificationsFilters);
    </script>
{% endblock %}
