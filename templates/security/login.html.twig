{% extends 'base.html.twig' %}

{% block title %}Connexion | DevSpot{% endblock %}

{% block body %}
    {# Carte en verre fumé #}
    <section class="w-full max-w-md rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:bg-slate-900/60 hover:shadow-emerald-500/10 sm:p-10">
        
        {# EN-TÊTE #}
        <div class="mb-8 text-center">
            <h1 class="text-3xl font-semibold tracking-tight text-white">Connexion</h1>
            <p class="mt-2 text-[15px] text-slate-400">Accède à ton espace DevSpot.</p>
        </div>

        {# MESSAGES ERREURS #}
        <div class="space-y-3 mb-6">
            {% if error %}
                <div class="rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-3.5 text-[15px] font-medium text-red-400 animate-fade-in-down">
                    <div class="flex items-start justify-between gap-4">
                        <p class="leading-relaxed">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                    </div>
                </div>
            {% endif %}

            {% if app.user %}
                <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-[15px] font-medium text-white animate-fade-in-down">
                    Connecté en tant que {{ app.user.userIdentifier }}.
                    <a class="ml-1 font-semibold text-emerald-400 hover:text-emerald-300 hover:underline" href="{{ logout_path() }}">Se déconnecter</a>
                </div>
            {% endif %}
        </div>

        {# FORMULAIRE #}
        <form method="post" class="space-y-5">
            
            <div class="space-y-1.5">
                <label for="inputEmail" class="block pl-1 text-[15px] font-medium text-slate-200">Email</label>
                <input
                    type="email"
                    value="{{ last_username }}"
                    name="email"
                    id="inputEmail"
                    class="block w-full rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-[15px] text-white outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-emerald-500 focus:bg-white/10 focus:ring-4 focus:ring-emerald-500/20 shadow-inner"
                    placeholder="nom@exemple.com"
                    autocomplete="email"
                    required
                    autofocus
                >
            </div>

            <div class="space-y-1.5">
                <label for="inputPassword" class="block pl-1 text-[15px] font-medium text-slate-200">Mot de passe</label>
                <input
                    type="password"
                    name="password"
                    id="inputPassword"
                    class="block w-full rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-[15px] text-white outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-emerald-500 focus:bg-white/10 focus:ring-4 focus:ring-emerald-500/20 shadow-inner"
                    placeholder="••••••••"
                    autocomplete="current-password"
                    required
                >
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="pt-1">
                <label class="group inline-flex cursor-pointer items-center gap-3">
                    <div class="relative flex items-center">
                        <input type="checkbox" name="_remember_me" class="peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-white/10 bg-white/5 shadow-inner transition-all checked:border-emerald-500 checked:bg-emerald-500 focus:outline-none focus:ring-4 focus:ring-emerald-500/20">
                        <svg class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-white opacity-0 transition-opacity peer-checked:opacity-100" width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <span class="text-[15px] font-medium text-slate-400 transition-colors group-hover:text-white">Se souvenir de moi</span>
                </label>
            </div>

            <button class="mt-4 w-full rounded-full bg-emerald-500 px-5 py-4 text-[15px] font-bold text-slate-950 shadow-lg shadow-emerald-500/20 transition-all duration-300 hover:scale-[1.02] hover:bg-emerald-400 active:scale-95 focus:outline-none focus:ring-4 focus:ring-emerald-500/30" type="submit">
                Se connecter
            </button>
        </form>

        {# PIED DE CARTE #}
        <p class="mt-8 text-center text-[15px] text-slate-400">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="font-semibold text-emerald-400 transition-colors hover:text-emerald-300 hover:underline">Créer un compte</a>
        </p>
    </section>
{% endblock %}