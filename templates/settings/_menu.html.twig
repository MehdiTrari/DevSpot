{% set settingsMenuKey = current|default('index') %}

<nav class="flex flex-wrap items-center gap-2" aria-label="Navigation des paramètres">
    <a href="{{ path('app_settings_index') }}" class="ui-pill rounded-full px-4 py-2 text-xs font-semibold {{ settingsMenuKey == 'index' ? 'ui-pill-success' : 'ui-pill-muted' }}">
        Vue d'ensemble
    </a>
    <a href="{{ path('app_settings_preferences') }}" class="ui-pill rounded-full px-4 py-2 text-xs font-semibold {{ settingsMenuKey == 'preferences' ? 'ui-pill-success' : 'ui-pill-muted' }}">
        Préférences
    </a>
    <a href="{{ path('app_settings_role') }}" class="ui-pill rounded-full px-4 py-2 text-xs font-semibold {{ settingsMenuKey == 'role' ? 'ui-pill-success' : 'ui-pill-muted' }}">
        Changement de rôle
    </a>
    {% if is_granted('ROLE_APPLICANT') %}
        <a href="{{ path('app_settings_slug') }}" class="ui-pill rounded-full px-4 py-2 text-xs font-semibold {{ settingsMenuKey == 'slug' ? 'ui-pill-success' : 'ui-pill-muted' }}">
            Changement de slug
        </a>
    {% endif %}
</nav>
