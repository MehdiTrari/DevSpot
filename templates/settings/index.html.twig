{% extends 'base.html.twig' %}

{% block title %}Paramètres | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-4xl self-start space-y-6">
        <div class="theme-settings-card rounded-[2rem] p-6 sm:p-8">
            <div class="max-w-2xl">
                <span class="inline-flex rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-emerald-300">
                    Paramètres
                </span>
                <h1 class="ui-title mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">Centre de paramètres</h1>
                <p class="ui-text-secondary mt-3 text-[15px] leading-relaxed">
                    Regroupe les actions de compte et de préférences depuis un seul endroit.
                </p>
            </div>

            <div class="mt-6">
                {% include 'settings/_menu.html.twig' with { current: 'index' } %}
            </div>

            <div class="mt-8 grid gap-4 sm:grid-cols-2">
                <a href="{{ path('app_settings_preferences') }}" class="premium-action-card flex items-start gap-3 rounded-[1.4rem] p-5 text-left">
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-white/15 bg-white/10 text-emerald-300">⚙</span>
                    <span>
                        <span class="ui-title block text-base font-semibold">Préférences</span>
                        <span class="ui-text-muted mt-1 block text-sm">Thème, mode jour/nuit et confort visuel.</span>
                    </span>
                </a>

                {% if app.user and app.user.canRequestRoleChange %}
                    <a href="{{ path('app_settings_role') }}" class="premium-action-card flex items-start gap-3 rounded-[1.4rem] p-5 text-left">
                        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-white/15 bg-white/10 text-amber-300">⇄</span>
                        <span>
                            <span class="ui-title block text-base font-semibold">Changement de rôle</span>
                            <span class="ui-text-muted mt-1 block text-sm">Demander un passage candidat ou recruteur.</span>
                        </span>
                    </a>
                {% endif %}

                {% if app.user and app.user.applicantOnly %}
                    <a href="{{ path('app_settings_slug') }}" class="premium-action-card flex items-start gap-3 rounded-[1.4rem] p-5 text-left sm:col-span-2">
                        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-white/15 bg-white/10 text-blue-300">#</span>
                        <span>
                            <span class="ui-title block text-base font-semibold">Changement de slug</span>
                            <span class="ui-text-muted mt-1 block text-sm">Proposer une nouvelle URL pour ton portfolio.</span>
                        </span>
                    </a>
                {% endif %}
            </div>
        </div>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="theme-settings-card rounded-[2rem] p-6 sm:p-8">
                <div class="max-w-2xl">
                    <span class="ui-pill ui-pill-success rounded-full px-3 py-1 text-xs font-semibold">Admin</span>
                    <h2 class="ui-title mt-4 text-2xl font-semibold tracking-tight">Outils couleurs</h2>
                    <p class="ui-text-secondary mt-3 text-[15px] leading-relaxed">
                        Accède au tableau des palettes jour et nuit pour vérifier les correspondances de tokens du thème.
                    </p>
                    <div class="mt-6">
                        <a href="{{ path('app_settings_admin_colors') }}" class="ui-button-secondary inline-flex items-center justify-center rounded-full px-4 py-2.5 text-sm font-semibold">
                            Ouvrir palettes de couleurs
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </section>
{% endblock %}
