{% extends 'base.html.twig' %}

{% block title %}Inscription | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-xl rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:bg-slate-900/60 hover:shadow-emerald-500/10 sm:p-10">

        {# EN-TÊTE #}
        <div class="mb-8 text-center">
            <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.4)]"></span>
                Nouveau compte
            </p>
            <h1 class="text-3xl font-semibold tracking-tight text-white">Créer un compte</h1>
            <p class="mt-2 text-[15px] text-slate-400">Inscris-toi puis confirme ton email.</p>
        </div>

        {# NOTE INFORMATIVE #}
        <div class="mb-8 rounded-2xl border border-white/5 bg-white/5 p-4 text-center text-[14px] leading-relaxed text-slate-300 shadow-inner">
            Après confirmation, le compte restera en attente de validation par un administrateur.
        </div>

        {# MESSAGES FLASH / ERREURS GLOBALES #}
        <div class="mb-6 space-y-3">
            {% for message in app.flashes('error') %}
                <div class="rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-3.5 text-[15px] font-medium text-red-400">{{ message }}</div>
            {% endfor %}
            {% if registrationForm.vars.errors|length > 0 %}
                <div class="rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-3.5 text-[15px] font-medium text-red-400">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}
        </div>

        {{ form_start(registrationForm, {attr: {class: 'space-y-5'}}) }}

            {# ── CHOIX DU TYPE DE COMPTE ── #}
            <div class="space-y-2">
                <p class="pl-1 text-[15px] font-medium text-slate-200">Je suis…</p>
                {% if registrationForm.accountType.vars.errors|length > 0 %}
                    <div class="pl-1 text-sm font-medium text-red-400">{{ form_errors(registrationForm.accountType) }}</div>
                {% endif %}
                <div class="flex gap-3">
                    {# On render les radios manuellement pour les styler en cartes #}
                    {% for choice in registrationForm.accountType %}
                        <label class="account-type-card group relative flex min-w-0 flex-1 cursor-pointer flex-col items-center gap-2 rounded-2xl border border-white/10 bg-white/5 p-5 text-center transition-all duration-300 hover:border-emerald-500/50 hover:bg-white/10 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-500/10 has-[:checked]:shadow-lg has-[:checked]:shadow-emerald-500/10">
                            {{ form_widget(choice, {attr: {class: 'sr-only'}}) }}
                            {% if choice.vars.value == 'applicant' %}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-7 w-7 text-slate-400 transition-colors group-has-[:checked]:text-emerald-400">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
                                </svg>
                                <span class="text-[15px] font-semibold text-slate-200">Postulant</span>
                                <span class="text-[12px] text-slate-400">Développeur cherchant un poste</span>
                            {% else %}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-7 w-7 text-slate-400 transition-colors group-has-[:checked]:text-emerald-400">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                </svg>
                                <span class="text-[15px] font-semibold text-slate-200">Recruteur</span>
                                <span class="text-[12px] text-slate-400">Entreprise cherchant des talents</span>
                            {% endif %}
                        </label>
                    {% endfor %}
                </div>
            </div>

            {# ── PRÉNOM / NOM ── #}
            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    {{ form_label(registrationForm.firstName, null, {label_attr: {class: 'block pl-1 text-[15px] font-medium text-slate-200'}}) }}
                    {{ form_widget(registrationForm.firstName, {attr: {class: 'block w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3.5 text-[15px] text-white outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-emerald-500 focus:bg-white/10 focus:ring-4 focus:ring-emerald-500/20 shadow-inner', placeholder: 'Jean'}}) }}
                    {% if registrationForm.firstName.vars.errors|length > 0 %}
                        <div class="pl-1 text-sm font-medium text-red-400">{{ form_errors(registrationForm.firstName) }}</div>
                    {% endif %}
                </div>
                <div class="space-y-1.5">
                    {{ form_label(registrationForm.lastName, null, {label_attr: {class: 'block pl-1 text-[15px] font-medium text-slate-200'}}) }}
                    {{ form_widget(registrationForm.lastName, {attr: {class: 'block w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3.5 text-[15px] text-white outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-emerald-500 focus:bg-white/10 focus:ring-4 focus:ring-emerald-500/20 shadow-inner', placeholder: 'Dupont'}}) }}
                    {% if registrationForm.lastName.vars.errors|length > 0 %}
                        <div class="pl-1 text-sm font-medium text-red-400">{{ form_errors(registrationForm.lastName) }}</div>
                    {% endif %}
                </div>
            </div>

            {# ── CHAMPS RECRUTEUR (masqués par défaut) ── #}
            <div id="recruiter-fields" class="hidden space-y-5 rounded-2xl border border-white/5 bg-white/5 p-5">
                <p class="text-[13px] font-semibold uppercase tracking-wider text-slate-400">Informations entreprise</p>

                <div class="space-y-1.5">
                    {{ form_label(registrationForm.companyName, null, {label_attr: {class: 'block pl-1 text-[15px] font-medium text-slate-200'}}) }}
                    {{ form_widget(registrationForm.companyName, {attr: {class: 'block w-full rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-[15px] text-white outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-emerald-500 focus:bg-white/10 focus:ring-4 focus:ring-emerald-500/20 shadow-inner', placeholder: 'Acme Corp'}}) }}
                    {% if registrationForm.companyName.vars.errors|length > 0 %}
                        <div class="pl-1 text-sm font-medium text-red-400">{{ form_errors(registrationForm.companyName) }}</div>
                    {% endif %}
                </div>

                <div class="space-y-1.5">
                    {{ form_label(registrationForm.workEmail, null, {label_attr: {class: 'block pl-1 text-[15px] font-medium text-slate-200'}}) }}
                    {{ form_widget(registrationForm.workEmail, {attr: {class: 'block w-full rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-[15px] text-white outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-emerald-500 focus:bg-white/10 focus:ring-4 focus:ring-emerald-500/20 shadow-inner', placeholder: 'rh@acme.com'}}) }}
                    {% if registrationForm.workEmail.vars.errors|length > 0 %}
                        <div class="pl-1 text-sm font-medium text-red-400">{{ form_errors(registrationForm.workEmail) }}</div>
                    {% endif %}
                </div>
            </div>

            {# ── EMAIL DE CONNEXION ── #}
            <div class="space-y-1.5">
                {{ form_label(registrationForm.email, null, {label_attr: {class: 'block pl-1 text-[15px] font-medium text-slate-200'}}) }}
                {{ form_widget(registrationForm.email, {attr: {class: 'block w-full rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-[15px] text-white outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-emerald-500 focus:bg-white/10 focus:ring-4 focus:ring-emerald-500/20 shadow-inner', placeholder: 'nom@exemple.com'}}) }}
                {% if registrationForm.email.vars.errors|length > 0 %}
                    <div class="pl-1 mt-1.5 text-sm font-medium text-red-400">{{ form_errors(registrationForm.email) }}</div>
                {% endif %}
            </div>

            {# ── MOT DE PASSE ── #}
            <div class="space-y-1.5">
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', {label_attr: {class: 'block pl-1 text-[15px] font-medium text-slate-200'}}) }}
                {{ form_widget(registrationForm.plainPassword, {attr: {class: 'block w-full rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-[15px] text-white outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-emerald-500 focus:bg-white/10 focus:ring-4 focus:ring-emerald-500/20 shadow-inner', placeholder: '8+ caractères, majuscule, chiffre, symbole'}}) }}
                {% if registrationForm.plainPassword.vars.errors|length > 0 %}
                    <div class="pl-1 mt-1.5 text-sm font-medium text-red-400">{{ form_errors(registrationForm.plainPassword) }}</div>
                {% endif %}
            </div>

            {# ── CGU ── #}
            <div class="pt-2">
                <label class="group inline-flex cursor-pointer items-center gap-3">
                    <div class="relative flex items-center">
                        {{ form_widget(registrationForm.agreeTerms, {attr: {class: 'peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-white/10 bg-white/5 shadow-inner transition-all checked:border-emerald-500 checked:bg-emerald-500 focus:outline-none focus:ring-4 focus:ring-emerald-500/20'}}) }}
                        <svg class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-white opacity-0 transition-opacity peer-checked:opacity-100" width="12" height="10" viewBox="0 0 12 10" fill="none">
                            <path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <span class="text-[15px] font-medium text-slate-400 transition-colors group-hover:text-white">J'accepte les conditions d'utilisation</span>
                </label>
                {% if registrationForm.agreeTerms.vars.errors|length > 0 %}
                    <div class="pl-1 mt-1.5 text-sm font-medium text-red-400">{{ form_errors(registrationForm.agreeTerms) }}</div>
                {% endif %}
            </div>

            {# ── SUBMIT ── #}
            <button type="submit" class="mt-4 w-full rounded-full bg-emerald-500 px-5 py-4 text-[15px] font-bold text-slate-950 shadow-lg shadow-emerald-500/20 transition-all duration-300 hover:scale-[1.02] hover:bg-emerald-400 active:scale-95 focus:outline-none focus:ring-4 focus:ring-emerald-500/30">
                Créer mon compte
            </button>

        {{ form_end(registrationForm) }}

        <p class="mt-8 text-center text-[15px] text-slate-400">
            Déjà inscrit ?
            <a href="{{ path('app_login') }}" class="font-semibold text-emerald-400 transition-colors hover:text-emerald-300 hover:underline">Se connecter</a>
        </p>
    </section>

    <script>
    (function () {
        var section = document.getElementById('recruiter-fields');
        function sync() {
            var checked = document.querySelector('input[type="radio"][name*="[accountType]"]:checked');
            if (section) section.classList.toggle('hidden', !checked || checked.value !== 'recruiter');
        }
        document.querySelectorAll('input[type="radio"][name*="[accountType]"]').forEach(function (r) {
            r.addEventListener('change', sync);
        });
        sync();
    })();
    </script>
{% endblock %}