{% extends 'base.html.twig' %}

{% block title %}Inscription | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-xl rounded-[2.5rem] border border-white/40 bg-white/70 p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] backdrop-blur-xl transition-all duration-500 hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] sm:p-10">
        
        {# EN-TÊTE #}
        <div class="mb-8 text-center">
            <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-[#F5F5F7] px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-[#86868B]">
                <span class="h-2 w-2 rounded-full bg-[#0071E3] shadow-[0_0_8px_rgba(0,113,227,0.4)] animate-pulse"></span>
                Nouveau compte
            </p>
            <h1 class="text-3xl font-semibold tracking-tight text-[#1D1D1F]">Créer un compte</h1>
            <p class="mt-2 text-[15px] text-[#86868B]">Inscris-toi puis confirme ton email.</p>
        </div>

        {# NOTE INFORMATIVE DOUCE #}
        <div class="mb-8 rounded-2xl bg-[#F5F5F7] p-4 text-center text-[14px] leading-relaxed text-[#86868B]">
            Après confirmation, le compte restera en attente de validation par un administrateur.
        </div>

        {# MESSAGES FLASH ET ERREURS GLOBALES #}
        <div class="space-y-3 mb-6">
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="rounded-2xl bg-[#FF3B30]/10 px-5 py-3.5 text-[15px] font-medium text-[#FF3B30]">
                    {{ flash_error }}
                </div>
            {% endfor %}

            {% for message in app.flashes('success') %}
                <div class="rounded-2xl bg-[#34C759]/10 px-5 py-3.5 text-[15px] font-medium text-[#34C759]">
                    {{ message }}
                </div>
            {% endfor %}

            {% if registrationForm.vars.errors|length > 0 %}
                <div class="rounded-2xl bg-[#FF3B30]/10 px-5 py-3.5 text-[15px] font-medium text-[#FF3B30]">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}
        </div>

        {# DÉBUT DU FORMULAIRE #}
        {{ form_start(registrationForm, {attr: {class: 'space-y-5'}}) }}
            
            {# CHAMP EMAIL #}
            <div class="space-y-1.5">
                {{ form_label(registrationForm.email, 'Email', {
                    label_attr: {class: 'block pl-1 text-sm font-medium text-[#1D1D1F]'}
                }) }}
                {{ form_widget(registrationForm.email, {
                    attr: {
                        class: 'block w-full rounded-2xl border border-gray-200 bg-[#F5F5F7] px-5 py-3.5 text-[15px] text-[#1D1D1F] outline-none transition-all duration-300 placeholder:text-[#86868B] focus:border-[#0071E3] focus:bg-white focus:ring-4 focus:ring-[#0071E3]/20',
                        placeholder: 'nom@exemple.com'
                    }
                }) }}
                {% if registrationForm.email.vars.errors|length > 0 %}
                    <div class="pl-1 mt-1 text-sm font-medium text-[#FF3B30]">
                        {{ form_errors(registrationForm.email) }}
                    </div>
                {% endif %}
            </div>

            {# CHAMP MOT DE PASSE #}
            <div class="space-y-1.5">
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', {
                    label_attr: {class: 'block pl-1 text-sm font-medium text-[#1D1D1F]'}
                }) }}
                {{ form_widget(registrationForm.plainPassword, {
                    attr: {
                        class: 'block w-full rounded-2xl border border-gray-200 bg-[#F5F5F7] px-5 py-3.5 text-[15px] text-[#1D1D1F] outline-none transition-all duration-300 placeholder:text-[#86868B] focus:border-[#0071E3] focus:bg-white focus:ring-4 focus:ring-[#0071E3]/20',
                        placeholder: '8+ caractères, majuscule, chiffre, symbole'
                    }
                }) }}
                {% if registrationForm.plainPassword.vars.errors|length > 0 %}
                    <div class="pl-1 mt-1 text-sm font-medium text-[#FF3B30]">
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>
                {% endif %}
            </div>

            {# CHECKBOX CGU (Personnalisée façon iOS) #}
            <div class="pt-2">
                <label class="group inline-flex cursor-pointer items-center gap-3">
                    <div class="relative flex items-center">
                        {{ form_widget(registrationForm.agreeTerms, {
                            attr: {
                                class: 'peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-gray-300 bg-[#F5F5F7] transition-all checked:border-[#0071E3] checked:bg-[#0071E3] focus:outline-none focus:ring-4 focus:ring-[#0071E3]/20'
                            }
                        }) }}
                        <svg class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-white opacity-0 transition-opacity peer-checked:opacity-100" width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <span class="text-[15px] font-medium text-[#86868B] transition-colors group-hover:text-[#1D1D1F]">J'accepte les conditions d'utilisation</span>
                </label>
                {% if registrationForm.agreeTerms.vars.errors|length > 0 %}
                    <div class="pl-1 mt-1 text-sm font-medium text-[#FF3B30]">
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>
                {% endif %}
            </div>

            {# BOUTON SUBMIT #}
            <button type="submit" class="mt-4 w-full rounded-full bg-[#0071E3] px-5 py-4 text-[15px] font-semibold text-white shadow-sm transition-all duration-300 hover:scale-[1.02] hover:bg-[#0077ED] active:scale-95 focus:outline-none focus:ring-4 focus:ring-[#0071E3]/20">
                Créer mon compte
            </button>
            
        {{ form_end(registrationForm) }}

        {# PIED DE CARTE #}
        <p class="mt-8 text-center text-[15px] text-[#86868B]">
            Déjà inscrit ?
            <a href="{{ path('app_login') }}" class="font-semibold text-[#0071E3] transition-colors hover:text-[#0077ED] hover:underline">Se connecter</a>
        </p>
    </section>
{% endblock %}