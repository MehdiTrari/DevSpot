{% extends 'base.html.twig' %}

{% block title %}Inscription | DevSpot{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .register-terms-input:checked + .register-terms-icon {
            border-color: var(--premium-icon-success-border);
            background: var(--premium-icon-success-bg);
        }

        .register-terms-input:checked + .register-terms-icon svg {
            opacity: 1;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="ui-shell ui-shell-hover w-full max-w-xl rounded-[2.5rem] p-8 backdrop-blur-2xl sm:p-10">
        <div class="mb-8 text-center">
            <p class="ui-kicker mb-4 rounded-full px-3 py-1.5 text-xs font-semibold uppercase tracking-wider">
                Nouveau compte
            </p>
            <h1 class="ui-title text-3xl font-semibold tracking-tight">Créer un compte</h1>
            <p class="ui-text-muted mt-2 text-[15px]">Inscris-toi puis confirme ton email.</p>
        </div>

        <div class="ui-note mb-8 rounded-2xl border p-4 text-center text-[14px] leading-relaxed shadow-inner" style="background: var(--pale-amber-bg); border-color: var(--pale-amber-border); color: var(--pale-amber-text);">
            <span>Après confirmation, le compte restera en attente de validation par un administrateur.</span>
        </div>

        <div class="mb-6 space-y-3">
            {% for message in app.flashes('error') %}
                <div class="ui-error-box rounded-2xl px-5 py-3.5 text-[15px] font-medium">{{ message }}</div>
            {% endfor %}
            {% if registrationForm.vars.errors|length > 0 %}
                <div class="ui-error-box rounded-2xl px-5 py-3.5 text-[15px] font-medium">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}
        </div>

        {{ form_start(registrationForm, {attr: {class: 'space-y-6', id: 'register-form'}}) }}
            <div class="ui-panel rounded-2xl px-4 py-4 text-sm shadow-inner">
                <div class="mt-3 h-2 w-full overflow-hidden rounded-full" style="background: var(--ui-panel-subtle-bg);">
                    <div id="register-step-progress" class="h-full rounded-full transition-all duration-300" style="width: 50%; background: linear-gradient(90deg, var(--premium-icon-success-text), #34d399);"></div>
                </div>
                <div class="mt-3 text-center">
                    <span id="register-current-step-badge" class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-bold uppercase tracking-wide" style="border-color: var(--premium-icon-success-border); color: var(--premium-icon-success-text); background: var(--premium-icon-success-bg);">
                        Étape 1/2
                    </span>
                    <p id="register-current-step-title" class="ui-text-muted mt-2 text-[13px] font-medium">Choisis ton type de compte pour commencer.</p>
                </div>
            </div>

            <div id="register-step-1" class="space-y-4">
                <div class="space-y-2">
                    <p class="ui-input-label pl-1 text-[15px] font-medium">Je suis...</p>
                    {% if registrationForm.accountType.vars.errors|length > 0 %}
                        <div class="pl-1 text-sm font-medium text-red-400">{{ form_errors(registrationForm.accountType) }}</div>
                    {% endif %}
                    <div class="flex gap-3">
                        {% for choice in registrationForm.accountType %}
                            <label class="ui-choice-card group relative flex min-w-0 flex-1 cursor-pointer flex-col items-center gap-2 rounded-2xl p-5 text-center">
                                {{ form_widget(choice, {attr: {class: 'sr-only'}}) }}
                                {% if choice.vars.value == 'applicant' %}
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="ui-choice-icon h-7 w-7">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
                                    </svg>
                                    <span class="ui-title text-[15px] font-semibold">Postulant</span>
                                    <span class="ui-text-muted text-[12px]">Développeur cherchant un poste</span>
                                {% else %}
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="ui-choice-icon h-7 w-7">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                    </svg>
                                    <span class="ui-title text-[15px] font-semibold">Recruteur</span>
                                    <span class="ui-text-muted text-[12px]">Entreprise cherchant des talents</span>
                                {% endif %}
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <button type="button" id="register-next-step" class="ui-button-primary mt-4 w-full rounded-full px-5 py-4 text-[15px] font-bold active:scale-95 focus:outline-none disabled:cursor-not-allowed disabled:opacity-60">
                    Continuer vers l'étape 2
                </button>
            </div>

            <div id="register-step-2" class="hidden space-y-5">
                <p class="ui-input-label pl-1 text-[15px] font-medium">Informations du compte</p>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        {{ form_label(registrationForm.firstName, null, {label_attr: {class: 'ui-input-label block pl-1 text-[15px] font-medium'}}) }}
                        {{ form_widget(registrationForm.firstName, {attr: {class: 'ui-input block w-full rounded-2xl px-4 py-3.5 text-[15px] transition-all duration-300', placeholder: 'Jean'}}) }}
                        {% if registrationForm.firstName.vars.errors|length > 0 %}
                            <div class="pl-1 text-sm font-medium text-red-400">{{ form_errors(registrationForm.firstName) }}</div>
                        {% endif %}
                    </div>
                    <div class="space-y-1.5">
                        {{ form_label(registrationForm.lastName, null, {label_attr: {class: 'ui-input-label block pl-1 text-[15px] font-medium'}}) }}
                        {{ form_widget(registrationForm.lastName, {attr: {class: 'ui-input block w-full rounded-2xl px-4 py-3.5 text-[15px] transition-all duration-300', placeholder: 'Dupont'}}) }}
                        {% if registrationForm.lastName.vars.errors|length > 0 %}
                            <div class="pl-1 text-sm font-medium text-red-400">{{ form_errors(registrationForm.lastName) }}</div>
                        {% endif %}
                    </div>
                </div>

                <div id="recruiter-fields" class="ui-note hidden space-y-5 rounded-2xl p-5">
                    <p class="ui-text-muted text-[13px] font-semibold uppercase tracking-wider">Informations entreprise</p>

                    <div class="space-y-1.5">
                        {{ form_label(registrationForm.companyName, null, {label_attr: {class: 'ui-input-label block pl-1 text-[15px] font-medium'}}) }}
                        {{ form_widget(registrationForm.companyName, {attr: {class: 'ui-input block w-full rounded-2xl px-5 py-3.5 text-[15px] transition-all duration-300', placeholder: 'Acme Corp'}}) }}
                        {% if registrationForm.companyName.vars.errors|length > 0 %}
                            <div class="pl-1 text-sm font-medium text-red-400">{{ form_errors(registrationForm.companyName) }}</div>
                        {% endif %}
                    </div>

                    <div class="space-y-1.5">
                        {{ form_label(registrationForm.workEmail, null, {label_attr: {class: 'ui-input-label block pl-1 text-[15px] font-medium'}}) }}
                        {{ form_widget(registrationForm.workEmail, {attr: {class: 'ui-input block w-full rounded-2xl px-5 py-3.5 text-[15px] transition-all duration-300', placeholder: 'rh@acme.com'}}) }}
                        {% if registrationForm.workEmail.vars.errors|length > 0 %}
                            <div class="pl-1 text-sm font-medium text-red-400">{{ form_errors(registrationForm.workEmail) }}</div>
                        {% endif %}
                    </div>
                </div>

                <div class="space-y-1.5">
                    {{ form_label(registrationForm.email, null, {label_attr: {class: 'ui-input-label block pl-1 text-[15px] font-medium'}}) }}
                    {{ form_widget(registrationForm.email, {attr: {class: 'ui-input block w-full rounded-2xl px-5 py-3.5 text-[15px] transition-all duration-300', placeholder: 'nom@exemple.com'}}) }}
                    {% if registrationForm.email.vars.errors|length > 0 %}
                        <div class="pl-1 mt-1.5 text-sm font-medium text-red-400">{{ form_errors(registrationForm.email) }}</div>
                    {% endif %}
                </div>

                <div class="space-y-1.5">
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', {label_attr: {class: 'ui-input-label block pl-1 text-[15px] font-medium'}}) }}
                    {{ form_widget(registrationForm.plainPassword, {attr: {class: 'ui-input block w-full rounded-2xl px-5 py-3.5 text-[15px] transition-all duration-300', placeholder: '8+ caracteres, majuscule, chiffre, symbole'}}) }}
                    {% if registrationForm.plainPassword.vars.errors|length > 0 %}
                        <div class="pl-1 mt-1.5 text-sm font-medium text-red-400">{{ form_errors(registrationForm.plainPassword) }}</div>
                    {% endif %}
                </div>

                <div class="pt-2">
                    <label class="register-terms-label flex cursor-pointer items-start gap-3 rounded-2xl border px-4 py-3 transition-all duration-200" style="border-color: var(--ui-panel-border); background: var(--ui-panel-subtle-bg);">
                        {{ form_widget(registrationForm.agreeTerms, {attr: {class: 'register-terms-input sr-only'}}) }}
                        <span class="register-terms-icon mt-0.5 inline-flex h-5 w-5 items-center justify-center rounded-md border transition-all duration-200" style="border-color: var(--premium-icon-success-border); background: transparent;">
                            <svg class="h-3.5 w-3.5 opacity-0 transition-opacity duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--premium-icon-success-text);">
                                <path d="M3 8.5 6.2 11.5 13 4.5" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                        </span>
                        <span class="register-terms-text ui-text-secondary ui-hover-heading text-[15px] font-medium transition-colors">J'accepte les conditions d'utilisation</span>
                    </label>
                    {% if registrationForm.agreeTerms.vars.errors|length > 0 %}
                        <div class="pl-1 mt-1.5 text-sm font-medium text-red-400">{{ form_errors(registrationForm.agreeTerms) }}</div>
                    {% endif %}
                </div>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <button type="button" id="register-prev-step" class="ui-button-secondary w-full rounded-full px-5 py-3.5 text-[15px] font-semibold">Retour</button>
                    <button type="submit" class="ui-button-primary w-full rounded-full px-5 py-3.5 text-[15px] font-bold active:scale-95 focus:outline-none">
                        Créer mon compte
                    </button>
                </div>
            </div>
        {{ form_end(registrationForm) }}

        <p class="ui-text-muted mt-8 text-center text-[15px]">
            Déjà inscrit ?
            <a href="{{ path('app_login') }}" class="ui-link-accent font-semibold hover:underline">Se connecter</a>
        </p>
    </section>

    <script>
    (function () {
        var step1 = document.getElementById('register-step-1');
        var step2 = document.getElementById('register-step-2');
        var stepProgress = document.getElementById('register-step-progress');
        var stepBadge = document.getElementById('register-current-step-badge');
        var stepTitle = document.getElementById('register-current-step-title');
        var stepLabel1 = document.querySelector('[data-step-label="1"]');
        var stepLabel2 = document.querySelector('[data-step-label="2"]');
        var nextButton = document.getElementById('register-next-step');
        var prevButton = document.getElementById('register-prev-step');
        var recruiterSection = document.getElementById('recruiter-fields');
        var roleInputs = document.querySelectorAll('input[type="radio"][name*="[accountType]"]');
        var isSubmitted = {{ registrationForm.vars.submitted ? 'true' : 'false' }};

        function getCheckedRole() {
            return document.querySelector('input[type="radio"][name*="[accountType]"]:checked');
        }

        function syncRecruiterFields() {
            var checked = getCheckedRole();
            if (recruiterSection) {
                recruiterSection.classList.toggle('hidden', !checked || checked.value !== 'recruiter');
            }
        }

        function syncNextButton() {
            var checked = getCheckedRole();
            if (nextButton) {
                nextButton.disabled = !checked;
            }
        }

        function setStep(stepIndex) {
            var showStep2 = stepIndex === 2;
            if (step1) {
                step1.classList.toggle('hidden', showStep2);
            }
            if (step2) {
                step2.classList.toggle('hidden', !showStep2);
            }
            if (stepProgress) {
                stepProgress.style.width = showStep2 ? '100%' : '50%';
            }
            if (stepBadge) {
                stepBadge.textContent = showStep2 ? 'Étape 2/2' : 'Étape 1/2';
            }
            if (stepTitle) {
                stepTitle.textContent = showStep2
                    ? 'Complète tes informations.'
                    : 'Choisis ton type de compte pour commencer.';
            }
            if (stepLabel1) {
                stepLabel1.style.color = showStep2 ? 'var(--ui-text-muted)' : 'var(--premium-icon-success-text)';
            }
            if (stepLabel2) {
                stepLabel2.style.color = showStep2 ? 'var(--premium-icon-success-text)' : 'var(--ui-text-muted)';
            }
            if (stepBadge) {
                if (showStep2) {
                    stepBadge.style.borderColor = 'var(--premium-icon-success-border)';
                    stepBadge.style.color = 'var(--premium-icon-success-text)';
                    stepBadge.style.background = 'var(--premium-icon-success-bg)';
                } else {
                    stepBadge.style.borderColor = 'var(--premium-icon-success-border)';
                    stepBadge.style.color = 'var(--premium-icon-success-text)';
                    stepBadge.style.background = 'var(--premium-icon-success-bg)';
                }
            }
        }

        if (nextButton) {
            nextButton.addEventListener('click', function () {
                if (!getCheckedRole()) {
                    return;
                }
                setStep(2);
            });
        }

        if (prevButton) {
            prevButton.addEventListener('click', function () {
                setStep(1);
            });
        }

        roleInputs.forEach(function (input) {
            input.addEventListener('change', function () {
                syncRecruiterFields();
                syncNextButton();
            });
        });

        syncRecruiterFields();
        syncNextButton();
        setStep(isSubmitted && !!getCheckedRole() ? 2 : 1);
    })();
    </script>
{% endblock %}
