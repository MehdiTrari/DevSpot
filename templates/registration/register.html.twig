{% extends 'base.html.twig' %}

{% block title %}Inscription | DevSpot{% endblock %}

{% block body %}
    {# Carte en verre fumé #}
    <section class="w-full max-w-xl rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:bg-slate-900/60 hover:shadow-emerald-500/10 sm:p-10">
        
        {# EN-TÊTE #}
        <div class="mb-8 text-center">
            <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.4)] animate-pulse"></span>
                Nouveau compte
            </p>
            <h1 class="text-3xl font-semibold tracking-tight text-white">Créer un compte</h1>
            <p class="mt-2 text-[15px] text-slate-400">Inscris-toi puis confirme ton email.</p>
        </div>

        {# NOTE INFORMATIVE DOUCE #}
        <div class="mb-8 rounded-2xl border border-white/5 bg-white/5 p-4 text-center text-[14px] leading-relaxed text-slate-300 shadow-inner">
            Après confirmation, le compte restera en attente de validation par un administrateur.
        </div>

        {# MESSAGES FLASH ET ERREURS GLOBALES #}
        <div class="space-y-3 mb-6">
            {% if registrationForm.vars.errors|length > 0 %}
                <div class="rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-3.5 text-[15px] font-medium text-red-400 animate-fade-in-down">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}
        </div>

        {# DÉBUT DU FORMULAIRE #}
        {{ form_start(registrationForm, {attr: {class: 'space-y-5'}}) }}
            
            {# CHAMP EMAIL #}
            <div class="space-y-1.5">
                {{ form_label(registrationForm.email, 'Email', {
                    label_attr: {class: 'block pl-1 text-[15px] font-medium text-slate-200'}
                }) }}
                {{ form_widget(registrationForm.email, {
                    attr: {
                        class: 'block w-full rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-[15px] text-white outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-emerald-500 focus:bg-white/10 focus:ring-4 focus:ring-emerald-500/20 shadow-inner',
                        placeholder: 'nom@exemple.com'
                    }
                }) }}
                {% if registrationForm.email.vars.errors|length > 0 %}
                    <div class="pl-1 mt-1.5 text-sm font-medium text-red-400 animate-fade-in-down">
                        {{ form_errors(registrationForm.email) }}
                    </div>
                {% endif %}
            </div>

            {# CHAMP MOT DE PASSE #}
            <div class="space-y-1.5">
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', {
                    label_attr: {class: 'block pl-1 text-[15px] font-medium text-slate-200'}
                }) }}
                {{ form_widget(registrationForm.plainPassword, {
                    attr: {
                        class: 'block w-full rounded-2xl border border-white/10 bg-white/5 px-5 py-3.5 text-[15px] text-white outline-none transition-all duration-300 placeholder:text-slate-500 focus:border-emerald-500 focus:bg-white/10 focus:ring-4 focus:ring-emerald-500/20 shadow-inner',
                        placeholder: '8+ caractères, majuscule, chiffre, symbole'
                    }
                }) }}
                {% if registrationForm.plainPassword.vars.errors|length > 0 %}
                    <div class="pl-1 mt-1.5 text-sm font-medium text-red-400 animate-fade-in-down">
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>
                {% endif %}
            </div>

            {# CHECKBOX CGU (Adaptée au Dark Mode) #}
            <div class="pt-2">
                <label class="group inline-flex cursor-pointer items-center gap-3">
                    <div class="relative flex items-center">
                        {{ form_widget(registrationForm.agreeTerms, {
                            attr: {
                                class: 'peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-white/10 bg-white/5 shadow-inner transition-all checked:border-emerald-500 checked:bg-emerald-500 focus:outline-none focus:ring-4 focus:ring-emerald-500/20'
                            }
                        }) }}
                        <svg class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-white opacity-0 transition-opacity peer-checked:opacity-100" width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <span class="text-[15px] font-medium text-slate-400 transition-colors group-hover:text-white">J'accepte les conditions d'utilisation</span>
                </label>
                {% if registrationForm.agreeTerms.vars.errors|length > 0 %}
                    <div class="pl-1 mt-1.5 text-sm font-medium text-red-400 animate-fade-in-down">
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>
                {% endif %}
            </div>

            {# BOUTON SUBMIT #}
            <button type="submit" class="mt-4 w-full rounded-full bg-emerald-500 px-5 py-4 text-[15px] font-bold text-slate-950 shadow-lg shadow-emerald-500/20 transition-all duration-300 hover:scale-[1.02] hover:bg-emerald-400 active:scale-95 focus:outline-none focus:ring-4 focus:ring-emerald-500/30">
                Créer mon compte
            </button>
            
        {{ form_end(registrationForm) }}

        {# PIED DE CARTE #}
        <p class="mt-8 text-center text-[15px] text-slate-400">
            Déjà inscrit ?
            <a href="{{ path('app_login') }}" class="font-semibold text-emerald-400 transition-colors hover:text-emerald-300 hover:underline">Se connecter</a>
        </p>
    </section>
{% endblock %}