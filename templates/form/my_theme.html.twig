{% use 'tailwind_2_layout.html.twig' %}

{# Personnalisation du champ de texte (input) #}
{% block widget_attributes %}
    {% set attr = attr|merge({class: attr.class|default('') ~ ' mt-1 block w-full rounded-xl border-violet-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:border-violet-500 focus:ring-violet-500 transition-all'}) %}
    {{ parent() }}
{% endblock %}

{# Personnalisation des labels #}
{% block form_label %}
    {% set label_attr = label_attr|merge({class: label_attr.class|default('') ~ ' block text-sm font-medium text-slate-700 mb-1'}) %}
    {{ parent() }}
{% endblock %}

{# --- FORM THEME TAILWIND --- #}
{% block form_row %}
    <div class="mb-4">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
        {{ form_help(form) }}
    </div>
{% endblock %}

{# {% block form_label %}
    {% if label is not same as(false) %}
        {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' block text-sm font-medium text-slate-700 mb-1.5')|trim}) %}
        <label{% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}>
            {{- label|trans -}}
        </label>
    {% endif %}
{% endblock %} #}

{% block form_widget_simple %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' block w-full rounded-xl border-slate-200 shadow-sm focus:border-violet-500 focus:ring-violet-500 sm:text-sm transition duration-150 ease-in-out py-2.5')|trim}) %}
    <input type="{{ type|default('text') }}" {{ block('widget_attributes') }} {% if value is not empty %}value="{{ value }}"{% endif %}/>
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' block w-full rounded-xl border-slate-200 shadow-sm focus:border-violet-500 focus:ring-violet-500 sm:text-sm transition duration-150 ease-in-out py-2.5')|trim}) %}
    <textarea {{ block('widget_attributes') }}>{{ value }}</textarea>
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' block w-full rounded-xl border-slate-200 bg-transparent shadow-sm focus:border-violet-500 focus:ring-violet-500 sm:text-sm transition-all py-2.5 pl-4 pr-10 cursor-pointer relative z-10')|trim
    }) %}
    <div class="relative group">
        <select {{ block('widget_attributes') }}>
            {% if placeholder is not none %}
                <option value=""{% if required and value is empty %} selected="selected"{% endif %}>{{ placeholder|trans }}</option>
            {% endif %}
            {% if preferred_choices|length > 0 %}
                {% set options = preferred_choices %}
                {{ block('choice_widget_options') }}
                <option disabled="disabled">{{ separator }}</option>
            {% endif %}
            {% set options = choices %}
            {{ block('choice_widget_options') }}
        </select>
        
        {# L'icône de flèche personnalisée qui reste fixe #}
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400 group-hover:text-violet-500 transition-colors">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z" clip-rule="evenodd" />
            </svg>
        </div>
    </div>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <p class="mt-1 text-sm text-red-600">{{ errors[0].message }}</p>
    {% endif %}
{% endblock %}

{% block date_widget %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' block w-full rounded-xl border-slate-200 shadow-sm focus:border-violet-500 focus:ring-violet-500 sm:text-sm py-2.5 js-datepicker bg-white')|trim,
        'placeholder': 'Sélectionner une date...',
        'readonly': 'readonly' 
    }) %}
    <div class="relative">
        <input type="text" {{ block('widget_attributes') }} {% if value is not empty %}value="{{ value }}"{% endif %}/>
        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-400"> {# text-violet-500 #}
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
        </div>
    </div>
{% endblock %}