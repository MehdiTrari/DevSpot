{% use 'tailwind_2_layout.html.twig' %}

{# --- ROW (Conteneur principal de chaque champ) --- #}
{% block form_row %}
    <div class="mb-5 space-y-1.5">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
        {{ form_help(form) }}
    </div>
{% endblock %}

{# --- LABEL --- #}
{% block form_label %}
    {% if label is not same as(false) %}
        {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' block pl-1 text-[15px] font-medium text-[#1D1D1F]')|trim}) %}
        <label {% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}>
            {{- label|trans -}}
        </label>
    {% endif %}
{% endblock %}

{# --- INPUT TEXT / EMAIL / PASSWORD --- #}
{% block form_widget_simple %}
    {% set type = type|default('text') %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' block w-full rounded-2xl border border-gray-200 bg-[#F5F5F7] px-4 py-3.5 text-[15px] text-[#1D1D1F] outline-none transition-all duration-300 placeholder:text-[#86868B] focus:border-[#0071E3] focus:bg-white focus:ring-4 focus:ring-[#0071E3]/20 shadow-sm')|trim
    }) %}
    <input type="{{ type }}" {{ block('widget_attributes') }} {% if value is not empty %}value="{{ value }}"{% endif %}/>
{% endblock %}

{# --- TEXTAREA --- #}
{% block textarea_widget %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' block w-full min-h-[120px] rounded-2xl border border-gray-200 bg-[#F5F5F7] px-4 py-3.5 text-[15px] text-[#1D1D1F] outline-none transition-all duration-300 placeholder:text-[#86868B] focus:border-[#0071E3] focus:bg-white focus:ring-4 focus:ring-[#0071E3]/20 shadow-sm')|trim
    }) %}
    <textarea {{ block('widget_attributes') }}>{{ value }}</textarea>
{% endblock %}

{# --- SELECT (Choice) --- #}
{% block choice_widget_collapsed %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' block w-full appearance-none rounded-2xl border border-gray-200 bg-[#F5F5F7] px-4 py-3.5 pr-10 text-[15px] text-[#1D1D1F] outline-none transition-all duration-300 focus:border-[#0071E3] focus:bg-white focus:ring-4 focus:ring-[#0071E3]/20 shadow-sm cursor-pointer relative z-10')|trim
    }) %}
    <div class="relative group">
        <select {{ block('widget_attributes') }}>
            {% if placeholder is not none %}
                <option value="" {% if required and value is empty %} selected="selected"{% endif %}>{{ placeholder|trans }}</option>
            {% endif %}
            {% if preferred_choices|length > 0 %}
                {% set options = preferred_choices %}
                {{ block('choice_widget_options') }}
                <option disabled="disabled">{{ separator }}</option>
            {% endif %}
            {% set options = choices %}
            {{ block('choice_widget_options') }}
        </select>
        
        {# Flèche iOS style pour le select #}
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-[#86868B] group-focus-within:text-[#0071E3] transition-colors duration-300">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4" />
            </svg>
        </div>
    </div>
{% endblock %}

{# --- DATE PICKER (Flatpickr) --- #}
{% block date_widget %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' block w-full rounded-2xl border border-gray-200 bg-[#F5F5F7] px-4 py-3.5 pr-10 text-[15px] text-[#1D1D1F] outline-none transition-all duration-300 placeholder:text-[#86868B] focus:border-[#0071E3] focus:bg-white focus:ring-4 focus:ring-[#0071E3]/20 shadow-sm js-datepicker cursor-pointer')|trim,
        'placeholder': 'Sélectionner une date...',
        'readonly': 'readonly' 
    }) %}
    <div class="relative group">
        <input type="text" {{ block('widget_attributes') }} {% if value is not empty %}value="{{ value }}"{% endif %}/>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-[#86868B] group-focus-within:text-[#0071E3] transition-colors duration-300">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
        </div>
    </div>
{% endblock %}

{# --- ERRORS --- #}
{% block form_errors %}
    {% if errors|length > 0 %}
        <p class="pl-1 mt-1.5 text-sm font-medium text-[#FF3B30] animate-fade-in-down">
            {{ errors[0].message }}
        </p>
    {% endif %}
{% endblock %}

{# --- HELP TEXT --- #}
{% block form_help %}
    {% if help is not empty %}
        <p class="pl-1 mt-1.5 text-[13px] text-[#86868B]">{{ help }}</p>
    {% endif %}
{% endblock %}