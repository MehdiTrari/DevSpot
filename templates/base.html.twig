<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="turbo-cache-control" content="no-preview">
        <title>{% block title %}DevSpot{% endblock %}</title>
        
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><circle cx=%2264%22 cy=%2264%22 r=%2260%22 fill=%22%2310b981%22/><circle cx=%2296%22 cy=%2232%22 r=%2216%22 fill=%22%23facc15%22/></svg>">
        
        {% block stylesheets %}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
            <style>
                /* Style du calendrier Flatpickr - adapté pour le Dark Mode avec le Vert */
                .flatpickr-calendar {
                    border-radius: 1.5rem !important;
                    border: 1px solid rgba(255,255,255,0.1) !important;
                    box-shadow: 0 20px 40px rgba(0,0,0,0.3) !important;
                    padding: 8px !important;
                    font-family: inherit !important;
                    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
                }
                .flatpickr-day.selected {
                    background: #10b981 !important; /* Vert Emerald */
                    border-color: #10b981 !important;
                }

                /* ANIMATIONS */
                @keyframes appleSlideUp {
                    0% { opacity: 0; transform: translateY(24px); }
                    100% { opacity: 1; transform: translateY(0); }
                }
                @keyframes appleFadeIn {
                    0% { opacity: 0; }
                    100% { opacity: 1; }
                }

                .apple-fade {
                    animation: appleFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
                }
                .apple-slide-up {
                    animation: appleSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
                }
                .apple-slide-up-delay-1 {
                    animation: appleSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
                }
                .apple-slide-up-delay-2 {
                    animation: appleSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {% if app.environment != 'test' %}
                {% block importmap %}{{ importmap('app') }}{% endblock %}
            {% endif %}
            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
            <script src="https://npmcdn.com/flatpickr/dist/l10n/fr.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    flatpickr(".js-datepicker", {
                        locale: "fr",
                        dateFormat: "d/m/Y",
                        allowInput: true,
                        disableMobile: "true",
                    });

                    const flashElements = document.querySelectorAll('[data-flash-autodismiss="true"]');

                    flashElements.forEach((flashElement) => {
                        let dismissed = false;
                        const duration = Number.parseInt(flashElement.dataset.flashDuration ?? '5000', 10);

                        const dismiss = () => {
                            if (dismissed) {
                                return;
                            }

                            dismissed = true;
                            flashElement.classList.add('opacity-0', 'translate-y-1');
                            flashElement.style.pointerEvents = 'none';

                            window.setTimeout(() => {
                                flashElement.remove();
                            }, 320);
                        };

                        const closeButton = flashElement.querySelector('[data-flash-close="true"]');
                        if (closeButton) {
                            closeButton.addEventListener('click', dismiss);
                        }

                        window.setTimeout(dismiss, Number.isNaN(duration) ? 5000 : duration);
                    });
                });
            </script>
        {% endblock %}
    </head>
    
    {# Fond Slate très foncé et sélection de texte en vert #}
    <body class="min-h-screen bg-slate-950 text-slate-100 font-sans antialiased selection:bg-emerald-500 selection:text-white">
        <div class="relative min-h-screen overflow-hidden">
            
            {# Les blobs avec la classe apple-fade (Opacité et taille augmentées pour bien ressortir) #}
            <div class="apple-fade pointer-events-none absolute -top-32 -left-20 h-[500px] w-[500px] rounded-full bg-emerald-500/40 blur-[120px]"></div>
            <div class="apple-fade pointer-events-none absolute -right-32 top-1/4 h-[500px] w-[500px] rounded-full bg-yellow-400/30 blur-[120px]" style="animation-delay: 0.2s;"></div>
            <div class="apple-fade pointer-events-none absolute bottom-0 left-1/4 h-[600px] w-[600px] rounded-full bg-emerald-600/40 blur-[120px]" style="animation-delay: 0.4s;"></div>

            {# HEADER avec apple-slide-up #}
            <header class="apple-slide-up relative z-10 mx-auto w-full max-w-6xl px-4 pt-6 sm:px-6 lg:px-8">
                <nav class="flex items-center">
                    {# Style "Glassmorphism Dark" pour le bouton DevSpot #}
                    <a href="{{ path('app_home') }}" class="group inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[15px] font-semibold tracking-tight text-white shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-white/10 hover:shadow-emerald-500/20 active:scale-95">
                        <span class="relative flex h-2.5 w-2.5 items-center justify-center">
                            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-400 opacity-40"></span>
                            <span class="relative inline-flex h-2 w-2 rounded-full bg-yellow-400 transition-transform duration-300 group-hover:scale-110"></span>
                        </span>
                        DevSpot
                    </a>
                </nav>
            </header>

            {# MAIN avec apple-slide-up-delay-1 #}
            <main class="apple-slide-up-delay-1 relative z-10 mx-auto flex min-h-[calc(100vh-84px)] w-full max-w-6xl items-center justify-center px-4 pb-12 pt-8 sm:px-6 lg:px-8">
                {% block body %}{% endblock %}
            </main>
            
        </div>
    </body>
</html>