<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="turbo-cache-control" content="no-preview">
        <title>{% block title %}DevSpot{% endblock %}</title>
        
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2228%22 fill=%22%230f172a%22/><path d=%22M48 36L22 64l26 28%22 stroke=%22%2310b981%22 stroke-width=%229%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22 fill=%22none%22/><path d=%22M80 36l26 28-26 28%22 stroke=%22%2310b981%22 stroke-width=%229%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22 fill=%22none%22/><line x1=%2270%22 y1=%2228%22 x2=%2258%22 y2=%22100%22 stroke=%22%2334d399%22 stroke-width=%227%22 stroke-linecap=%22round%22 opacity=%22.6%22/></svg>">
        
        {% block stylesheets %}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
            <style>
                /* Style du calendrier Flatpickr - adapté pour le Dark Mode avec le Vert */
                .flatpickr-calendar {
                    border-radius: 1.5rem !important;
                    border: 1px solid rgba(255,255,255,0.1) !important;
                    box-shadow: 0 20px 40px rgba(0,0,0,0.3) !important;
                    padding: 8px !important;
                    font-family: inherit !important;
                    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
                }
                .flatpickr-day.selected {
                    background: #10b981 !important; /* Vert Emerald */
                    border-color: #10b981 !important;
                }

                /* ANIMATIONS */
                @keyframes appleSlideUp {
                    0% { opacity: 0; transform: translateY(24px); }
                    100% { opacity: 1; transform: translateY(0); }
                }
                @keyframes appleFadeIn {
                    0% { opacity: 0; }
                    100% { opacity: 1; }
                }

                .apple-fade {
                    animation: appleFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
                }
                .apple-slide-up {
                    animation: appleSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
                }
                .apple-slide-up-delay-1 {
                    animation: appleSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
                }
                .apple-slide-up-delay-2 {
                    animation: appleSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {% if app.environment != 'test' %}
                {% block importmap %}{{ importmap('app') }}{% endblock %}
            {% endif %}
            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
            <script src="https://npmcdn.com/flatpickr/dist/l10n/fr.js"></script>
            <script>
                const initUiBehaviors = () => {
                    const notificationStack = document.querySelector('[data-notification-stack="true"]');

                    const buildNotificationElement = (message, type = 'info') => {
                        const styles = {
                            success: 'border-emerald-500/20 bg-emerald-500/10 text-emerald-300',
                            info: 'border-yellow-400/20 bg-yellow-400/10 text-yellow-300',
                            error: 'border-red-500/20 bg-red-500/10 text-red-300',
                        };

                        const closeStyles = {
                            success: 'text-emerald-200/90 hover:text-emerald-100',
                            info: 'text-yellow-200/90 hover:text-yellow-100',
                            error: 'text-red-200/90 hover:text-red-100',
                        };

                        const element = document.createElement('div');
                        const styleKey = styles[type] ? type : 'info';
                        element.setAttribute('data-notification-autodismiss', 'true');
                        element.setAttribute('data-notification-duration', '4000');
                        element.className = `pointer-events-auto rounded-2xl border px-5 py-3.5 text-[15px] font-medium shadow-xl backdrop-blur-md transition-all duration-300 ease-out ${styles[styleKey]}`;
                        element.innerHTML = `
                            <div class="flex items-start justify-between gap-4">
                                <p class="leading-relaxed"></p>
                                <button type="button" data-notification-close="true" aria-label="Fermer la notification" class="shrink-0 transition ${closeStyles[styleKey]}">×</button>
                            </div>
                        `;
                        element.querySelector('p').textContent = message;

                        return element;
                    };

                    const pushNotification = (message, type = 'info') => {
                        if (!notificationStack) {
                            return;
                        }

                        notificationStack.prepend(buildNotificationElement(message, type));
                        initUiBehaviors();
                    };

                    flatpickr(".js-datepicker", {
                        locale: "fr",
                        dateFormat: "Y-m-d",
                        altInput: true,
                        altFormat: "d/m/Y",
                        allowInput: true,
                        disableMobile: "true",
                    });

                    const flashElements = document.querySelectorAll('[data-notification-autodismiss="true"]');

                    flashElements.forEach((flashElement) => {
                        if (flashElement.dataset.notificationInitialized === 'true') {
                            return;
                        }
                        flashElement.dataset.notificationInitialized = 'true';

                        let dismissed = false;
                        const duration = Number.parseInt(flashElement.dataset.notificationDuration ?? '4000', 10);

                        const dismiss = () => {
                            if (dismissed) {
                                return;
                            }

                            dismissed = true;
                            flashElement.style.pointerEvents = 'none';
                            flashElement.style.overflow = 'hidden';

                            const computedStyle = window.getComputedStyle(flashElement);
                            const currentHeight = flashElement.offsetHeight;

                            flashElement.style.maxHeight = `${currentHeight}px`;
                            flashElement.style.marginTop = computedStyle.marginTop;
                            flashElement.style.marginBottom = computedStyle.marginBottom;
                            flashElement.style.paddingTop = computedStyle.paddingTop;
                            flashElement.style.paddingBottom = computedStyle.paddingBottom;
                            flashElement.style.borderTopWidth = computedStyle.borderTopWidth;
                            flashElement.style.borderBottomWidth = computedStyle.borderBottomWidth;
                            flashElement.style.transition = 'max-height 420ms cubic-bezier(0.16, 1, 0.3, 1), margin 420ms cubic-bezier(0.16, 1, 0.3, 1), padding 420ms cubic-bezier(0.16, 1, 0.3, 1), border-width 420ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms ease, transform 300ms ease';

                            requestAnimationFrame(() => {
                                requestAnimationFrame(() => {
                                    flashElement.style.opacity = '0';
                                    flashElement.style.transform = 'translateY(6px)';
                                    flashElement.style.maxHeight = '0px';
                                    flashElement.style.marginTop = '0px';
                                    flashElement.style.marginBottom = '0px';
                                    flashElement.style.paddingTop = '0px';
                                    flashElement.style.paddingBottom = '0px';
                                    flashElement.style.borderTopWidth = '0px';
                                    flashElement.style.borderBottomWidth = '0px';
                                });
                            });

                            flashElement.setAttribute('aria-hidden', 'true');
                        };

                        const closeButton = flashElement.querySelector('[data-notification-close="true"]');
                        if (closeButton) {
                            closeButton.addEventListener('click', dismiss);
                        }

                        window.setTimeout(dismiss, Number.isNaN(duration) ? 4000 : duration);
                    });

                    const outlinedHeartIcon = `
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m12 20.25-.32-.17C9.24 18.8 3 15.37 3 9.75A4.5 4.5 0 0 1 7.5 5.25c1.74 0 3.16.81 4.5 2.09 1.34-1.28 2.76-2.09 4.5-2.09A4.5 4.5 0 0 1 21 9.75c0 5.62-6.24 9.05-8.68 10.33L12 20.25Z" />
                        </svg>
                    `.trim();

                    const filledHeartIcon = `
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                            <path d="M11.645 20.91a.75.75 0 0 0 .71 0c1.055-.518 9.145-4.707 9.145-11.41A5.25 5.25 0 0 0 12 6.084 5.25 5.25 0 0 0 2.5 9.5c0 6.703 8.09 10.892 9.145 11.41Z" />
                        </svg>
                    `.trim();

                    const selectorEscape = (value) => {
                        if (window.CSS && typeof window.CSS.escape === 'function') {
                            return window.CSS.escape(String(value));
                        }

                        return String(value);
                    };

                    const getFavoriteForms = (profileId) => document.querySelectorAll(
                        `[data-favorite-toggle="true"][data-favorite-profile-id="${selectorEscape(profileId)}"]`
                    );

                    const setFavoriteFormLoading = (formElement, isLoading) => {
                        const button = formElement.querySelector('[data-favorite-button="true"]');
                        if (!button) {
                            return;
                        }

                        if (isLoading) {
                            button.setAttribute('disabled', 'disabled');
                            button.classList.add('opacity-70', 'cursor-not-allowed');
                            return;
                        }

                        button.removeAttribute('disabled');
                        button.classList.remove('opacity-70', 'cursor-not-allowed');
                    };

                    const updateFavoriteButtonState = (formElement, isFavorite) => {
                        const button = formElement.querySelector('[data-favorite-button="true"]');
                        const tokenInput = formElement.querySelector('[data-favorite-token="true"]');
                        const content = formElement.querySelector('[data-favorite-content="true"]');

                        if (!button || !tokenInput || !content) {
                            return;
                        }

                        const label = isFavorite
                            ? (formElement.dataset.favoriteRemoveLabel ?? 'Retirer des favoris')
                            : (formElement.dataset.favoriteAddLabel ?? 'Ajouter aux favoris');

                        formElement.action = isFavorite
                            ? (formElement.dataset.favoriteRemoveUrl ?? formElement.action)
                            : (formElement.dataset.favoriteAddUrl ?? formElement.action);
                        tokenInput.value = isFavorite
                            ? (formElement.dataset.favoriteRemoveToken ?? tokenInput.value)
                            : (formElement.dataset.favoriteAddToken ?? tokenInput.value);
                        button.dataset.favoriteAction = isFavorite ? 'remove' : 'add';
                        button.className = isFavorite
                            ? (formElement.dataset.favoriteRemoveButtonClass ?? button.className)
                            : (formElement.dataset.favoriteAddButtonClass ?? button.className);
                        button.setAttribute('aria-label', label);
                        button.setAttribute('title', label);

                        if (formElement.dataset.favoriteIconOnly === '1') {
                            content.innerHTML = isFavorite ? filledHeartIcon : outlinedHeartIcon;
                        } else {
                            content.textContent = label;
                        }
                    };

                    const updateFavoriteCount = (favoriteCount) => {
                        if (!Number.isFinite(favoriteCount)) {
                            return;
                        }

                        document.querySelectorAll('[data-favorite-count-value="true"]').forEach((element) => {
                            element.textContent = String(favoriteCount);
                        });

                        const countLabel = favoriteCount === 1
                            ? 'profil développeur enregistré.'
                            : 'profils développeurs enregistrés.';

                        document.querySelectorAll('[data-favorite-count-label="true"]').forEach((element) => {
                            element.textContent = countLabel;
                        });
                    };

                    const refreshFavoriteListState = () => {
                        const list = document.querySelector('[data-favorite-list="true"]');
                        if (!list) {
                            return;
                        }

                        const emptyState = list.querySelector('[data-favorite-empty-state="true"]');
                        if (!emptyState) {
                            return;
                        }

                        const hasEntries = list.querySelectorAll('[data-favorite-entry="true"]').length > 0;
                        emptyState.classList.toggle('hidden', hasEntries);
                    };

                    const syncFavoriteForms = (profileId, isFavorite) => {
                        getFavoriteForms(profileId).forEach((formElement) => {
                            if (!isFavorite && formElement.dataset.favoriteRemoveCardOnRemove === '1') {
                                const entry = formElement.closest('[data-favorite-entry="true"]');
                                if (entry) {
                                    entry.remove();
                                    return;
                                }
                            }

                            updateFavoriteButtonState(formElement, isFavorite);
                        });

                        refreshFavoriteListState();
                    };

                    const favoriteForms = document.querySelectorAll('[data-favorite-toggle="true"]');

                    favoriteForms.forEach((formElement) => {
                        if (formElement.dataset.favoriteInitialized === 'true') {
                            return;
                        }
                        formElement.dataset.favoriteInitialized = 'true';

                        const initialIsFavorite = formElement.querySelector('[data-favorite-button="true"]')?.dataset.favoriteAction === 'remove';
                        updateFavoriteButtonState(formElement, initialIsFavorite);

                        formElement.addEventListener('submit', async (event) => {
                            event.preventDefault();

                            const profileId = formElement.dataset.favoriteProfileId;
                            if (!profileId) {
                                formElement.submit();
                                return;
                            }

                            const relatedForms = Array.from(getFavoriteForms(profileId));
                            relatedForms.forEach((relatedForm) => setFavoriteFormLoading(relatedForm, true));

                            try {
                                const response = await fetch(formElement.action, {
                                    method: 'POST',
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest',
                                        'Accept': 'application/json',
                                    },
                                    body: new FormData(formElement),
                                    credentials: 'same-origin',
                                });

                                const payload = await response.json().catch(() => ({}));

                                if (!response.ok || !payload.success) {
                                    pushNotification(payload?.message ?? 'Action impossible, merci de reessayer.', payload?.type ?? 'error');
                                    return;
                                }

                                syncFavoriteForms(profileId, payload.isFavorite === true);

                                const favoriteCount = Number.parseInt(String(payload.favoriteCount ?? ''), 10);
                                if (!Number.isNaN(favoriteCount)) {
                                    updateFavoriteCount(favoriteCount);
                                }

                                pushNotification(payload.message ?? 'Favoris mis a jour.', payload.type ?? 'success');
                            } catch (_error) {
                                pushNotification('Erreur reseau, merci de reessayer.', 'error');
                            } finally {
                                relatedForms.forEach((relatedForm) => setFavoriteFormLoading(relatedForm, false));
                            }
                        });
                    });

                    const visibilityForms = document.querySelectorAll('[data-visibility-toggle="true"]');

                    visibilityForms.forEach((formElement) => {
                        if (formElement.dataset.visibilityInitialized === 'true') {
                            return;
                        }
                        formElement.dataset.visibilityInitialized = 'true';

                        formElement.addEventListener('submit', async (event) => {
                            event.preventDefault();

                            const submitButton = formElement.querySelector('[data-visibility-button="true"]');
                            const hiddenVisibilityInput = formElement.querySelector('[data-visibility-value="true"]');
                            const badge = formElement.parentElement?.querySelector('[data-visibility-badge="true"]');

                            if (!submitButton || !hiddenVisibilityInput || !badge) {
                                formElement.submit();
                                return;
                            }

                            submitButton.setAttribute('disabled', 'disabled');
                            submitButton.classList.add('opacity-70', 'cursor-not-allowed');

                            try {
                                const response = await fetch(formElement.action, {
                                    method: 'POST',
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest',
                                        'Accept': 'application/json',
                                    },
                                    body: new FormData(formElement),
                                    credentials: 'same-origin',
                                });

                                const payload = await response.json();

                                if (!response.ok || !payload.success) {
                                    const errorMessage = payload?.message ?? 'Action impossible, merci de réessayer.';
                                    if (notificationStack) {
                                        notificationStack.prepend(buildNotificationElement(errorMessage, payload?.type ?? 'error'));
                                        initUiBehaviors();
                                    }
                                    return;
                                }

                                const isPublic = payload.isPublic === true;
                                badge.textContent = isPublic ? 'Public' : 'Privé';
                                badge.classList.remove('border-emerald-500/30', 'bg-emerald-500/10', 'text-emerald-400', 'border-white/10', 'bg-white/5', 'text-slate-400');
                                if (isPublic) {
                                    badge.classList.add('border-emerald-500/30', 'bg-emerald-500/10', 'text-emerald-400');
                                } else {
                                    badge.classList.add('border-white/10', 'bg-white/5', 'text-slate-400');
                                }

                                hiddenVisibilityInput.value = isPublic ? '0' : '1';
                                submitButton.textContent = isPublic ? 'Passer en privé' : 'Passer en public';

                                if (notificationStack) {
                                    notificationStack.prepend(buildNotificationElement(payload.message ?? 'Visibilité mise à jour.', payload.type ?? 'success'));
                                    initUiBehaviors();
                                }
                            } catch (_error) {
                                if (notificationStack) {
                                    notificationStack.prepend(buildNotificationElement('Erreur réseau, merci de réessayer.', 'error'));
                                    initUiBehaviors();
                                }
                            } finally {
                                submitButton.removeAttribute('disabled');
                                submitButton.classList.remove('opacity-70', 'cursor-not-allowed');
                            }
                        });
                    });
                };

                document.addEventListener('DOMContentLoaded', initUiBehaviors);
                document.addEventListener('turbo:load', initUiBehaviors);
            </script>
        {% endblock %}
    </head>
    
    {# Fond Slate très foncé et sélection de texte en vert #}
    <body class="min-h-screen bg-slate-950 text-slate-100 font-sans antialiased selection:bg-emerald-500 selection:text-white">
        <div class="relative min-h-screen overflow-hidden">
            
            {# Les blobs avec la classe apple-fade (Opacité et taille augmentées pour bien ressortir) #}
            <div class="apple-fade pointer-events-none absolute -top-32 -left-20 h-[500px] w-[500px] rounded-full bg-emerald-500/40 blur-[120px]"></div>
            <div class="apple-fade pointer-events-none absolute -right-32 top-1/4 h-[500px] w-[500px] rounded-full bg-emerald-600/40 blur-[120px]" style="animation-delay: 0.2s;"></div>
            <div class="apple-fade pointer-events-none absolute bottom-0 left-1/4 h-[600px] w-[600px] rounded-full bg-emerald-600/40 blur-[120px]" style="animation-delay: 0.4s;"></div>

            {# HEADER stable (sans animation) #}
            <header class="relative z-10 mx-auto w-full max-w-7xl px-3 pt-6 sm:px-4 lg:px-5">
                <nav class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <a href="{{ path('app_home') }}" class="group inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[15px] font-semibold tracking-tight text-white shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-white/10 hover:shadow-emerald-500/20 active:scale-95">
                            <span class="flex h-5 w-5 items-center justify-center transition-transform duration-300 group-hover:scale-110">
                                <svg class="h-5 w-5" viewBox="0 0 128 128" fill="none">
                                    <path d="M48 36L22 64l26 28" stroke="#10b981" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M80 36l26 28-26 28" stroke="#10b981" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/>
                                    <line x1="70" y1="28" x2="58" y2="100" stroke="#34d399" stroke-width="9" stroke-linecap="round" opacity=".6"/>
                                </svg>
                            </span>
                            DevSpot
                        </a>

                        {% if app.user and not is_granted('ROLE_ADMIN') %}
                            {% if is_granted('ROLE_APPLICANT') %}
                                <a href="{{ path('app_applicant_home') }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[15px] font-semibold tracking-tight text-white shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-white/10 hover:shadow-emerald-500/20 active:scale-95">
                                    Dashboard
                                </a>
                            {% elseif is_granted('ROLE_RECRUITER') %}
                                <a href="{{ path('app_recruiter_home') }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[15px] font-semibold tracking-tight text-white shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-white/10 hover:shadow-emerald-500/20 active:scale-95">
                                    Dashboard
                                </a>
                            {% endif %}
                        {% endif %}
                    </div>

                    <div class="flex items-center gap-3">
                        {% if app.user %}
                            {% set unreadNotificationsCount = unread_notifications_count(app.user) %}

                            <a href="{{ path('app_notifications_index') }}" class="relative inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-white/10 hover:shadow-emerald-500/20 active:scale-95" aria-label="Accéder aux notifications">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.86 17.082a2 2 0 1 1-3.72 0M4.5 17.25h15a1.5 1.5 0 0 0 1.177-2.427l-1.53-1.92A5.98 5.98 0 0 1 18 9.166V8a6 6 0 1 0-12 0v1.166c0 1.352-.455 2.665-1.292 3.737l-1.53 1.92A1.5 1.5 0 0 0 4.5 17.25Z" />
                                </svg>
                                {% if unreadNotificationsCount > 0 %}
                                    <span class="absolute -right-1 -top-1 inline-flex min-h-5 min-w-5 items-center justify-center rounded-full border border-emerald-300/20 bg-emerald-500 px-1.5 text-[11px] font-bold leading-none text-slate-950 shadow-lg shadow-emerald-500/30">{{ unreadNotificationsCount > 99 ? '99+' : unreadNotificationsCount }}</span>
                                {% endif %}
                            </a>

                            {% if not is_granted('ROLE_ADMIN') %}
                                {% if is_granted('ROLE_RECRUITER') %}
                                    <a href="{{ path('app_recruiter_favorites') }}" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-white/10 hover:shadow-emerald-500/20 active:scale-95" aria-label="Acceder aux favoris">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m12 20.25-.32-.17C9.24 18.8 3 15.37 3 9.75A4.5 4.5 0 0 1 7.5 5.25c1.74 0 3.16.81 4.5 2.09 1.34-1.28 2.76-2.09 4.5-2.09A4.5 4.5 0 0 1 21 9.75c0 5.62-6.24 9.05-8.68 10.33L12 20.25Z" />
                                        </svg>
                                    </a>
                                {% endif %}

                                {% if is_granted('ROLE_APPLICANT') or is_granted('ROLE_RECRUITER') %}
                                    {% include '_chat_entry_point.html.twig' with {
                                        user: app.user,
                                        unreadCount: chat_unread_count(app.user)
                                    } only %}
                                {% endif %}
                            {% endif %}

                            <a href="{{ logout_path() }}" class="inline-flex items-center justify-center rounded-full border border-red-500/20 bg-red-500/10 px-4 py-2 text-[15px] font-semibold tracking-tight text-red-400 shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-red-500 hover:text-white active:scale-95">
                                Déconnexion
                            </a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[15px] font-semibold tracking-tight text-white shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-white/10 hover:shadow-emerald-500/20 active:scale-95">
                                Connexion
                            </a>
                        {% endif %}
                    </div>
                </nav>
            </header>

            <div class="pointer-events-none fixed inset-x-0 top-6 z-50">
                <div class="mx-auto w-full max-w-7xl px-3 sm:px-4 lg:px-5">
                    <div data-notification-stack="true" class="ml-auto flex w-full max-w-sm flex-col gap-3">
                        {% for message in app.flashes('success') %}
                            <div data-notification-autodismiss="true" data-notification-duration="4000" class="pointer-events-auto rounded-2xl border border-emerald-500/20 bg-emerald-500/10 px-5 py-3.5 text-[15px] font-medium text-emerald-300 shadow-xl backdrop-blur-md transition-all duration-300 ease-out">
                                <div class="flex items-start justify-between gap-4">
                                    <p class="leading-relaxed">{{ message }}</p>
                                    <button type="button" data-notification-close="true" aria-label="Fermer la notification" class="shrink-0 text-emerald-200/90 transition hover:text-emerald-100">×</button>
                                </div>
                            </div>
                        {% endfor %}

                        {% for message in app.flashes('info') %}
                            <div data-notification-autodismiss="true" data-notification-duration="4000" class="pointer-events-auto rounded-2xl border border-yellow-400/20 bg-yellow-400/10 px-5 py-3.5 text-[15px] font-medium text-yellow-300 shadow-xl backdrop-blur-md transition-all duration-300 ease-out">
                                <div class="flex items-start justify-between gap-4">
                                    <p class="leading-relaxed">{{ message }}</p>
                                    <button type="button" data-notification-close="true" aria-label="Fermer la notification" class="shrink-0 text-yellow-200/90 transition hover:text-yellow-100">×</button>
                                </div>
                            </div>
                        {% endfor %}

                        {% for message in app.flashes('verify_email_error') %}
                            <div data-notification-autodismiss="true" data-notification-duration="4000" class="pointer-events-auto rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-3.5 text-[15px] font-medium text-red-300 shadow-xl backdrop-blur-md transition-all duration-300 ease-out">
                                <div class="flex items-start justify-between gap-4">
                                    <p class="leading-relaxed">{{ message }}</p>
                                    <button type="button" data-notification-close="true" aria-label="Fermer la notification" class="shrink-0 text-red-200/90 transition hover:text-red-100">×</button>
                                </div>
                            </div>
                        {% endfor %}

                        {% for message in app.flashes('error') %}
                            <div data-notification-autodismiss="true" data-notification-duration="4000" class="pointer-events-auto rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-3.5 text-[15px] font-medium text-red-300 shadow-xl backdrop-blur-md transition-all duration-300 ease-out">
                                <div class="flex items-start justify-between gap-4">
                                    <p class="leading-relaxed">{{ message }}</p>
                                    <button type="button" data-notification-close="true" aria-label="Fermer la notification" class="shrink-0 text-red-200/90 transition hover:text-red-100">×</button>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# MAIN avec apple-slide-up-delay-1 #}
            <main class="apple-slide-up-delay-1 relative z-10 mx-auto flex min-h-[calc(100vh-84px)] w-full max-w-7xl items-center justify-center px-3 pb-12 pt-8 sm:px-4 lg:px-5">
                {% block body %}{% endblock %}
            </main>
            
        </div>
    </body>
</html>
