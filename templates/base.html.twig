        <script>
            (() => {
                const initChatEntryPointPolling = () => {
                    document.querySelectorAll('[data-chat-entry-point-poll="true"]').forEach((root) => {
                        if (root.dataset.chatEntryPointPollInitialized === 'true') {
                            return;
                        }

                        const pollUrl = root.dataset.chatEntryPointPollUrl;
                        if (!pollUrl) {
                            return;
                        }

                        root.dataset.chatEntryPointPollInitialized = 'true';

                        let polling = false;
                        let previousHtml = root.innerHTML;

                        const poll = async () => {
                            if (polling) {
                                return;
                            }

                            polling = true;
                            try {
                                const response = await fetch(pollUrl, {
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest',
                                        'Accept': 'application/json',
                                    },
                                    credentials: 'same-origin',
                                });

                                const payload = await response.json().catch(() => null);
                                if (!response.ok || !payload || !payload.ok || typeof payload.html !== 'string') {
                                    return;
                                }

                                if (payload.html !== previousHtml) {
                                    root.innerHTML = payload.html;
                                    previousHtml = payload.html;
                                }
                            } catch (_error) {
                            } finally {
                                polling = false;
                            }
                        };

                        poll();

                        const pollTimer = window.setInterval(poll, 2000);
                        const stopPolling = () => {
                            window.clearInterval(pollTimer);
                            delete root.dataset.chatEntryPointPollInitialized;
                        };

                        window.addEventListener('beforeunload', stopPolling, {once: true});
                        document.addEventListener('turbo:before-cache', stopPolling, {once: true});
                    });
                };

                document.addEventListener('DOMContentLoaded', initChatEntryPointPolling);
                document.addEventListener('turbo:load', initChatEntryPointPolling);
            })();
        </script>
