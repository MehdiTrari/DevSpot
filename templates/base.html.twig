<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="turbo-cache-control" content="no-preview">
        <title>{% block title %}DevSpot{% endblock %}</title>
        <script>
            (() => {
                if (window.DevSpotTheme) {
                    return;
                }

                const storageKey = 'devspot-theme';
                const defaultTheme = 'light';
                const themeLabels = {
                    light: 'Mode jour',
                    dark: 'Mode nuit',
                };

                const isThemeValue = (value) => value === 'light' || value === 'dark';

                const readStoredTheme = () => {
                    try {
                        const storedTheme = window.localStorage.getItem(storageKey);

                        return isThemeValue(storedTheme) ? storedTheme : defaultTheme;
                    } catch (_error) {
                        return defaultTheme;
                    }
                };

                const getCurrentTheme = () => {
                    const currentTheme = document.documentElement.dataset.theme;

                    return isThemeValue(currentTheme) ? currentTheme : readStoredTheme();
                };

                const refreshThemeControls = (theme) => {
                    document.querySelectorAll('[data-theme-label="true"]').forEach((element) => {
                        element.textContent = themeLabels[theme] ?? themeLabels[defaultTheme];
                    });

                    document.querySelectorAll('[data-theme-choice]').forEach((button) => {
                        const isActive = button.dataset.themeChoice === theme;

                        button.classList.toggle('is-active', isActive);
                        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                    });

                };

                const applyTheme = (theme) => {
                    const resolvedTheme = isThemeValue(theme) ? theme : defaultTheme;

                    document.documentElement.dataset.theme = resolvedTheme;
                    document.documentElement.style.colorScheme = resolvedTheme;

                    if (document.body) {
                        document.body.dataset.theme = resolvedTheme;
                    }

                    refreshThemeControls(resolvedTheme);

                    return resolvedTheme;
                };

                const setTheme = (theme, {persist = true} = {}) => {
                    const resolvedTheme = applyTheme(theme);

                    if (persist) {
                        try {
                            window.localStorage.setItem(storageKey, resolvedTheme);
                        } catch (_error) {
                        }
                    }

                    return resolvedTheme;
                };

                const initThemeControls = () => {
                    applyTheme(getCurrentTheme());
                };

                document.addEventListener('click', (event) => {
                    if (!(event.target instanceof Element)) {
                        return;
                    }

                    const themeChoiceButton = event.target.closest('[data-theme-choice]');
                    if (themeChoiceButton) {
                        event.preventDefault();
                        const theme = themeChoiceButton.dataset.themeChoice;
                        if (isThemeValue(theme)) {
                            setTheme(theme);
                        }

                        return;
                    }
                });

                document.addEventListener('DOMContentLoaded', initThemeControls);
                document.addEventListener('turbo:load', initThemeControls);

                window.DevSpotTheme = {
                    applyTheme,
                    getCurrentTheme,
                    refreshThemeControls,
                    setTheme,
                };

                applyTheme(readStoredTheme());
            })();
        </script>
        
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2228%22 fill=%22%23f8fafc%22/><path d=%22M48 36L22 64l26 28%22 stroke=%22%232563eb%22 stroke-width=%229%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22 fill=%22none%22/><path d=%22M80 36l26 28-26 28%22 stroke=%22%232563eb%22 stroke-width=%229%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22 fill=%22none%22/><line x1=%2270%22 y1=%2228%22 x2=%2258%22 y2=%22100%22 stroke=%22%233b82f6%22 stroke-width=%227%22 stroke-linecap=%22round%22 opacity=%22.6%22/></svg>">
        
        {% block stylesheets %}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
            <link rel="stylesheet" href="{{ asset('styles/base-theme.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% if app.environment != 'test' %}
                {% block importmap %}{{ importmap('app') }}{% endblock %}
            {% endif %}
            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
            <script src="https://npmcdn.com/flatpickr/dist/l10n/fr.js"></script>
            <script>
                const initUiBehaviors = () => {
                    const notificationStack = document.querySelector('[data-notification-stack="true"]');

                    const buildNotificationElement = (message, type = 'info') => {
                        const styles = {
                            success: 'ui-notification-success u-border-success u-bg-success u-text-success',
                            info: 'ui-notification-info u-border-info u-bg-info u-text-info',
                            error: 'border-red-500/20 bg-red-500/10 text-red-300',
                        };

                        const closeStyles = {
                            success: 'u-text-success-muted',
                            info: 'u-text-info-muted',
                            error: 'text-red-200/90 hover:text-red-100',
                        };

                        const element = document.createElement('div');
                        const styleKey = styles[type] ? type : 'info';
                        element.setAttribute('data-notification-autodismiss', 'true');
                        element.setAttribute('data-notification-duration', '4000');
                        element.className = `pointer-events-auto rounded-2xl border px-5 py-3.5 text-[15px] font-medium shadow-xl backdrop-blur-md transition-all duration-300 ease-out ${styles[styleKey]}`;
                        element.innerHTML = `
                            <div class="flex items-start justify-between gap-4">
                                <p class="leading-relaxed"></p>
                                <button type="button" data-notification-close="true" aria-label="Fermer la notification" class="shrink-0 transition ${closeStyles[styleKey]}">×</button>
                            </div>
                        `;
                        element.querySelector('p').textContent = message;

                        return element;
                    };

                    const pushNotification = (message, type = 'info') => {
                        if (!notificationStack) {
                            return;
                        }

                        notificationStack.prepend(buildNotificationElement(message, type));
                        initUiBehaviors();
                    };

                    flatpickr(".js-datepicker", {
                        locale: "fr",
                        dateFormat: "Y-m-d",
                        altInput: true,
                        altFormat: "d/m/Y",
                        allowInput: true,
                        disableMobile: "true",
                    });

                    const flashElements = document.querySelectorAll('[data-notification-autodismiss="true"]');

                    flashElements.forEach((flashElement) => {
                        if (flashElement.dataset.notificationInitialized === 'true') {
                            return;
                        }
                        flashElement.dataset.notificationInitialized = 'true';

                        let dismissed = false;
                        const duration = Number.parseInt(flashElement.dataset.notificationDuration ?? '4000', 10);

                        const dismiss = () => {
                            if (dismissed) {
                                return;
                            }

                            dismissed = true;
                            flashElement.style.pointerEvents = 'none';
                            flashElement.style.overflow = 'hidden';

                            const computedStyle = window.getComputedStyle(flashElement);
                            const currentHeight = flashElement.offsetHeight;

                            flashElement.style.maxHeight = `${currentHeight}px`;
                            flashElement.style.marginTop = computedStyle.marginTop;
                            flashElement.style.marginBottom = computedStyle.marginBottom;
                            flashElement.style.paddingTop = computedStyle.paddingTop;
                            flashElement.style.paddingBottom = computedStyle.paddingBottom;
                            flashElement.style.borderTopWidth = computedStyle.borderTopWidth;
                            flashElement.style.borderBottomWidth = computedStyle.borderBottomWidth;
                            flashElement.style.transition = 'max-height 420ms cubic-bezier(0.16, 1, 0.3, 1), margin 420ms cubic-bezier(0.16, 1, 0.3, 1), padding 420ms cubic-bezier(0.16, 1, 0.3, 1), border-width 420ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms ease, transform 300ms ease';

                            requestAnimationFrame(() => {
                                requestAnimationFrame(() => {
                                    flashElement.style.opacity = '0';
                                    flashElement.style.transform = 'translateY(6px)';
                                    flashElement.style.maxHeight = '0px';
                                    flashElement.style.marginTop = '0px';
                                    flashElement.style.marginBottom = '0px';
                                    flashElement.style.paddingTop = '0px';
                                    flashElement.style.paddingBottom = '0px';
                                    flashElement.style.borderTopWidth = '0px';
                                    flashElement.style.borderBottomWidth = '0px';
                                });
                            });

                            flashElement.setAttribute('aria-hidden', 'true');
                        };

                        const closeButton = flashElement.querySelector('[data-notification-close="true"]');
                        if (closeButton) {
                            closeButton.addEventListener('click', dismiss);
                        }

                        window.setTimeout(dismiss, Number.isNaN(duration) ? 4000 : duration);
                    });

                    const outlinedHeartIcon = `
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m12 20.25-.32-.17C9.24 18.8 3 15.37 3 9.75A4.5 4.5 0 0 1 7.5 5.25c1.74 0 3.16.81 4.5 2.09 1.34-1.28 2.76-2.09 4.5-2.09A4.5 4.5 0 0 1 21 9.75c0 5.62-6.24 9.05-8.68 10.33L12 20.25Z" />
                        </svg>
                    `.trim();

                    const filledHeartIcon = `
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                            <path d="M11.645 20.91a.75.75 0 0 0 .71 0c1.055-.518 9.145-4.707 9.145-11.41A5.25 5.25 0 0 0 12 6.084 5.25 5.25 0 0 0 2.5 9.5c0 6.703 8.09 10.892 9.145 11.41Z" />
                        </svg>
                    `.trim();

                    const selectorEscape = (value) => {
                        if (window.CSS && typeof window.CSS.escape === 'function') {
                            return window.CSS.escape(String(value));
                        }

                        return String(value);
                    };

                    const getFavoriteForms = (profileId) => document.querySelectorAll(
                        `[data-favorite-toggle="true"][data-favorite-profile-id="${selectorEscape(profileId)}"]`
                    );

                    const setFavoriteFormLoading = (formElement, isLoading) => {
                        const button = formElement.querySelector('[data-favorite-button="true"]');
                        if (!button) {
                            return;
                        }

                        if (isLoading) {
                            button.setAttribute('disabled', 'disabled');
                            button.classList.add('opacity-70', 'cursor-not-allowed');
                            return;
                        }

                        button.removeAttribute('disabled');
                        button.classList.remove('opacity-70', 'cursor-not-allowed');
                    };

                    const updateFavoriteButtonState = (formElement, isFavorite) => {
                        const button = formElement.querySelector('[data-favorite-button="true"]');
                        const tokenInput = formElement.querySelector('[data-favorite-token="true"]');

                        if (!button || !tokenInput) {
                            return;
                        }

                        const content = formElement.querySelector('[data-favorite-content="true"]');

                        const label = isFavorite
                            ? (formElement.dataset.favoriteRemoveLabel ?? 'Retirer des favoris')
                            : (formElement.dataset.favoriteAddLabel ?? 'Ajouter aux favoris');

                        formElement.action = isFavorite
                            ? (formElement.dataset.favoriteRemoveUrl ?? formElement.action)
                            : (formElement.dataset.favoriteAddUrl ?? formElement.action);
                        tokenInput.value = isFavorite
                            ? (formElement.dataset.favoriteRemoveToken ?? tokenInput.value)
                            : (formElement.dataset.favoriteAddToken ?? tokenInput.value);
                        button.dataset.favoriteAction = isFavorite ? 'remove' : 'add';
                        button.className = isFavorite
                            ? (formElement.dataset.favoriteRemoveButtonClass ?? button.className)
                            : (formElement.dataset.favoriteAddButtonClass ?? button.className);
                        button.setAttribute('aria-label', label);
                        button.setAttribute('title', label);

                        if (formElement.dataset.favoriteIconOnly === '1') {
                            button.innerHTML = isFavorite ? filledHeartIcon : outlinedHeartIcon;
                        } else {
                            if (content) {
                                content.textContent = label;
                            } else {
                                button.textContent = label;
                            }
                        }
                    };

                    const updateFavoriteCount = (favoriteCount) => {
                        if (!Number.isFinite(favoriteCount)) {
                            return;
                        }

                        document.querySelectorAll('[data-favorite-count-value="true"]').forEach((element) => {
                            element.textContent = String(favoriteCount);
                        });
                    };

                    const refreshFavoriteListState = () => {
                        const list = document.querySelector('[data-favorite-list="true"]');
                        if (!list) {
                            return;
                        }

                        const emptyState = list.querySelector('[data-favorite-empty-state="true"]');
                        if (!emptyState) {
                            return;
                        }

                        const hasEntries = list.querySelectorAll('[data-favorite-entry="true"]').length > 0;
                        emptyState.classList.toggle('hidden', hasEntries);
                    };

                    const syncFavoriteForms = (profileId, isFavorite) => {
                        getFavoriteForms(profileId).forEach((formElement) => {
                            if (!isFavorite && formElement.dataset.favoriteRemoveCardOnRemove === '1') {
                                const entry = formElement.closest('[data-favorite-entry="true"]');
                                if (entry) {
                                    entry.remove();
                                    return;
                                }
                            }

                            updateFavoriteButtonState(formElement, isFavorite);
                        });

                        refreshFavoriteListState();
                    };

                    const favoriteForms = document.querySelectorAll('[data-favorite-toggle="true"]');

                    favoriteForms.forEach((formElement) => {
                        if (formElement.dataset.favoriteInitialized === 'true') {
                            return;
                        }
                        formElement.dataset.favoriteInitialized = 'true';

                        const initialIsFavorite = formElement.querySelector('[data-favorite-button="true"]')?.dataset.favoriteAction === 'remove';
                        updateFavoriteButtonState(formElement, initialIsFavorite);

                        formElement.addEventListener('submit', async (event) => {
                            event.preventDefault();

                            const profileId = formElement.dataset.favoriteProfileId;
                            if (!profileId) {
                                formElement.submit();
                                return;
                            }

                            const relatedForms = Array.from(getFavoriteForms(profileId));
                            relatedForms.forEach((relatedForm) => setFavoriteFormLoading(relatedForm, true));

                            try {
                                const response = await fetch(formElement.action, {
                                    method: 'POST',
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest',
                                        'Accept': 'application/json',
                                    },
                                    body: new FormData(formElement),
                                    credentials: 'same-origin',
                                });

                                const payload = await response.json().catch(() => ({}));

                                if (!response.ok || !payload.success) {
                                    pushNotification(payload?.message ?? 'Action impossible, merci de reessayer.', payload?.type ?? 'error');
                                    return;
                                }

                                syncFavoriteForms(profileId, payload.isFavorite === true);

                                const favoriteCount = Number.parseInt(String(payload.favoriteCount ?? ''), 10);
                                if (!Number.isNaN(favoriteCount)) {
                                    updateFavoriteCount(favoriteCount);
                                }

                                pushNotification(payload.message ?? 'Favoris mis a jour.', payload.type ?? 'success');
                            } catch (_error) {
                                pushNotification('Erreur reseau, merci de reessayer.', 'error');
                            } finally {
                                relatedForms.forEach((relatedForm) => setFavoriteFormLoading(relatedForm, false));
                            }
                        });
                    });

                    const visibilityForms = document.querySelectorAll('[data-visibility-toggle="true"]');

                    visibilityForms.forEach((formElement) => {
                        if (formElement.dataset.visibilityInitialized === 'true') {
                            return;
                        }
                        formElement.dataset.visibilityInitialized = 'true';

                        formElement.addEventListener('submit', async (event) => {
                            event.preventDefault();

                            const submitButton = formElement.querySelector('[data-visibility-button="true"]');
                            const hiddenVisibilityInput = formElement.querySelector('[data-visibility-value="true"]');
                            const badge = formElement.parentElement?.querySelector('[data-visibility-badge="true"]');

                            if (!submitButton || !hiddenVisibilityInput || !badge) {
                                formElement.submit();
                                return;
                            }

                            submitButton.setAttribute('disabled', 'disabled');
                            submitButton.classList.add('opacity-70', 'cursor-not-allowed');

                            try {
                                const response = await fetch(formElement.action, {
                                    method: 'POST',
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest',
                                        'Accept': 'application/json',
                                    },
                                    body: new FormData(formElement),
                                    credentials: 'same-origin',
                                });

                                const payload = await response.json();

                                if (!response.ok || !payload.success) {
                                    const errorMessage = payload?.message ?? 'Action impossible, merci de réessayer.';
                                    if (notificationStack) {
                                        notificationStack.prepend(buildNotificationElement(errorMessage, payload?.type ?? 'error'));
                                        initUiBehaviors();
                                    }
                                    return;
                                }

                                const isPublic = payload.isPublic === true;
                                badge.textContent = isPublic ? 'Public' : 'Privé';
                                badge.classList.remove('u-border-pale-green', 'u-bg-pale-green', 'u-text-pale-green', 'u-border-pale-red', 'u-bg-pale-red', 'u-text-pale-red');
                                if (isPublic) {
                                    badge.classList.add('u-border-pale-green', 'u-bg-pale-green', 'u-text-pale-green');
                                } else {
                                    badge.classList.add('u-border-pale-red', 'u-bg-pale-red', 'u-text-pale-red');
                                }

                                hiddenVisibilityInput.value = isPublic ? '0' : '1';
                                submitButton.textContent = isPublic ? 'Passer en privé' : 'Passer en public';

                                if (notificationStack) {
                                    notificationStack.prepend(buildNotificationElement(payload.message ?? 'Visibilité mise à jour.', payload.type ?? 'success'));
                                    initUiBehaviors();
                                }
                            } catch (_error) {
                                if (notificationStack) {
                                    notificationStack.prepend(buildNotificationElement('Erreur réseau, merci de réessayer.', 'error'));
                                    initUiBehaviors();
                                }
                            } finally {
                                submitButton.removeAttribute('disabled');
                                submitButton.classList.remove('opacity-70', 'cursor-not-allowed');
                            }
                        });
                    });

                    const cardLinks = document.querySelectorAll('[data-card-clickable="true"][data-card-href]');

                    cardLinks.forEach((cardElement) => {
                        if (cardElement.dataset.cardLinkInitialized === 'true') {
                            return;
                        }
                        cardElement.dataset.cardLinkInitialized = 'true';

                        const goToCardHref = () => {
                            const targetHref = cardElement.dataset.cardHref;
                            if (!targetHref) {
                                return;
                            }
                            window.location.href = targetHref;
                        };

                        cardElement.addEventListener('click', (event) => {
                            const eventTarget = event.target;
                            if (eventTarget instanceof Element && eventTarget.closest('a, button, input, textarea, select, label, form, [data-card-ignore="true"]')) {
                                return;
                            }
                            goToCardHref();
                        });

                        cardElement.addEventListener('keydown', (event) => {
                            if (event.key !== 'Enter' && event.key !== ' ') {
                                return;
                            }
                            event.preventDefault();
                            goToCardHref();
                        });
                    });

                    const profileMenus = document.querySelectorAll('[data-profile-menu="true"]');

                    profileMenus.forEach((menuElement) => {
                        if (menuElement.dataset.profileMenuInitialized === 'true') {
                            return;
                        }
                        menuElement.dataset.profileMenuInitialized = 'true';

                        let closeTimeoutId;
                        const closeDelayMs = 220;

                        const openMenu = () => {
                            window.clearTimeout(closeTimeoutId);
                            menuElement.setAttribute('open', 'open');
                        };

                        const closeMenu = () => {
                            window.clearTimeout(closeTimeoutId);
                            menuElement.removeAttribute('open');
                        };

                        const scheduleCloseMenu = (delay = closeDelayMs) => {
                            window.clearTimeout(closeTimeoutId);
                            closeTimeoutId = window.setTimeout(closeMenu, delay);
                        };

                        menuElement.addEventListener('mouseenter', openMenu);
                        menuElement.addEventListener('mouseleave', () => scheduleCloseMenu());

                        menuElement.addEventListener('focusin', openMenu);
                        menuElement.addEventListener('focusout', (event) => {
                            const nextFocusedElement = event.relatedTarget;

                            if (nextFocusedElement instanceof Node && menuElement.contains(nextFocusedElement)) {
                                return;
                            }

                            scheduleCloseMenu(0);
                        });
                    });
                };

                document.addEventListener('DOMContentLoaded', initUiBehaviors);
                document.addEventListener('turbo:load', initUiBehaviors);
            </script>
        {% endblock %}
    </head>
    
    {# Theme global blanc/bleu #}
    <body
        class="indeed-theme min-h-screen font-sans antialiased selection:bg-blue-600 selection:text-white"
        {% if app.user and mercureTopics is defined and mercureTopics is not empty %}
            data-global-mercure-url="{{ mercure(mercureTopics, (mercureNeedsCredentials|default(false)) ? {subscribe: mercureTopics} : {}) }}"
            data-global-mercure-credentials="{{ (mercureNeedsCredentials|default(false)) ? 'true' : 'false' }}"
        {% endif %}
    >
        <div class="site-page-shell relative min-h-screen overflow-hidden">
            
            {# Les blobs avec la classe apple-fade (Opacité et taille augmentées pour bien ressortir) #}
            <div class="site-background-blob site-background-blob-1 apple-fade pointer-events-none absolute -top-32 -left-20 h-[500px] w-[500px]"></div>
            <div class="site-background-blob site-background-blob-2 apple-fade pointer-events-none absolute -right-32 top-1/4 h-[500px] w-[500px]" style="animation-delay: 0.2s;"></div>
            <div class="site-background-blob site-background-blob-3 apple-fade pointer-events-none absolute bottom-0 left-1/4 h-[600px] w-[600px]" style="animation-delay: 0.4s;"></div>

            {% set currentRoute = app.request.attributes.get('_route')|default('') %}
            {% set dashboardPath = null %}
            {% set messagesPath = null %}
            {% set chatUnreadCount = 0 %}
            {% set unreadNotificationsCount = 0 %}
            {% set profilePath = path('app_home') %}
            {% if app.user %}
                {% set unreadNotificationsCount = unread_notifications_count(app.user) %}
                {% if is_granted('ROLE_ADMIN') %}
                    {% set dashboardPath = path('app_admin_dashboard') %}
                    {% set profilePath = path('app_admin_dashboard') %}
                {% elseif is_granted('ROLE_APPLICANT') %}
                    {% set dashboardPath = path('app_applicant_home') %}
                    {% set profilePath = path('app_applicant_home') %}
                    {% if app.user.developerProfile is not null and app.user.developerProfile.portfolioGeneratedAt is not null %}
                        {% set messagesPath = path('app_applicant_messages') %}
                        {% set chatUnreadCount = chat_unread_count(app.user) %}
                    {% endif %}
                {% elseif is_granted('ROLE_RECRUITER') %}
                    {% set dashboardPath = path('app_recruiter_home') %}
                    {% set profilePath = path('app_recruiter_home') %}
                    {% set messagesPath = path('app_recruiter_messages') %}
                    {% set chatUnreadCount = chat_unread_count(app.user) %}
                {% endif %}
            {% endif %}
            {% set isHomeRoute = currentRoute == 'app_home' %}
            {% set isDashboardRoute = currentRoute in ['app_admin_dashboard', 'app_applicant_home', 'app_recruiter_home'] %}
            {% set isNotificationsRoute = currentRoute starts with 'app_notifications' %}
            {% set isFavoritesRoute = currentRoute == 'app_recruiter_favorites' or currentRoute starts with 'app_recruiter_favorite_' %}
            {% set isRecruiterOffersRoute = currentRoute == 'app_recruiter_offers' or currentRoute starts with 'app_recruiter_offer_' %}
            {% set isAdminWideRoute = currentRoute in ['app_admin_profiles', 'app_admin_companies', 'app_admin_users', 'app_admin_messages'] %}
            {% set isMessagesRoute = currentRoute in ['app_applicant_messages', 'app_applicant_message_show', 'app_recruiter_messages', 'app_recruiter_message_show'] %}
            {% set isHelpRoute = currentRoute == 'app_help' %}
            {% set helpPath = path('app_help') %}

            {# HEADER stable (sans animation) #}
            <header class="relative z-[70]">
                <div class="mx-auto w-full max-w-[84rem] px-3 pt-3 sm:px-4 lg:px-5">
                    <nav class="site-header-shell {{ isFavoritesRoute ? 'site-header-shell-favorites' : '' }} rounded-[2rem] px-3.5 py-1.5 sm:px-4.5 sm:py-2">
                        <div class="site-header-layout">
                        <div class="site-header-left">
                            <a href="{{ path('app_home') }}" class="site-header-brand" aria-label="Aller a l'accueil de DevSpot">
                                <span class="site-header-brand-mark">
                                    <svg class="h-5 w-5" viewBox="0 0 128 128" fill="none" aria-hidden="true">
                                        <path d="M48 36L22 64l26 28" stroke="#2557d6" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M80 36l26 28-26 28" stroke="#2557d6" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="70" y1="28" x2="58" y2="100" stroke="#4f83ff" stroke-width="9" stroke-linecap="round" opacity=".6"/>
                                    </svg>
                                </span>
                            </a>

                            <div class="site-header-nav site-header-nav-desktop" aria-label="Navigation principale">
                                {% if app.user and not is_granted('ROLE_ADMIN') and (is_granted('ROLE_RECRUITER') or is_granted('ROLE_APPLICANT')) %}
                                    <a href="{{ path('app_home') }}" class="site-header-link {{ isHomeRoute ? 'site-header-link-active' : '' }}" {% if isHomeRoute %}aria-current="page"{% endif %}>
                                        Accueil
                                    </a>
                                {% endif %}
                                {% if dashboardPath %}
