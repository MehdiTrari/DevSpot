<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}Erreur | DevSpot{% endblock %}</title>
        <script>
            (() => {
                const storageKey = 'devspot-theme';
                const defaultTheme = 'light';
                let theme = defaultTheme;

                try {
                    const storedTheme = window.localStorage.getItem(storageKey);
                    if (storedTheme === 'light' || storedTheme === 'dark') {
                        theme = storedTheme;
                    }
                } catch (_error) {
                }

                document.documentElement.dataset.theme = theme;
                document.documentElement.style.colorScheme = theme;
            })();
        </script>
        <link rel="stylesheet" href="{{ asset('styles/base-theme.css') }}">
        <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: "Nunito Sans", "Segoe UI", sans-serif;
                background:
                    radial-gradient(circle at 12% 10%, var(--page-blob-1), transparent 46%),
                    radial-gradient(circle at 88% 18%, var(--page-blob-2), transparent 42%),
                    linear-gradient(180deg, var(--indeed-bg-start) 0%, var(--indeed-bg-end) 100%);
                color: var(--indeed-ink);
                display: grid;
                place-items: center;
                padding: 24px;
            }

            .error-card {
                width: min(720px, 100%);
                border: 1px solid var(--ui-shell-border);
                border-radius: 28px;
                background: var(--premium-card-strong-bg);
                backdrop-filter: blur(18px);
                -webkit-backdrop-filter: blur(18px);
                box-shadow: 0 24px 52px rgba(var(--indeed-shadow-rgb), 0.14);
                padding: 34px;
            }

            .error-badge {
                display: inline-block;
                margin-bottom: 14px;
                border: 1px solid var(--ui-info-border);
                color: var(--ui-info-text);
                background: var(--ui-info-bg);
                border-radius: 999px;
                padding: 6px 12px;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            h1 {
                margin: 0;
                font-size: clamp(2rem, 3vw, 2.7rem);
                line-height: 1.1;
                color: var(--ui-heading);
            }

            p {
                margin: 14px 0 0;
                color: var(--ui-text-secondary);
                line-height: 1.6;
            }

            .actions {
                margin-top: 24px;
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
            }

            a {
                text-decoration: none;
                border-radius: 999px;
                padding: 11px 16px;
                font-weight: 700;
                font-size: 14px;
                transition: transform 0.2s ease, filter 0.2s ease;
            }

            a:hover {
                transform: translateY(-1px);
                filter: brightness(0.98);
            }

            :root[data-theme="dark"] a:hover {
                filter: brightness(1.08);
            }

            .primary {
                border: 1px solid transparent;
                background: var(--ui-button-primary-bg);
                color: var(--ui-button-primary-text);
            }

            .ghost {
                border: 1px solid var(--ui-button-secondary-border);
                background: var(--ui-button-secondary-bg);
                color: var(--ui-button-secondary-text);
            }
        </style>
    </head>
    <body>
        <main class="error-card">
            <span class="error-badge">{% block badge %}Erreur{% endblock %}</span>
            <h1>{% block heading %}{% endblock %}</h1>
            <p>{% block copy %}{% endblock %}</p>
            <div class="actions">
                <a class="primary" href="{{ path('app_home') }}">Retour à l'accueil</a>
                <a class="ghost" href="javascript:history.back()">Page précédente</a>
            </div>
        </main>
    </body>
</html>
