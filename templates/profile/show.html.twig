{% extends 'base.html.twig' %}

{% block title %}{{ profile.firstName }} {{ profile.lastName }} | Portfolio{% endblock %}

{% block body %}
    {% set locationTypeLabels = {
        'remote': 'Remote',
        'hybrid': 'Hybride',
        'onsite': 'Sur site'
    } %}
    {% set experienceLevelLabels = {
        'intern': 'Stagiaire',
        'junior': 'Junior',
        'mid': 'Intermédiaire',
        'senior': 'Senior',
        'lead': 'Lead'
    } %}
    {% set skillLevelLabels = {
        'beginner': 'Débutant',
        'intermediate': 'Intermédiaire',
        'advanced': 'Avancé',
        'expert': 'Expert'
    } %}

    <section class="w-full max-w-5xl space-y-6 font-sans">
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/60 p-7 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex items-start gap-4 sm:gap-5">
                    {% if profile.avatarPath %}
                        <img src="{{ asset(profile.avatarPath) }}" alt="Avatar de {{ profile.firstName }} {{ profile.lastName }}" class="h-16 w-16 rounded-2xl border border-white/15 object-cover sm:h-20 sm:w-20">
                    {% else %}
                        <div class="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/15 bg-white/5 text-lg font-semibold text-white sm:h-20 sm:w-20 sm:text-xl">
                            {{ (profile.firstName|default('P'))|slice(0, 1)|upper }}{{ (profile.lastName|default(''))|slice(0, 1)|upper }}
                        </div>
                    {% endif %}

                    <div>
                        <p class="mb-2 inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-300">
                            Portfolio public
                        </p>
                        <h1 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">{{ profile.firstName }} {{ profile.lastName }}</h1>
                        <p class="mt-2 text-[15px] font-medium text-slate-300">{{ profile.headline ?: 'Headline non renseignée' }}</p>
                        <p class="mt-2 text-sm text-slate-400">
                            {{ profile.city ?: 'Ville non renseignée' }}, {{ profile.country ?: 'Pays non renseigné' }}
                            {% if profile.locationType %}
                                · {{ locationTypeLabels[profile.locationType.value] ?? profile.locationType.value }}
                            {% endif %}
                        </p>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2 sm:max-w-[220px] sm:justify-end">
                    <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-300">
                        {{ experienceLevelLabels[profile.experienceLevel.value|default('')] ?? 'Niveau non renseigné' }}
                    </span>
                    {% if profile.yearsExperience is not null %}
                        <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-300">
                            {{ profile.yearsExperience }} an{{ profile.yearsExperience > 1 ? 's' : '' }} d'expérience
                        </span>
                    {% endif %}
                    {% if isOwner and not profile.public %}
                        <span class="inline-flex items-center rounded-full border border-yellow-400/25 bg-yellow-400/10 px-3 py-1 text-xs font-semibold text-yellow-300">
                            Profil privé (visible par toi)
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="grid gap-6 lg:grid-cols-[1.25fr_0.75fr]">
            <div class="space-y-6">
                <article class="rounded-[2rem] border border-white/10 bg-slate-900/60 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-7">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Bio</h2>
                    <p class="mt-4 text-[15px] leading-relaxed text-slate-200 whitespace-pre-line">{{ profile.bio ?: 'Bio non renseignée.' }}</p>
                </article>

                <article class="rounded-[2rem] border border-white/10 bg-slate-900/60 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-7">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Expériences</h2>
                    {% if experiences is empty %}
                        <p class="mt-4 text-sm text-slate-400">Aucune expérience renseignée.</p>
                    {% else %}
                        <div class="mt-5 space-y-5">
                            {% for experience in experiences %}
                                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                                    <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
                                        <div>
                                            <h3 class="text-[15px] font-semibold text-white">{{ experience.title }}</h3>
                                            <p class="text-sm text-slate-400">{{ experience.companyName }}</p>
                                        </div>
                                        <p class="text-xs font-medium text-slate-400">
                                            {{ experience.startDate ? experience.startDate|date('m/Y') : 'N/A' }} -
                                            {{ experience.isCurrent ? 'Aujourd\'hui' : (experience.endDate ? experience.endDate|date('m/Y') : 'N/A') }}
                                        </p>
                                    </div>

                                    <p class="mt-3 text-sm leading-relaxed text-slate-300 whitespace-pre-line">{{ experience.description }}</p>

                                    {% if experience.technologies|length > 0 %}
                                        <div class="mt-3 flex flex-wrap gap-2">
                                            {% for technology in experience.technologies %}
                                                <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-300">{{ technology.name }}</span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </article>

                <article class="rounded-[2rem] border border-white/10 bg-slate-900/60 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-7">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Formations</h2>
                    {% if education is empty %}
                        <p class="mt-4 text-sm text-slate-400">Aucune formation renseignée.</p>
                    {% else %}
                        <div class="mt-5 space-y-4">
                            {% for item in education %}
                                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                                    <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
                                        <div>
                                            <h3 class="text-[15px] font-semibold text-white">{{ item.schoolName }}</h3>
                                            <p class="text-sm text-slate-400">
                                                {{ item.degree ?: 'Diplôme non renseigné' }}
                                                {% if item.field %} · {{ item.field }}{% endif %}
                                            </p>
                                        </div>
                                        <p class="text-xs font-medium text-slate-400">
                                            {{ item.startDate ? item.startDate|date('m/Y') : 'N/A' }} - {{ item.endDate ? item.endDate|date('m/Y') : 'N/A' }}
                                        </p>
                                    </div>
                                    {% if item.description %}
                                        <p class="mt-3 text-sm leading-relaxed text-slate-300 whitespace-pre-line">{{ item.description }}</p>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </article>
            </div>

            <aside class="space-y-6">
                <article class="rounded-[2rem] border border-white/10 bg-slate-900/60 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Compétences</h2>
                    {% if profile.profileSkills|length > 0 %}
                        <ul class="mt-5 space-y-2">
                            {% for profileSkill in profile.profileSkills %}
                                <li class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm">
                                    <span class="font-medium text-white">{{ profileSkill.skill.name }}</span>
                                    <span class="text-xs text-slate-400">
                                        {{ skillLevelLabels[profileSkill.level.value|default('')] ?? 'Niveau non renseigné' }}
                                        {% if profileSkill.years is not null %}
                                            · {{ profileSkill.years }} an{{ profileSkill.years > 1 ? 's' : '' }}
                                        {% endif %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="mt-4 text-sm text-slate-400">Aucune compétence renseignée.</p>
                    {% endif %}
                </article>

                <article class="rounded-[2rem] border border-white/10 bg-slate-900/60 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Technologies</h2>
                    {% if technologyNames is not empty %}
                        <div class="mt-5 flex flex-wrap gap-2">
                            {% for name in technologyNames %}
                                <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-300">{{ name }}</span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="mt-4 text-sm text-slate-400">Aucune technologie renseignée.</p>
                    {% endif %}
                </article>

                <article class="rounded-[2rem] border border-white/10 bg-slate-900/60 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Postes recherchés</h2>
                    {% if profile.desiredPositions|length > 0 %}
                        <div class="mt-5 flex flex-wrap gap-2">
                            {% for position in profile.desiredPositions %}
                                <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs font-semibold text-slate-200">{{ position.name }}</span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="mt-4 text-sm text-slate-400">Aucun poste renseigné.</p>
                    {% endif %}
                </article>

                <article class="rounded-[2rem] border border-white/10 bg-slate-900/60 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Liens</h2>
                    <ul class="mt-5 space-y-2 text-sm">
                        {% if profile.githubUrl %}
                            <li><a href="{{ profile.githubUrl }}" target="_blank" rel="noopener noreferrer" class="text-emerald-300 hover:text-emerald-200">GitHub</a></li>
                        {% endif %}
                        {% if profile.linkedinUrl %}
                            <li><a href="{{ profile.linkedinUrl }}" target="_blank" rel="noopener noreferrer" class="text-emerald-300 hover:text-emerald-200">LinkedIn</a></li>
                        {% endif %}
                        {% if profile.portfolioUrl %}
                            <li><a href="{{ profile.portfolioUrl }}" target="_blank" rel="noopener noreferrer" class="text-emerald-300 hover:text-emerald-200">Portfolio externe</a></li>
                        {% endif %}
                        {% if not profile.githubUrl and not profile.linkedinUrl and not profile.portfolioUrl %}
                            <li class="text-slate-400">Aucun lien renseigné.</li>
                        {% endif %}
                    </ul>
                </article>
            </aside>
        </div>
    </section>
{% endblock %}
