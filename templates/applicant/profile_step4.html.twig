{% extends 'base.html.twig' %}

{% block title %}Étape 4 | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-2xl rounded-3xl border border-violet-100 bg-white/95 p-6 shadow-xl shadow-violet-100/60 backdrop-blur sm:p-8">
        <div class="mb-6">
            <p class="mb-2 inline-flex items-center gap-2 rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-yellow-700"><span class="h-2 w-2 rounded-full bg-yellow-400"></span>Profil développeur</p>
            <h1 class="text-3xl font-semibold tracking-tight text-violet-900">Étape 4 - Postes recherchés</h1>
            <p class="mt-2 text-sm text-slate-500">Sélectionne les postes que tu recherches.</p>
        </div>

        {{ form_start(profileForm, {attr: {class: 'space-y-4'}}) }}
            {{ form_row(profileForm.desiredPositions, {
                label: 'Postes recherchés',
                attr: { class: 'block min-h-28 w-full rounded-xl border border-violet-200 bg-white px-4 py-3 text-sm text-slate-900' }
            }) }}

            <div class="flex items-center gap-3">
                <a href="{{ path('app_applicant_home') }}" class="inline-flex items-center justify-center rounded-xl border border-violet-200 bg-white px-4 py-3 text-sm font-semibold text-violet-700 transition hover:bg-violet-50">Retour dashboard</a>
                <button type="submit" class="flex-1 rounded-xl bg-violet-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-violet-700">Enregistrer l'étape 4</button>
            </div>
        {{ form_end(profileForm) }}
    </section>
{% endblock %}
