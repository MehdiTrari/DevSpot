{# Step progress indicator — include with { current_step: N, total_steps: 4 } only #}
{% set step_routes = {
    1: 'app_applicant_profile_step1',
    2: 'app_applicant_profile_step2',
    3: 'app_applicant_profile_step3',
    4: 'app_applicant_profile_step4'
} %}
<nav class="mb-8" aria-label="Progression du profil">
    <div class="flex items-center justify-center gap-1">
        {% for i in 1..total_steps %}
            <div class="flex items-center {% if not loop.last %}gap-1{% endif %}">
                {% if i < current_step %}
                    <a href="{{ path(step_routes[i]) }}"
                       title="Retour à l'étape {{ i }}"
                       class="flex h-10 w-10 items-center justify-center rounded-full border shadow-lg transition-all duration-300 hover:scale-110"
                       style="background: var(--ui-success-bg); border-color: var(--ui-success-border); color: var(--ui-success-text-muted); box-shadow: var(--ui-progress-glow);"
                    >
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    </a>
                {% elseif i == current_step %}
                    <div class="flex h-10 w-10 items-center justify-center rounded-full text-sm font-bold shadow-lg" style="background: var(--ui-success-bg); color: var(--ui-success-text); box-shadow: var(--ui-progress-glow);">
                        {{ i }}
                    </div>
                {% else %}
                    <div class="flex h-10 w-10 items-center justify-center rounded-full text-sm font-bold" style="background: var(--ui-panel-bg); color: var(--ui-text-muted); border: 1px solid var(--ui-panel-border);">
                        {{ i }}
                    </div>
                {% endif %}
                {% if not loop.last %}
                    {% if i < current_step %}
                        <div class="h-px w-8 sm:w-14 transition-all duration-300" style="background: var(--ui-success-border);"></div>
                    {% else %}
                        <div class="h-px w-8 sm:w-14 transition-all duration-300" style="background: var(--ui-panel-border);"></div>
                    {% endif %}
                {% endif %}
            </div>
        {% endfor %}
    </div>
</nav>
