{% extends 'base.html.twig' %}

{# On importe notre thème magique ! #}
{% form_theme profileForm 'form/my_theme.html.twig' %}

{% block title %}Créer mon profil | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-2xl rounded-[2.5rem] border border-white/40 bg-white/70 p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] backdrop-blur-xl transition-all duration-500 hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] sm:p-10">
        
        {# EN-TÊTE #}
        <div class="mb-8">
            <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-[#F5F5F7] px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-[#86868B]">
                <span class="h-2 w-2 rounded-full bg-[#0071E3] shadow-[0_0_8px_rgba(0,113,227,0.4)] animate-pulse"></span>
                Profil développeur
            </p>
            <h1 class="text-3xl font-semibold tracking-tight text-[#1D1D1F]">Créer mon profil dev</h1>
            <p class="mt-2 text-[15px] text-[#86868B]">Étape 1 sur 4 - Informations générales.</p>
        </div>

        {# ERREURS GLOBALES #}
        {% if profileForm.vars.errors|length > 0 %}
            <div class="mb-6 rounded-2xl bg-[#FF3B30]/10 px-5 py-3.5 text-[15px] font-medium text-[#FF3B30] animate-fade-in-down">
                {{ form_errors(profileForm) }}
            </div>
        {% endif %}

        {# FORMULAIRE #}
        {{ form_start(profileForm, {attr: {class: 'space-y-6'}}) }}
            
            <div class="grid gap-5 sm:grid-cols-2">
                {# On garde juste les placeholders, le style est géré par my_theme #}
                {{ form_row(profileForm.firstName, { attr: { placeholder: 'Prénom' } }) }}
                {{ form_row(profileForm.lastName, { attr: { placeholder: 'Nom' } }) }}
            </div>

            {{ form_row(profileForm.headline, { attr: { placeholder: 'Ex: Développeur Symfony / React' } }) }}

            <div class="grid gap-5 sm:grid-cols-2">
                {{ form_row(profileForm.city, { attr: { placeholder: 'Ville' } }) }}
                {{ form_row(profileForm.country, { attr: { placeholder: 'Pays' } }) }}
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
                {{ form_row(profileForm.locationType) }}
                {{ form_row(profileForm.experienceLevel) }}
            </div>

            {{ form_row(profileForm.yearsExperience, { attr: { min: 0, placeholder: "Années d'expérience" } }) }}
            
            {# On ajoute juste une hauteur minimale pour la bio #}
            {{ form_row(profileForm.bio, { attr: { class: 'min-h-[120px]', placeholder: 'Bio' } }) }}

            {{ form_row(profileForm.avatarFile) }}

            {# ZONE D'ACTIONS #}
            <div class="mt-10 flex flex-col-reverse items-center gap-4 sm:flex-row sm:gap-3">
                <a href="{{ path('app_applicant_home') }}" 
                   class="inline-flex w-full sm:w-auto items-center justify-center rounded-full bg-[#F5F5F7] px-6 py-4 text-[15px] font-semibold text-[#1D1D1F] transition-all duration-300 hover:scale-[1.02] hover:bg-[#E8E8ED] active:scale-95">
                    Retour dashboard
                </a>
                
                <button type="submit" 
                        class="flex w-full flex-1 items-center justify-center rounded-full bg-[#0071E3] px-6 py-4 text-[15px] font-semibold text-white shadow-sm transition-all duration-300 hover:scale-[1.02] hover:bg-[#0077ED] active:scale-95 focus:outline-none focus:ring-4 focus:ring-[#0071E3]/20">
                    Enregistrer mon profil
                </button>
            </div>
            
        {{ form_end(profileForm) }}
    </section>
{% endblock %}