{% extends 'base.html.twig' %}

{% form_theme profileForm 'form/my_theme.html.twig' %}

{% block title %}Créer mon profil | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-3xl rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:bg-slate-900/60 hover:shadow-emerald-500/10 sm:p-10">
        <div class="mb-8">
            <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.4)] animate-pulse"></span>
                Profil développeur
            </p>
            <h1 class="text-3xl font-semibold tracking-tight text-white">Créer mon profil dev</h1>
            <p class="mt-2 text-[15px] text-slate-400">Pose les bases de ton portfolio avec des informations claires et professionnelles.</p>
        </div>

        {% include 'applicant/_step_indicator.html.twig' with { current_step: 1, total_steps: 4 } only %}

        <div class="mb-8 flex items-start gap-3 rounded-2xl border border-white/10 bg-white/5 px-5 py-4">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
            <p class="text-sm leading-relaxed text-slate-400">Les champs marqués d'une <span class="text-rose-300">*</span> sont obligatoires. L'URL publique et la visibilité se gèrent depuis le dashboard.</p>
        </div>

        {% if profileForm.vars.errors|length > 0 %}
            <div class="mb-6 rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-3.5 text-[15px] font-medium text-red-400 animate-fade-in-down">
                {{ form_errors(profileForm) }}
            </div>
        {% endif %}

        {{ form_start(profileForm, {attr: {class: 'space-y-8', id: 'profile-step1-create-form'}}) }}
            <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
                <div class="mb-6">
                    <h2 class="text-xl font-semibold tracking-tight text-white">Informations personnelles</h2>
                    <p class="mt-2 text-sm text-slate-400">Nom, titre et contexte général du profil.</p>
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                {{ form_row(profileForm.firstName, { attr: { placeholder: 'Prénom' } }) }}
                {{ form_row(profileForm.lastName, { attr: { placeholder: 'Nom' } }) }}
                </div>

                {{ form_row(profileForm.headline, { attr: { placeholder: 'Ex: Développeur Symfony / React' } }) }}
            </div>

            <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
                <div class="mb-6">
                    <h2 class="text-xl font-semibold tracking-tight text-white">Localisation et expérience</h2>
                    <p class="mt-2 text-sm text-slate-400">Indique ton cadre de travail et ton niveau d'expérience.</p>
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    {{ form_row(profileForm.city, { attr: { placeholder: 'Ville' } }) }}
                    {{ form_row(profileForm.country, { attr: { placeholder: 'Pays' } }) }}
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    {{ form_row(profileForm.locationType) }}
                    {{ form_row(profileForm.experienceLevel) }}
                </div>

                {{ form_row(profileForm.yearsExperience, { attr: { placeholder: "Années d'expérience" } }) }}
            </div>

            <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
                <div class="mb-6">
                    <h2 class="text-xl font-semibold tracking-tight text-white">Présentation et photo</h2>
                    <p class="mt-2 text-sm text-slate-400">Soigne la bio et le visuel principal du portfolio public.</p>
                </div>

                {{ form_row(profileForm.bio, { attr: { class: 'min-h-[120px]', placeholder: 'Présente ton parcours, tes spécialités et ton objectif' } }) }}
                {{ form_row(profileForm.avatarFile) }}
            </div>

            {% include 'applicant/_profile_form_actions.html.twig' with {
                form_id: 'profile-step1-create-form',
                dialog_id: 'profile-step1-create-dialog',
                next_label: 'Étape suivante'
            } only %}
        {{ form_end(profileForm) }}
    </section>
{% endblock %}
