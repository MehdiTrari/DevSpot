{% extends 'base.html.twig' %}

{% block title %}Génération du CV | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-xl">
        <div class="rounded-[2rem] border border-white/10 bg-slate-900/60 p-8 text-center shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
            <div class="mx-auto mb-5 h-12 w-12 animate-spin rounded-full border-4 border-white/15 border-t-emerald-500"></div>
            <h1 class="text-2xl font-semibold tracking-tight text-white">Génération de ton CV…</h1>
            <p class="mt-3 text-[15px] text-slate-400">
                On prépare ton PDF à partir des informations de ton profil. Téléchargement en cours.
            </p>

            <div class="mt-8 rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-300">
                Si rien ne se passe,
                <a href="{{ cvUrl }}" class="font-semibold text-emerald-400 hover:text-emerald-300">clique ici</a>.
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.setTimeout(() => {
            const iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            iframe.src = '{{ cvUrl }}';
            document.body.appendChild(iframe);

            window.setTimeout(() => {
                window.location.href = '{{ returnUrl }}';
            }, 1200);
        }, 600);
    </script>
{% endblock %}
