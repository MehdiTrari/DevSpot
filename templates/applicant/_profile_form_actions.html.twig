<div class="mt-10 rounded-[2rem] border p-5 shadow-xl dashboard-actions-card">
    <input type="hidden" name="form_action" value="continue">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-2xl text-sm leading-relaxed dashboard-actions-text">
            Si tu retournes au dashboard, tu peux quitter immédiatement ou enregistrer cette étape avant de partir.
        </p>
        <div class="flex flex-col-reverse gap-3 sm:flex-row">
            <a
                href="{{ path('app_applicant_home') }}"
                data-dashboard-exit-trigger="{{ dialog_id }}"
                class="inline-flex items-center justify-center rounded-full border px-5 py-3 text-center text-[13px] font-semibold whitespace-nowrap transition dashboard-exit-secondary"
            >
                Retour dashboard
            </a>
            <button
                type="submit"
                class="inline-flex items-center justify-center rounded-full border px-6 py-3 text-center text-[13px] font-bold whitespace-nowrap transition dashboard-actions-next-success"
            >
                {{ next_label }}
            </button>
        </div>
    </div>
</div>

<div
    data-dashboard-exit-overlay="{{ dialog_id }}"
    class="fixed inset-0 z-[80] hidden"
    aria-hidden="true"
></div>

<dialog id="{{ dialog_id }}"
    class="fixed inset-0 z-[81] m-auto w-full max-w-md rounded-[2rem] border p-0 shadow-2xl dashboard-exit-dialog"
>
    <div class="space-y-6 p-7">
        <div>
            <h2 class="text-xl font-semibold tracking-tight dashboard-exit-title">Voulez-vous enregistrer ?</h2>
            <p class="mt-2 text-sm leading-relaxed dashboard-exit-text">
                Tu peux enregistrer cette étape avant de revenir au dashboard, ou quitter sans sauvegarder.
            </p>
        </div>

        <div class="flex flex-col gap-3">
            <button
                type="button"
                data-dashboard-save-exit="{{ form_id }}"
                class="inline-flex items-center justify-center rounded-full border px-5 py-3 text-[15px] font-bold transition dashboard-actions-next-success"
            >
                Enregistrer et quitter
            </button>
            <a
                href="{{ path('app_applicant_home') }}"
                class="inline-flex items-center justify-center rounded-full border px-5 py-3 text-[15px] font-semibold transition dashboard-exit-secondary"
            >
                Quitter sans enregistrer
            </a>
            <button
                type="button"
                data-dashboard-exit-close="{{ dialog_id }}"
                class="inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-medium transition dashboard-exit-close"
            >
                Continuer l'édition
            </button>
        </div>
    </div>
</dialog>

<style>
    .dashboard-actions-card {
        border-color: var(--ui-panel-border);
        background: var(--ui-panel-bg);
        box-shadow: 0 18px 40px rgba(var(--indeed-shadow-rgb), 0.18);
    }

    .dashboard-actions-text {
        color: var(--ui-text-muted);
    }

    .dashboard-actions-secondary {
        border-color: var(--ui-button-secondary-border);
        background: var(--ui-button-secondary-bg);
        color: var(--ui-button-secondary-text);
    }

    .dashboard-actions-secondary:hover {
        background: var(--ui-button-secondary-hover);
    }

    .dashboard-actions-primary {
        border-color: var(--ui-button-primary-bg);
        background: var(--ui-button-primary-bg);
        color: var(--ui-button-primary-text);
        box-shadow: var(--premium-section-shadow);
    }

    .dashboard-actions-primary:hover {
        background: var(--ui-button-primary-hover);
        border-color: var(--ui-button-primary-hover);
    }

    .dashboard-actions-next-success {
        border-color: var(--ui-success-border);
        background: var(--ui-success-bg);
        color: var(--ui-success-text-muted);
        box-shadow: 0 10px 22px rgba(var(--indeed-shadow-rgb), 0.12);
    }

    .dashboard-actions-next-success:hover {
        filter: brightness(0.98);
    }

    #{{ dialog_id }} {
        inset: 0;
        margin: auto;
        border-color: var(--ui-panel-border);
        background: var(--ui-panel-bg);
        color: var(--ui-text-primary);
        box-shadow: 0 24px 56px rgba(var(--indeed-shadow-rgb), 0.24);
    }

    [data-dashboard-exit-overlay="{{ dialog_id }}"] {
        background: color-mix(in srgb, var(--indeed-bg) 72%, transparent);
        backdrop-filter: blur(4px);
    }

    .dashboard-exit-title {
        color: var(--ui-heading);
    }

    .dashboard-exit-text {
        color: var(--ui-text-muted);
    }

    .dashboard-exit-secondary {
        border-color: var(--ui-button-secondary-border);
        background: var(--ui-button-secondary-bg);
        color: var(--ui-button-secondary-text);
    }

    .dashboard-exit-secondary:hover {
        background: var(--ui-button-secondary-hover);
    }

    .dashboard-exit-close {
        color: var(--ui-text-muted);
    }

    .dashboard-exit-close:hover {
        color: var(--ui-heading);
    }

</style>

<script>
    (() => {
        const dialogId = {{ dialog_id|json_encode|raw }};
        const formId = {{ form_id|json_encode|raw }};
        const dialog = document.getElementById(dialogId);
        const form = document.getElementById(formId);
        const overlay = document.querySelector(`[data-dashboard-exit-overlay="${dialogId}"]`);

        if (!(dialog instanceof HTMLDialogElement) || !(form instanceof HTMLFormElement) || !(overlay instanceof HTMLElement)) {
            return;
        }

        const openDialog = () => {
            dialog.setAttribute('open', 'open');
            overlay.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        };

        const closeDialog = () => {
            dialog.removeAttribute('open');
            overlay.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        };

        document.querySelectorAll(`[data-dashboard-exit-trigger="${dialogId}"]`).forEach((trigger) => {
            if (trigger.dataset.dashboardExitBound === 'true') {
                return;
            }

            trigger.dataset.dashboardExitBound = 'true';
            trigger.addEventListener('click', (event) => {
                event.preventDefault();
                openDialog();
            });
        });

        overlay.addEventListener('click', closeDialog);

        dialog.querySelectorAll(`[data-dashboard-exit-close="${dialogId}"]`).forEach((button) => {
            if (button.dataset.dashboardExitCloseBound === 'true') {
                return;
            }

            button.dataset.dashboardExitCloseBound = 'true';
            button.addEventListener('click', closeDialog);
        });

        dialog.querySelectorAll(`[data-dashboard-save-exit="${formId}"]`).forEach((button) => {
            if (button.dataset.dashboardExitSaveBound === 'true') {
                return;
            }

            button.dataset.dashboardExitSaveBound = 'true';
            button.addEventListener('click', () => {
                let actionInput = form.querySelector('input[name="form_action"]');
                if (!(actionInput instanceof HTMLInputElement)) {
                    actionInput = document.createElement('input');
                    actionInput.type = 'hidden';
                    actionInput.name = 'form_action';
                    form.appendChild(actionInput);
                }

                actionInput.value = 'save_and_exit';
                closeDialog();
                form.requestSubmit();
            });
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && dialog.hasAttribute('open')) {
                closeDialog();
            }
        });
    })();
</script>
