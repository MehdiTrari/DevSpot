<div class="js-chat-message flex items-end gap-2 {{ mine ? 'justify-end' : 'justify-start' }}" data-message-id="{{ message.id }}">
    <div class="max-w-[78%] rounded-2xl border px-4 py-2.5 {{ mine ? 'border-blue-200 bg-blue-100 text-blue-900' : 'border-slate-200 bg-white text-slate-800' }}">
        <p class="whitespace-pre-line text-sm break-words">{{ message.content }}</p>
        <p class="mt-1 text-right text-[11px] {{ mine ? 'text-blue-700/80' : 'text-slate-500' }}">{{ message.createdAt|date('H:i') }}</p>
    </div>
</div>
