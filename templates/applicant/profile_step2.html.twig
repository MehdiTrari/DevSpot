{% extends 'base.html.twig' %}

{% form_theme profileForm 'form/my_theme.html.twig' _self %}

{% block title %}Étape 2 | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-4xl rounded-3xl border border-violet-100 bg-white/95 p-6 shadow-xl shadow-violet-100/60 backdrop-blur sm:p-8">
        <div class="mb-6">
            <p class="mb-2 inline-flex items-center gap-2 rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-yellow-700">
                <span class="h-2 w-2 rounded-full bg-yellow-400"></span>
                Profil développeur
            </p>
            <h1 class="text-3xl font-semibold tracking-tight text-violet-900">Étape 2 - Expériences, éducation, compétences</h1>
            <p class="mt-2 text-sm text-slate-500">Ajoute au moins une expérience, une formation et une compétence.</p>
        </div>

        {% if profileForm.vars.errors|length > 0 %}
            <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{{ form_errors(profileForm) }}</div>
        {% endif %}

        {{ form_start(profileForm, {attr: {class: 'space-y-4', novalidate: 'novalidate'}}) }}
            <div class="space-y-4">
                {# --- SECTION SKILLS --- #}
                <div class="rounded-2xl border border-violet-100 bg-violet-50/30 p-6">
                    <div class="mb-4">
                        <h2 class="text-lg font-semibold text-violet-900">Compétences techniques & soft skills</h2>
                        <p class="text-sm text-slate-500">Ajoute tes compétences techniques (langages, frameworks, outils) et tes soft skills.</p>
                    </div>
                    
                    <div id="profile-skills-list" class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-collection-list data-empty-text="Aucune compétence ajoutée." data-index="{{ profileForm.profileSkills|length }}" data-prototype="{{ form_widget(profileForm.profileSkills.vars.prototype)|e('html_attr') }}">
                        {% for item in profileForm.profileSkills %}
                            <div class="group relative rounded-xl border border-violet-100 bg-white p-4 shadow-sm transition hover:border-violet-200 hover:shadow-md" data-collection-item>
                                <button type="button" class="absolute right-2 top-2 rounded-lg p-1.5 text-slate-400 opacity-0 transition hover:bg-red-50 hover:text-red-600 group-hover:opacity-100" data-collection-remove title="Supprimer">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" /></svg>
                                </button>
                                <div class="space-y-2">
                                    {{ form_widget(item) }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    
                    <button type="button" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl border-2 border-dashed border-violet-200 bg-white/50 py-3 text-sm font-semibold text-violet-600 transition hover:border-violet-400 hover:bg-violet-50 hover:text-violet-800" data-collection-add="#profile-skills-list">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" /></svg>
                        Ajouter une compétence / soft skill
                    </button>
                    {{ form_errors(profileForm.profileSkills) }}
                </div>

                {# --- SECTION EXPERIENCES --- #}
                <div class="rounded-2xl border border-violet-100 bg-violet-50/30 p-6">
                    <div class="mb-4">
                        <h2 class="text-lg font-semibold text-violet-900">Expériences Professionnelles</h2>
                        <p class="text-sm text-slate-500">Détaillez vos expériences passées et les technologies utilisées.</p>
                    </div>

                    <div id="experiences-list" class="space-y-3" data-collection-list data-empty-text="Aucune expérience ajoutée." data-index="{{ profileForm.experiences|length }}" data-prototype="{{ form_widget(profileForm.experiences.vars.prototype)|e('html_attr') }}">
                        {% for item in profileForm.experiences %}
                            <div class="group relative rounded-xl border border-violet-100 bg-white p-5 shadow-sm transition hover:border-violet-200 hover:shadow-md" data-collection-item>
                                <button type="button" class="absolute right-2 top-2 rounded-lg p-1.5 text-slate-400 opacity-0 transition hover:bg-red-50 hover:text-red-600 group-hover:opacity-100" data-collection-remove title="Supprimer">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" /></svg>
                                </button>
                                <div class="space-y-4">
                                    {{ form_widget(item) }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <button type="button" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl border-2 border-dashed border-violet-200 bg-white/50 py-3 text-sm font-semibold text-violet-600 transition hover:border-violet-400 hover:bg-violet-50 hover:text-violet-800" data-collection-add="#experiences-list">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" /></svg>
                        Ajouter une expérience
                    </button>
                    {{ form_errors(profileForm.experiences) }}
                </div>

                {# --- SECTION EDUCATION --- #}
                <div class="rounded-2xl border border-violet-100 bg-violet-50/30 p-6">
                    <div class="mb-4">
                        <h2 class="text-lg font-semibold text-violet-900">Formation & Éducation</h2>
                        <p class="text-sm text-slate-500">Indiquez vos diplômes et certifications.</p>
                    </div>

                    <div id="education-list" class="space-y-3" data-collection-list data-empty-text="Aucune formation ajoutée." data-index="{{ profileForm.education|length }}" data-prototype="{{ form_widget(profileForm.education.vars.prototype)|e('html_attr') }}">
                        {% for item in profileForm.education %}
                            <div class="group relative rounded-xl border border-violet-100 bg-white p-5 shadow-sm transition hover:border-violet-200 hover:shadow-md" data-collection-item>
                                <button type="button" class="absolute right-2 top-2 rounded-lg p-1.5 text-slate-400 opacity-0 transition hover:bg-red-50 hover:text-red-600 group-hover:opacity-100" data-collection-remove title="Supprimer">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" /></svg>
                                </button>
                                <div class="space-y-4">
                                    {{ form_widget(item) }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <button type="button" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl border-2 border-dashed border-violet-200 bg-white/50 py-3 text-sm font-semibold text-violet-600 transition hover:border-violet-400 hover:bg-violet-50 hover:text-violet-800" data-collection-add="#education-list">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" /></svg>
                        Ajouter une formation
                    </button>
                    {{ form_errors(profileForm.education) }}
                </div>
            </div>

            {% do profileForm.profileSkills.setRendered() %}
            {% do profileForm.experiences.setRendered() %}
            {% do profileForm.education.setRendered() %}

            <div class="flex items-center gap-3">
                <a href="{{ path('app_applicant_home') }}" class="inline-flex items-center justify-center rounded-xl border border-violet-200 bg-white px-4 py-3 text-sm font-semibold text-violet-700 transition hover:bg-violet-50">Retour dashboard</a>
                <button type="submit" class="flex-1 rounded-xl bg-violet-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-violet-700">Enregistrer l'étape 2</button>
            </div>
        {{ form_end(profileForm) }}
    </section>

    <script>
        (() => {
            const makeItem = (list) => {
                const index = Number(list.dataset.index || '0');
                const prototype = (list.dataset.prototype || '').replaceAll('__name__', String(index));
                list.dataset.index = String(index + 1);

                const empty = list.querySelector('[data-collection-empty]');
                if (empty) empty.remove();

                const item = document.createElement('div');
                item.className = 'group relative rounded-xl border border-violet-100 bg-white p-5 shadow-sm transition hover:border-violet-200 hover:shadow-md';
                item.setAttribute('data-collection-item', '');
                
                const deleteBtn = '<button type="button" class="absolute right-2 top-2 rounded-lg p-1.5 text-slate-400 opacity-0 transition hover:bg-red-50 hover:text-red-600 group-hover:opacity-100" data-collection-remove title="Supprimer"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" /></svg></button>';
                
                item.innerHTML = deleteBtn + '<div class="space-y-4">' + prototype + '</div>';
                list.appendChild(item);
            };

            const ensureEmptyState = (list) => {
                if (list.querySelector('[data-collection-item]')) {
                    const empty = list.querySelector('[data-collection-empty]');
                    if (empty) empty.remove();
                    return;
                }
                if (list.querySelector('[data-collection-empty]')) return;
                
                const empty = document.createElement('p');
                empty.className = 'text-sm text-slate-500 italic py-2';
                empty.dataset.collectionEmpty = '';
                empty.textContent = list.dataset.emptyText || 'Aucun élément ajouté.';
                list.appendChild(empty);
            };

            document.querySelectorAll('[data-collection-list]').forEach(ensureEmptyState);

            document.addEventListener('click', (event) => {
                const addButton = event.target.closest('[data-collection-add]');
                if (addButton) {
                    const selector = addButton.getAttribute('data-collection-add');
                    const list = selector ? document.querySelector(selector) : null;
                    if (list) makeItem(list);
                    return;
                }

                const removeButton = event.target.closest('[data-collection-remove]');
                if (!removeButton) return;
                const item = removeButton.closest('[data-collection-item]');
                const list = item ? item.closest('[data-collection-list]') : null;
                if (item) item.remove();
                if (list) ensureEmptyState(list);
            });
        })();
    </script>
{% endblock %}

{# Layout Grid pour les sous-formulaires #}
{% block _developer_profile_experiences_entry_widget %}
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 p-2">
        {% for child in form %}
            <div class="{{ child.vars.name in ['description', 'bio'] ? 'md:col-span-2' : '' }}">
                {{ form_row(child) }}
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block _developer_profile_education_entry_widget %}
    <div class="grid grid-cols-1 gap-x-4 gap-y-2 md:grid-cols-2">
        {% for child in form %}
            <div class="{{ child.vars.name in ['description', 'bio'] ? 'md:col-span-2' : '' }}">
                {{ form_row(child) }}
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block _developer_profile_profileSkills_entry_widget %}
    <div class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 p-2">
        {% for child in form %}
            <div class="{{ child.vars.name == 'years' ? 'sm:col-span-1' : '' }}">
                {{ form_row(child) }}
            </div>
        {% endfor %}
    </div>
{% endblock %}