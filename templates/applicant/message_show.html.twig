{% extends 'base.html.twig' %}

{% block title %}Message reçu | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-4xl space-y-8 font-sans">
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                        Message reçu
                    </p>
                    <h1 class="text-3xl font-semibold tracking-tight text-white">{{ message.subject ?: 'Sans sujet' }}</h1>
                    <p class="mt-2 text-[15px] text-slate-400">Message envoyé le {{ message.createdAt|date('d/m/Y à H:i') }}</p>
                </div>

                <a href="{{ path('app_applicant_messages') }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[15px] font-semibold tracking-tight text-white shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-white/10 hover:shadow-emerald-500/20 active:scale-95">
                    Retour aux messages
                </a>
            </div>
        </div>

        <article class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
            <dl class="grid gap-5 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Expéditeur</dt>
                    <dd class="mt-2 text-[15px] font-medium text-white">{{ message.recruiterName }}</dd>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Email</dt>
                    <dd class="mt-2 break-all text-[15px] font-medium text-white">{{ message.recruiterEmail }}</dd>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:col-span-2">
                    <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Sujet</dt>
                    <dd class="mt-2 text-[15px] font-medium text-white">{{ message.subject ?: 'Sans sujet' }}</dd>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:col-span-2">
                    <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">Contenu</dt>
                    <dd class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-slate-200">{{ message.message }}</dd>
                </div>
            </dl>
        </article>
    </section>
{% endblock %}