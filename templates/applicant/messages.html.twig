{% extends 'base.html.twig' %}

{% block title %}Messages reçus | DevSpot{% endblock %}

{% block body %}
    {% set unreadCount = messages|filter(message => not message.isRead)|length %}

    <section class="w-full max-w-5xl space-y-8 font-sans">
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                        Messagerie
                    </p>
                    <h1 class="text-4xl font-semibold tracking-tight text-white">Messages reçus</h1>
                    <p class="mt-2 text-[15px] text-slate-400">Consulte les recruteurs qui ont contacté ton profil public.</p>
                </div>

                <a href="{{ path('app_applicant_home') }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[15px] font-semibold tracking-tight text-white shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-white/10 hover:shadow-emerald-500/20 active:scale-95">
                    Retour dashboard
                </a>
            </div>
        </div>

        <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
            {% if messages is empty %}
                <div class="rounded-2xl border border-yellow-400/20 bg-yellow-400/10 px-5 py-3.5 text-[15px] font-medium text-yellow-300 shadow-xl backdrop-blur-md">
                    <p>Vous n'avez reçu aucun message pour le moment.</p>
                </div>
            {% else %}
                {% if unreadCount == 0 %}
                    <div class="mb-4 rounded-2xl border border-yellow-400/20 bg-yellow-400/10 px-5 py-3.5 text-[15px] font-medium text-yellow-300 shadow-xl backdrop-blur-md">
                        <p>Aucun nouveau message. Vous pouvez toujours consulter vos messages déjà ouverts ci-dessous.</p>
                    </div>
                {% endif %}

                <div class="space-y-4">
                    {% for message in messages %}
                        <article class="rounded-2xl border p-5 transition-all duration-300 {{ message.isRead ? 'border-white/10 bg-white/5 hover:border-white/20 hover:bg-white/10' : 'border-emerald-500/30 bg-emerald-500/10 shadow-lg shadow-emerald-500/10 hover:border-emerald-400/40 hover:bg-emerald-500/15' }}">
                            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h2 class="text-lg font-semibold text-white">{{ message.recruiterName }}</h2>
                                        {% if not message.isRead %}
                                            <span class="inline-flex items-center rounded-full border border-emerald-400/30 bg-emerald-400/15 px-2.5 py-1 text-xs font-semibold text-emerald-200">Nouveau</span>
                                        {% endif %}
                                    </div>
                                    <p class="mt-1 text-sm {{ message.isRead ? 'text-slate-400' : 'text-emerald-100/80' }}">{{ message.recruiterEmail }}</p>
                                    <p class="mt-3 text-[15px] font-medium {{ message.isRead ? 'text-slate-200' : 'text-white' }}">{{ message.subject ?: 'Sans sujet' }}</p>
                                    <p class="mt-2 text-sm {{ message.isRead ? 'text-slate-400' : 'text-emerald-100/80' }}">Reçu le {{ message.createdAt|date('d/m/Y à H:i') }}</p>
                                </div>

                                <a href="{{ path('app_applicant_message_show', {id: message.id}) }}" class="inline-flex shrink-0 items-center justify-center rounded-full bg-emerald-500 px-5 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-emerald-500/20 transition-all duration-300 hover:scale-[1.02] hover:bg-emerald-400 active:scale-95">
                                    Ouvrir
                                </a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}