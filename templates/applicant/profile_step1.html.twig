{% extends 'base.html.twig' %}

{% form_theme profileForm 'form/my_theme.html.twig' %}

{% block title %}Étape 1 | DevSpot{% endblock %}

{% block body %}
    {# Carte en verre fumé #}
    <section class="w-full max-w-2xl rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:bg-slate-900/60 hover:shadow-emerald-500/10 sm:p-10">
        
        {# EN-TÊTE #}
        <div class="mb-8">
            <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.4)] animate-pulse"></span>
                Profil développeur
            </p>
            <h1 class="text-3xl font-semibold tracking-tight text-white">Étape 1 - Informations générales</h1>
            <p class="mt-2 text-[15px] text-slate-400">Nom, localisation, expérience et bio.</p>
        </div>

        {# ERREURS GLOBALES #}
        {% if profileForm.vars.errors|length > 0 %}
            <div class="mb-6 rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-3.5 text-[15px] font-medium text-red-400 animate-fade-in-down">
                {{ form_errors(profileForm) }}
            </div>
        {% endif %}

        {# FORMULAIRE #}
        {{ form_start(profileForm, {attr: {class: 'space-y-6'}}) }}
            
            <div class="grid gap-5 sm:grid-cols-2">
                {{ form_row(profileForm.firstName) }}
                {{ form_row(profileForm.lastName) }}
            </div>
            
            {{ form_row(profileForm.headline) }}
            
            <div class="grid gap-5 sm:grid-cols-2">
                {{ form_row(profileForm.city) }}
                {{ form_row(profileForm.country) }}
            </div>
            
            <div class="grid gap-5 sm:grid-cols-2">
                {{ form_row(profileForm.locationType) }}
                {{ form_row(profileForm.experienceLevel) }}
            </div>
            
            {{ form_row(profileForm.yearsExperience) }}
            
            {{ form_row(profileForm.bio, {
                attr: { class: 'min-h-[120px]' }
            }) }}

            {# SECTION AVATAR (Adaptée au Dark Mode) #}
            <div class="mt-8 space-y-5">
                {% if profileForm.vars.data.avatarPath %}
                    <div class="flex items-center justify-between gap-5 rounded-2xl border border-white/10 bg-white/5 p-5">
                        <div class="flex items-center gap-5">
                            <img src="{{ asset(profileForm.vars.data.avatarPath) }}" alt="Photo de profil" class="h-20 w-20 rounded-full object-cover shadow-sm ring-4 ring-slate-800">
                            <div>
                                <p class="text-[15px] font-medium text-white">Photo actuelle</p>
                                <p class="mt-0.5 text-[13px] text-slate-400">Elle s'affiche sur ton profil public.</p>
                            </div>
                        </div>
                        <button type="button" 
                                id="deleteAvatarBtn"
                                data-csrf-token="{{ csrf_token('delete_avatar') }}"
                                class="inline-flex items-center justify-center h-10 w-10 rounded-full border border-red-500/30 bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors"
                                title="Supprimer la photo de profil">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                {% endif %}
                
                {{ form_row(profileForm.avatarFile) }}
            </div>

            {# ZONE D'ACTIONS #}
            <div class="mt-10 flex flex-col-reverse items-center gap-4 sm:flex-row sm:gap-3">
                {# Bouton Secondaire #}
                <button type="button"
                        id="backBtn"
                        class="inline-flex w-full sm:w-auto items-center justify-center rounded-full border border-white/10 bg-white/5 px-6 py-4 text-[15px] font-semibold text-white transition-all duration-300 hover:scale-[1.02] hover:bg-white/10 active:scale-95">
                    Retour dashboard
                </button>
                
                {# Bouton Principal Émeraude #}
                <button type="submit"
                        id="submitBtn"
                        class="flex w-full flex-1 items-center justify-center rounded-full bg-emerald-500 px-6 py-4 text-[15px] font-bold text-slate-950 shadow-lg shadow-emerald-500/20 transition-all duration-300 hover:scale-[1.02] hover:bg-emerald-400 active:scale-95 focus:outline-none focus:ring-4 focus:ring-emerald-500/30">
                    Étape suivante
                </button>
            </div>
            
        {{ form_end(profileForm) }}
    </section>

    <script>
        // Modale de confirmation
        const confirmationModal = (() => {
            const modal = document.createElement('div');
            modal.id = 'confirmationModal';
            modal.className = 'fixed inset-0 z-50 flex items-center justify-center hidden bg-black/50 backdrop-blur-sm';
            modal.innerHTML = `
                <div class="rounded-[2rem] border border-white/10 bg-slate-900 p-8 shadow-2xl max-w-md w-full mx-4">
                    <h2 class="text-xl font-semibold text-white mb-2">Changements non enregistrés</h2>
                    <p class="text-slate-300 mb-6">Vous avez des modifications non enregistrées. Voulez-vous les enregistrer avant de continuer?</p>
                    <div class="flex flex-col gap-3 sm:flex-row-reverse">
                        <button id="modalSaveBtn" class="flex-1 rounded-full bg-emerald-500 px-6 py-3 text-[15px] font-bold text-slate-950 hover:bg-emerald-400 transition-all">
                            Enregistrer
                        </button>
                        <button id="modalDiscardBtn" class="flex-1 rounded-full border border-white/10 bg-white/5 px-6 py-3 text-[15px] font-semibold text-white hover:bg-white/10 transition-all">
                            Continuer sans enregistrer
                        </button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
            return modal;
        })();

        const form = document.querySelector('form');
        const backBtn = document.getElementById('backBtn');
        const submitBtn = document.getElementById('submitBtn');
        const modalSaveBtn = document.getElementById('modalSaveBtn');
        const modalDiscardBtn = document.getElementById('modalDiscardBtn');
        
        let hasChanges = false;
        let targetUrl = null;
        let shouldReturnToDashboard = false;

        // Sauvegarder l'état initial du formulaire
        let initialFormState = {};
        form.querySelectorAll('input, select, textarea').forEach(field => {
            // Ignorer les champs hidden et file
            if (field.name && field.type !== 'hidden' && field.type !== 'file') {
                initialFormState[field.name] = field.value || '';
            }
        });

        // Détecter les changements du formulaire
        const checkFormChanges = () => {
            hasChanges = false;
            form.querySelectorAll('input, select, textarea').forEach(field => {
                if (field.name && field.type !== 'hidden' && field.type !== 'file') {
                    if (field.value !== initialFormState[field.name]) {
                        hasChanges = true;
                    }
                }
            });
        };

        form.addEventListener('change', checkFormChanges);
        form.addEventListener('input', checkFormChanges);

        // Gestion du bouton retour
        if (backBtn) {
            backBtn.addEventListener('click', (e) => {
                e.preventDefault();
                checkFormChanges(); // Vérifier les changements avant de décider
                if (hasChanges) {
                    targetUrl = '{{ path('app_applicant_home') }}';
                    shouldReturnToDashboard = true;
                    confirmationModal.classList.remove('hidden');
                } else {
                    // Pas de changements, rediriger directement
                    window.location.href = '{{ path('app_applicant_home') }}';
                }
            });
        }

        // Bouton Enregistrer dans la modale
        modalSaveBtn.addEventListener('click', () => {
            confirmationModal.classList.add('hidden');
            
            // Ajouter un input hidden pour indiquer le retour au dashboard
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = '_return_to_dashboard';
            input.value = '1';
            form.appendChild(input);
            
            submitBtn.click();
        });

        // Bouton Continuer sans enregistrer
        modalDiscardBtn.addEventListener('click', () => {
            confirmationModal.classList.add('hidden');
            window.location.href = targetUrl;
        });

        // Avatar deletion script
        document.getElementById('deleteAvatarBtn')?.addEventListener('click', async (e) => {
            e.preventDefault();
            
            if (!confirm('Es-tu sûr de vouloir supprimer ta photo de profil?')) {
                return;
            }

            const btn = e.target.closest('button');
            const csrfToken = btn.getAttribute('data-csrf-token');
            
            if (!csrfToken) {
                alert('Token de sécurité manquant');
                return;
            }

            try {
                const response = await fetch('{{ path('app_applicant_avatar_delete') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                    body: new URLSearchParams({
                        '_token': csrfToken
                    })
                });

                const data = await response.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Erreur lors de la suppression de la photo');
                }
            } catch (error) {
                console.error('Erreur:', error);
                alert('Une erreur est survenue');
            }
        });
    </script>
{% endblock %}