{% extends 'base.html.twig' %}

{% form_theme profileForm 'form/my_theme.html.twig' %}

{% block title %}Étape 1 | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-3xl rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:shadow-emerald-500/10 sm:p-10">
        <div class="mb-8">
            <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                Profil développeur
            </p>
            <h1 class="text-3xl font-semibold tracking-tight text-white">Étape 1 - Informations générales</h1>
            <p class="mt-2 text-[15px] text-slate-400">Nom, localisation, expérience et présentation publique.</p>
        </div>

        {% include 'applicant/_step_indicator.html.twig' with { current_step: 1, total_steps: 4 } only %}

        <div class="mb-8 flex items-start gap-3 rounded-2xl border border-white/10 bg-white/5 px-5 py-4">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
            <p class="text-sm leading-relaxed text-slate-400">Un titre clair et une bio concise renforcent la qualité du portfolio. L'URL publique et la visibilité se gèrent depuis le dashboard.</p>
        </div>

        {% if profileForm.vars.errors|length > 0 %}
            <div class="mb-6 rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-3.5 text-[15px] font-medium text-red-400 animate-fade-in-down">
                {{ form_errors(profileForm) }}
            </div>
        {% endif %}

        {{ form_start(profileForm, {attr: {class: 'space-y-8', id: 'profile-step1-form'}}) }}
            <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
                <div class="mb-6">
                    <h2 class="text-xl font-semibold tracking-tight text-white">Informations personnelles</h2>
                    <p class="mt-2 text-sm text-slate-400">Nom et titre professionnel affichés en tête du portfolio.</p>
                </div>
                <div class="grid gap-5 sm:grid-cols-2">
                    {{ form_row(profileForm.firstName) }}
                    {{ form_row(profileForm.lastName) }}
                </div>
                {{ form_row(profileForm.headline) }}
            </div>

            <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
                <div class="mb-6">
                    <h2 class="text-xl font-semibold tracking-tight text-white">Localisation et expérience</h2>
                    <p class="mt-2 text-sm text-slate-400">Ces informations structurent immédiatement le profil pour un recruteur.</p>
                </div>
                <div class="grid gap-5 sm:grid-cols-2">
                    {{ form_row(profileForm.city) }}
                    {{ form_row(profileForm.country) }}
                </div>
                <div class="grid gap-5 sm:grid-cols-2">
                    {{ form_row(profileForm.locationType) }}
                    {{ form_row(profileForm.experienceLevel) }}
                </div>
                {{ form_row(profileForm.yearsExperience) }}
            </div>

            <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
                <div class="mb-6">
                    <h2 class="text-xl font-semibold tracking-tight text-white">Présentation et photo</h2>
                    <p class="mt-2 text-sm text-slate-400">Rends ta présentation lisible et cohérente avec le reste du portfolio.</p>
                </div>
                {{ form_row(profileForm.bio, {
                    attr: { class: 'min-h-[120px]' }
                }) }}

                {% if profileForm.vars.data.avatarPath %}
                    <div class="flex items-center justify-between gap-5 rounded-2xl border border-white/10 bg-white/5 p-5">
                        <div class="flex items-center gap-5">
                            <img src="{{ asset(profileForm.vars.data.avatarPath) }}" alt="Photo de profil" class="h-20 w-20 rounded-full object-cover shadow-sm ring-4 ring-slate-800">
                            <div>
                                <p class="text-[15px] font-medium text-white">Photo actuelle</p>
                                <p class="mt-0.5 text-[13px] text-slate-400">Elle s'affiche sur ton profil public.</p>
                            </div>
                        </div>
                        <button type="button" 
                                id="deleteAvatarBtn"
                                data-csrf-token="{{ csrf_token('delete_avatar') }}"
                                class="inline-flex items-center justify-center h-10 w-10 rounded-full border border-red-500/30 bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors"
                                title="Supprimer la photo de profil">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                {% endif %}
                {{ form_row(profileForm.avatarFile) }}
            </div>

            {% include 'applicant/_profile_form_actions.html.twig' with {
                form_id: 'profile-step1-form',
                dialog_id: 'profile-step1-dialog',
                next_label: 'Étape suivante'
            } only %}
        {{ form_end(profileForm) }}
    </section>

    <script>
        document.getElementById('deleteAvatarBtn')?.addEventListener('click', async (e) => {
            e.preventDefault();
            
            if (!confirm('Es-tu sûr de vouloir supprimer ta photo de profil?')) {
                return;
            }

            const btn = e.target.closest('button');
            const csrfToken = btn.getAttribute('data-csrf-token');
            
            if (!csrfToken) {
                alert('Token de sécurité manquant');
                return;
            }

            try {
                const response = await fetch('{{ path('app_applicant_avatar_delete') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                    body: new URLSearchParams({
                        '_token': csrfToken
                    })
                });

                const data = await response.json();
                if (data.success) {
                    // Recharger la page pour afficher les changements
                    window.location.reload();
                } else {
                    alert('Erreur lors de la suppression de la photo');
                }
            } catch (error) {
                console.error('Erreur:', error);
                alert('Une erreur est survenue');
            }
        });
    </script>
{% endblock %}
