{% extends 'base.html.twig' %}

{% block title %}Etape 1 | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-2xl rounded-3xl border border-violet-100 bg-white/95 p-6 shadow-xl shadow-violet-100/60 backdrop-blur sm:p-8">
        <div class="mb-6">
            <p class="mb-2 inline-flex items-center gap-2 rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-yellow-700">
                <span class="h-2 w-2 rounded-full bg-yellow-400"></span>
                Profil developpeur
            </p>
            <h1 class="text-3xl font-semibold tracking-tight text-violet-900">Etape 1 - Informations generales</h1>
            <p class="mt-2 text-sm text-slate-500">Nom, localisation, experience et bio.</p>
        </div>

        {% if form_errors(profileForm) %}
            <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{{ form_errors(profileForm) }}</div>
        {% endif %}

        {{ form_start(profileForm, {attr: {class: 'space-y-4'}}) }}
            <div class="grid gap-4 sm:grid-cols-2">
                {{ form_row(profileForm.firstName) }}
                {{ form_row(profileForm.lastName) }}
            </div>
            {{ form_row(profileForm.headline) }}
            <div class="grid gap-4 sm:grid-cols-2">
                {{ form_row(profileForm.city) }}
                {{ form_row(profileForm.country) }}
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
                {{ form_row(profileForm.locationType) }}
                {{ form_row(profileForm.experienceLevel) }}
            </div>
            {{ form_row(profileForm.yearsExperience) }}
            {{ form_row(profileForm.bio) }}

            <div class="flex items-center gap-3">
                <a href="{{ path('app_applicant_home') }}" class="inline-flex items-center justify-center rounded-xl border border-violet-200 bg-white px-4 py-3 text-sm font-semibold text-violet-700 transition hover:bg-violet-50">Retour dashboard</a>
                <button type="submit" class="flex-1 rounded-xl bg-violet-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-violet-700">Enregistrer l'étape 1</button>
            </div>
        {{ form_end(profileForm) }}
    </section>
{% endblock %}
