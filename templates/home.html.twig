{% extends 'base.html.twig' %}

{% block title %}Accueil | DevSpot{% endblock %}

{% block body %}
    {% set experienceLevelLabels = {
        'intern': 'Stagiaire',
        'junior': 'Junior',
        'mid': 'Intermédiaire',
        'senior': 'Senior',
        'lead': 'Lead'
    } %}

    {# Carte principale en verre fumé #}
    <section class="w-full max-w-6xl rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:bg-slate-900/60 hover:shadow-emerald-500/10 sm:p-10">
        
        {# HEADER DE LA CARTE #}
        <div class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
            <div>
                {# Badge translucide avec indicateur pulse #}
                <p class="mb-3 inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                    {# L'indicateur lumineux repensé #}
                    <span class="relative flex h-2.5 w-2.5 items-center justify-center">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
                    </span>
                    Espace public
                </p>
                <h1 class="text-4xl font-semibold tracking-tight text-white">Bienvenue sur DevSpot.</h1>
                <p class="mt-2 text-[15px] leading-relaxed text-slate-400">
                    {% if app.user %}
                        Connecté en tant que <span class="font-medium text-white">{{ is_granted('ROLE_APPLICANT') ? 'candidat' : 'recruteur' }}</span>.
                    {% else %}
                        Découvre DevSpot et connecte-toi pour accéder à ton espace.
                    {% endif %}
                </p>
            </div>

            {# BOUTONS D'ACTION PRINCIPAUX #}
            {% if not app.user %}
                <div class="shrink-0">
                    <div class="flex flex-col gap-3 sm:flex-row sm:gap-2">
                        {# Bouton principal Émeraude #}
                        <a href="{{ path('app_register') }}" 
                           class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-6 py-3.5 text-[15px] font-bold text-slate-950 shadow-lg shadow-emerald-500/20 transition-all duration-300 hover:scale-[1.02] hover:bg-emerald-400 active:scale-95">
                            Créer un compte
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>

        {# PORTFOLIOS PUBLICS #}
        <div class="mt-10 rounded-[2rem] border border-white/10 bg-slate-800/50 p-6 shadow-sm transition-all duration-500 hover:bg-slate-800/80 sm:p-8">
            <div class="flex items-center justify-between gap-3">
                <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Annuaire développeurs publics</h2>
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-300">
                    {{ totalPublicPortfolios|default(publicPortfolios|length) }}
                </span>
            </div>

            {% if publicPortfolios is empty %}
                <p class="mt-4 text-[15px] text-slate-400">Aucun profil public n'est disponible pour le moment.</p>
            {% else %}
                <div class="mt-5 grid gap-4 sm:grid-cols-2">
                    {% for portfolio in publicPortfolios %}
                        {% set firstEducation = portfolio.education|first %}
                        {% set skillNames = [] %}
                        {% for profileSkill in portfolio.profileSkills|slice(0, 3) %}
                            {% if profileSkill.skill %}
                                {% set skillNames = skillNames|merge([profileSkill.skill.name]) %}
                            {% endif %}
                        {% endfor %}

                        {% set technologyNames = [] %}
                        {% for experience in portfolio.experiences %}
                            {% for technology in experience.technologies %}
                                {% if technology.name not in technologyNames %}
                                    {% set technologyNames = technologyNames|merge([technology.name]) %}
                                {% endif %}
                            {% endfor %}
                        {% endfor %}

                        <article class="rounded-2xl border border-white/10 bg-white/5 p-4 transition-all duration-300 hover:border-emerald-500/40 hover:bg-emerald-500/10">
                            <p class="text-[16px] font-semibold text-white">
                                {{ portfolio.firstName ?: 'Profil' }} {{ portfolio.lastName ?: '' }}
                            </p>
                            {% if portfolio.headline %}
                                <p class="mt-1 text-sm text-slate-400">{{ portfolio.headline }}</p>
                            {% endif %}

                            <div class="mt-4 space-y-2 text-sm text-slate-300">
                                {% if portfolio.experienceLevel %}
                                    <p>
                                        <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-300">
                                            {{ experienceLevelLabels[portfolio.experienceLevel.value] ?? portfolio.experienceLevel.value }}
                                        </span>
                                    </p>
                                {% endif %}
                                <div>
                                    {% if skillNames is not empty %}
                                        <div class="mt-2 flex flex-wrap gap-2">
                                            {% for skillName in skillNames %}
                                                <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-300">{{ skillName }}</span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                                <div>
                                    {% if technologyNames is not empty %}
                                        <div class="mt-2 flex flex-wrap gap-2">
                                            {% for technologyName in technologyNames|slice(0, 3) %}
                                                <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-300">{{ technologyName }}</span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <a href="{{ path('app_public_profile_show', { slug: portfolio.slug }) }}"
                               class="mt-4 inline-flex items-center text-xs font-semibold text-emerald-400 transition-colors duration-300 hover:text-emerald-300">
                                Voir profil →
                            </a>
                        </article>
                    {% endfor %}
                </div>

                {% if totalPages|default(1) > 1 %}
                    <div class="mt-6 flex items-center justify-between gap-3">
                        {% if currentPage|default(1) > 1 %}
                            <a href="{{ path('app_home', { page: currentPage - 1 }) }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10">
                                ← Page précédente
                            </a>
                        {% else %}
                            <span class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-500 opacity-60">
                                ← Page précédente
                            </span>
                        {% endif %}

                        <span class="text-sm font-medium text-slate-400">Page {{ currentPage|default(1) }} / {{ totalPages|default(1) }}</span>

                        {% if currentPage|default(1) < totalPages|default(1) %}
                            <a href="{{ path('app_home', { page: currentPage + 1 }) }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10">
                                Page suivante →
                            </a>
                        {% else %}
                            <span class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-500 opacity-60">
                                Page suivante →
                            </span>
                        {% endif %}
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </section>
{% endblock %}