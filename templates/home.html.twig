{% extends 'base.html.twig' %}

{% block title %}Accueil | DevSpot{% endblock %}

{% block body %}
    {% set experienceLevelLabels = {
        'intern': 'Stagiaire',
        'junior': 'Junior',
        'mid': 'Intermédiaire',
        'senior': 'Senior',
        'lead': 'Lead'
    } %}
    {% set featuredCards = publicPortfolios|slice(0, 6) %}
    {% set topMatches = [] %}
    {% for portfolio in publicPortfolios|slice(0, 8) %}
        {% set computedMatchScore = 98 - (loop.index0 * 3) %}
        {% if computedMatchScore >= 90 %}
            {% set topMatches = topMatches|merge([{ profile: portfolio, score: computedMatchScore }]) %}
        {% endif %}
    {% endfor %}

    <section class="w-full max-w-6xl space-y-8 font-sans">
        <article class="theme-settings-card rounded-[2.75rem] p-8 sm:p-10">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div class="max-w-2xl">
                    <p class="premium-kicker mb-4 inline-flex items-center rounded-full px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.24em]">
                        Espace candidat
                    </p>
                    <h1 class="ui-title text-4xl font-semibold tracking-tight">Bienvenue sur DevSpot.</h1>
                    <p class="ui-text-muted mt-2 text-[15px] leading-relaxed">
                        {% if app.user %}
                            Connecté en tant que <span class="ui-title font-semibold">{{ is_granted('ROLE_APPLICANT') ? 'candidat' : 'recruteur' }}</span>.
                        {% else %}
                            Complète ton profil développeur, rends ton portfolio public et démarre ton matching.
                        {% endif %}
                    </p>
                </div>

                <div class="premium-card-soft rounded-[1.75rem] p-4 text-sm sm:min-w-72">
                    <p class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Profils publics</p>
                    <p class="ui-title mt-1 text-2xl font-semibold">{{ totalPublicPortfolios }}</p>
                    <p class="ui-text-muted mt-2 text-xs">Annuaire actif et mis à jour automatiquement.</p>
                </div>
            </div>

            {% if not app.user %}
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href="{{ path('app_register') }}" class="ui-button-primary inline-flex items-center justify-center rounded-full px-6 py-3.5 text-[15px] font-bold active:scale-95">
                        Créer un compte
                    </a>
                    <a href="{{ path('app_login') }}" class="ui-button-secondary inline-flex items-center justify-center rounded-full px-6 py-3.5 text-[15px] font-semibold active:scale-95">
                        Se connecter
                    </a>
                </div>
            {% endif %}
        </article>

        <article class="theme-settings-card rounded-[2.35rem] p-6 sm:p-8">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Espace recruteur</h2>
                    <p class="ui-title mt-2 text-3xl font-semibold tracking-tight">Trouvez les candidats idéaux</p>
                    <p class="ui-text-muted mt-3 max-w-2xl text-[15px] leading-relaxed">
                        Découvrez des talents correspondant à vos offres d'emploi et générez un matching précis.
                    </p>
                </div>
                <span class="premium-kicker rounded-full px-3 py-1 text-xs font-semibold">
                    {{ totalPublicPortfolios }}
                </span>
            </div>

            <div class="mt-6 grid gap-2 sm:grid-cols-4">
                <span class="premium-kicker rounded-full px-3 py-2 text-xs font-semibold">Symfony</span>
                <span class="premium-kicker rounded-full px-3 py-2 text-xs font-semibold">PHP</span>
                <span class="premium-kicker rounded-full px-3 py-2 text-xs font-semibold">Remote</span>
                <span class="premium-kicker rounded-full px-3 py-2 text-xs font-semibold">Junior à Lead</span>
            </div>

            {% if featuredCards is empty %}
                <p class="ui-text-muted mt-6 text-[15px]">Aucun profil public n'est disponible pour le moment.</p>
            {% else %}
                <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-2">
                    {% for portfolio in featuredCards %}
                        {% set skillNames = [] %}
                        {% for profileSkill in portfolio.profileSkills|slice(0, 3) %}
                            {% if profileSkill.skill %}
                                {% set skillNames = skillNames|merge([profileSkill.skill.name]) %}
                            {% endif %}
                        {% endfor %}

                        <article class="premium-action-card group rounded-[1.75rem] p-5">
                            <div class="flex items-center gap-3">
                                {% if portfolio.avatarPath %}
                                    <img src="{{ asset(portfolio.avatarPath) }}" alt="Photo de {{ portfolio.firstName }}" class="h-12 w-12 rounded-xl border object-cover premium-divider">
                                {% else %}
                                    <img src="{{ asset('uploads/avatars/profil_vide.jpg') }}" alt="Photo par défaut" class="h-12 w-12 rounded-xl border object-cover premium-divider">
                                {% endif %}

                                <div class="min-w-0">
                                    <p class="ui-title truncate text-sm font-semibold">{{ portfolio.firstName ?: 'Profil' }} {{ portfolio.lastName ?: '' }}</p>
                                    <p class="ui-text-muted truncate text-xs">{{ portfolio.headline ?: 'Développeur web' }}</p>
                                </div>
                            </div>

                            <div class="mt-3 flex flex-wrap gap-2">
                                {% if portfolio.experienceLevel %}
                                    <span class="ui-pill ui-pill-info rounded-full px-2.5 py-1 text-[10px] font-semibold">
                                        {{ experienceLevelLabels[portfolio.experienceLevel.value] ?? portfolio.experienceLevel.value }}
                                    </span>
                                {% endif %}
                                {% for skillName in skillNames %}
                                    <span class="ui-pill ui-pill-warning rounded-full px-2.5 py-1 text-[10px] font-semibold">{{ skillName }}</span>
                                {% endfor %}
                            </div>

                            <div class="premium-divider mt-4 flex flex-wrap items-center gap-3 border-t pt-4">
                                <a href="{{ path('app_public_profile_show', { slug: portfolio.slug }) }}" class="ui-link-accent inline-flex items-center text-xs font-semibold">
                                    Voir profil →
                                </a>

                                {% if is_granted('ROLE_RECRUITER') %}
                                    {% include 'recruiter/_favorite_toggle.html.twig' with {
                                        profile: portfolio,
                                        isFavorite: portfolio.id in favoriteProfileIds|default([]),
                                        iconOnly: true,
                                        formClass: 'ml-auto'
                                    } only %}
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}

            {% if totalPages|default(1) > 1 %}
                <div class="premium-card-soft mt-6 flex items-center justify-between gap-3 rounded-[1.5rem] p-3">
                    {% if currentPage|default(1) > 1 %}
                        <a href="{{ path('app_home', { page: currentPage - 1 }) }}" class="ui-button-secondary inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-semibold">
                            ← Page précédente
                        </a>
                    {% else %}
                        <span class="ui-button-disabled inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-semibold opacity-60">
                            ← Page précédente
                        </span>
                    {% endif %}

                    <span class="ui-text-muted text-sm font-medium">Page {{ currentPage|default(1) }} / {{ totalPages|default(1) }}</span>

                    {% if currentPage|default(1) < totalPages|default(1) %}
                        <a href="{{ path('app_home', { page: currentPage + 1 }) }}" class="ui-button-secondary inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-semibold">
                            Page suivante →
                        </a>
                    {% else %}
                        <span class="ui-button-disabled inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-semibold opacity-60">
                            Page suivante →
                        </span>
                    {% endif %}
                </div>
            {% endif %}
        </article>

        {% if topMatches is not empty %}
            <article class="theme-settings-card rounded-[2.35rem] p-6 sm:p-8">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <h2 class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Top matchs</h2>
                        <p class="ui-title mt-2 text-2xl font-semibold tracking-tight">Top matchs selon vos offres</p>
                    </div>
                    <span class="premium-kicker rounded-full px-3 py-1 text-xs font-semibold">
                        {{ topMatches|length }}
                    </span>
                </div>

                <div class="mt-6 grid gap-4 md:grid-cols-3">
                    {% for topMatch in topMatches %}
                        {% set portfolio = topMatch.profile %}
                        {% set topMatchScore = topMatch.score %}
                        <article class="premium-action-card group rounded-[1.75rem] p-5">
                            <div class="flex items-center gap-3">
                                {% if portfolio.avatarPath %}
                                    <img src="{{ asset(portfolio.avatarPath) }}" alt="Photo de {{ portfolio.firstName }}" class="h-12 w-12 rounded-xl border object-cover premium-divider">
                                {% else %}
                                    <img src="{{ asset('uploads/avatars/profil_vide.jpg') }}" alt="Photo par défaut" class="h-12 w-12 rounded-xl border object-cover premium-divider">
                                {% endif %}

                                <div class="min-w-0">
                                    <p class="ui-title truncate text-sm font-semibold">{{ portfolio.firstName ?: 'Profil' }} {{ portfolio.lastName ?: '' }}</p>
                                    <p class="ui-text-muted truncate text-xs">{{ portfolio.headline ?: 'Développeur web' }}</p>
                                </div>
                            </div>

                            <div class="premium-card-soft mt-4 flex items-center justify-between rounded-[1.25rem] px-3 py-2">
                                <span class="text-xs font-semibold uppercase tracking-wider">Score match</span>
                                <span class="text-lg font-semibold">{{ topMatchScore }}%</span>
                            </div>

                            <div class="premium-divider mt-4 flex flex-wrap items-center gap-3 border-t pt-4">
                                <a href="{{ path('app_public_profile_show', { slug: portfolio.slug }) }}" class="ui-link-accent inline-flex items-center text-xs font-semibold">
                                    Voir profil →
                                </a>

                                {% if is_granted('ROLE_RECRUITER') %}
                                    {% include 'recruiter/_favorite_toggle.html.twig' with {
                                        profile: portfolio,
                                        isFavorite: portfolio.id in favoriteProfileIds|default([]),
                                        iconOnly: true,
                                        formClass: 'ml-auto'
                                    } only %}
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </article>
        {% endif %}
    </section>
{% endblock %}
