{% extends 'base.html.twig' %}

{% block title %}Conversations recruteur | DevSpot{% endblock %}

{% block body %}
    <section class="w-[min(92rem,calc(100vw-1.5rem))] self-start font-sans h-[calc(100vh-10rem)]">
        <div class="grid h-full grid-cols-1 gap-4 overflow-hidden rounded-[2rem] border border-white/10 bg-slate-900/60 p-4 shadow-2xl shadow-black/50 backdrop-blur-xl xl:grid-cols-3">
            <aside class="flex h-full min-h-0 flex-col rounded-2xl border border-white/10 bg-white p-3">
                <div class="mb-3 flex items-center justify-between gap-3 border-b border-white/10 px-2 pb-3">
                    <h1 class="text-base font-semibold text-white">Messages privés</h1>
                </div>

                <div class="min-h-0 flex-1 space-y-2 overflow-y-auto pr-1">
                    {% if conversations is empty %}
                        <p class="rounded-xl border border-blue-200 bg-blue-50 px-3 py-2 text-sm text-blue-700">Aucune conversation active.</p>
                    {% else %}
                        {% for row in conversations %}
                            {% set conversation = row.conversation %}
                            {% set profile = row.developerProfile %}
                            {% set applicantName = (profile and profile.public) ? (profile.firstName ~ ' ' ~ profile.lastName) : 'Postulant anonyme' %}
                            {% set active = selectedConversation and selectedConversation.id == conversation.id %}

                            <a href="{{ path('app_recruiter_message_show', {conversationId: conversation.id}) }}" class="block rounded-xl border px-3 py-2.5 transition {{ active ? 'border-blue-300 bg-blue-100/70 shadow-sm' : 'border-blue-200 bg-white hover:border-blue-300 hover:bg-blue-50' }}">
                                <div class="flex items-start justify-between gap-2">
                                    <p class="truncate text-sm font-semibold text-slate-800">{{ applicantName }}</p>
                                    {% if row.unreadCount > 0 %}
                                        <span class="inline-flex min-h-5 min-w-5 items-center justify-center rounded-full bg-blue-600 px-1.5 text-[11px] font-bold text-white">{{ row.unreadCount }}</span>
                                    {% endif %}
                                </div>
                                <div class="mt-1 flex items-end justify-between gap-2">
                                    <p class="min-w-0 truncate text-xs text-slate-600">{{ row.lastMessage.content|replace({'\n': ' '}) }}</p>
                                    <span class="shrink-0 text-[11px] text-slate-500">{{ row.lastMessage.createdAt|date('H:i') }}</span>
                                </div>
                            </a>
                        {% endfor %}
                    {% endif %}
                </div>
            </aside>

            <div class="flex h-full min-h-0 flex-col rounded-2xl border border-white/10 bg-white xl:col-span-2">
                {% if selectedConversation and selectedProfile %}
                    {% set applicantName = selectedProfile.public ? (selectedProfile.firstName ~ ' ' ~ selectedProfile.lastName) : 'Postulant anonyme' %}
                    <header class="flex items-center justify-between border-b border-white/10 px-5 py-3">
                        <div class="min-w-0">
                            <div class="flex items-center gap-3">
                                <div class="h-10 w-10 overflow-hidden rounded-full border border-blue-200 bg-blue-50">
                                    {% if selectedProfile.avatarPath %}
                                        <img src="{{ asset(selectedProfile.avatarPath) }}" alt="Avatar de {{ applicantName }}" class="h-full w-full object-cover">
                                    {% else %}
                                        <img src="{{ asset('uploads/avatars/profil_vide.jpg') }}" alt="Avatar par défaut" class="h-full w-full object-cover">
                                    {% endif %}
                                </div>
                                <h2 class="truncate text-base font-semibold text-slate-800">{{ applicantName }}</h2>
                            </div>
                        </div>
                    </header>

                    {% set lastMessageId = selectedMessages is not empty ? selectedMessages|last.id : 0 %}
                    <div
                        id="chat-messages"
                        data-chat-scroll="true"
                        data-poll-url="{{ path('app_recruiter_message_poll', {conversationId: selectedConversation.id}) }}"
                        data-last-message-id="{{ lastMessageId }}"
                        class="min-h-0 flex-1 space-y-3 overflow-y-auto px-5 py-4"
                    >
                        {% for message in selectedMessages %}
                            {% include 'recruiter/_chat_message.html.twig' with {
                                message: message,
                                mine: message.senderUser and app.user and message.senderUser.id == app.user.id
                            } only %}
                        {% endfor %}
                    </div>

                    {% if replyForm %}
                        <div class="border-t border-white/10 bg-white p-3">
                            {{ form_start(replyForm, {attr: {class: 'space-y-2', id: 'chat-form'}}) }}
                                <div class="relative">
                                    {{ form_widget(replyForm.content, {attr: {class: 'h-11 w-full rounded-full border border-blue-200 bg-white py-2 pl-4 pr-14 text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-0', placeholder: 'Envoyer un message...'}}) }}
                                    <button type="submit" class="absolute right-1.5 top-1/2 inline-flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-blue-200 bg-blue-100 text-blue-800 transition hover:bg-blue-200" aria-label="Envoyer le message">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m5 12 14-7-4 7 4 7-14-7Z" />
                                        </svg>
                                    </button>
                                </div>
                                {{ form_errors(replyForm.content) }}
                            {{ form_end(replyForm) }}
                        </div>
                    {% endif %}
                {% else %}
                    <div class="flex h-full min-h-[420px] items-center justify-center px-6 text-center text-slate-300">
                        Sélectionnez une conversation à gauche.
                    </div>
                {% endif %}
            </div>

        </div>

        <script>
            (() => {
                const chatMessages = document.getElementById('chat-messages');
                const chatForm = document.getElementById('chat-form');
                if (!chatMessages) {
                    return;
                }

                const scrollToBottom = () => {
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                };

                const getLastId = () => Number(chatMessages.dataset.lastMessageId || 0);
                const setLastIdFromDom = () => {
                    const all = chatMessages.querySelectorAll('.js-chat-message[data-message-id]');
                    const last = all.length ? Number(all[all.length - 1].dataset.messageId || 0) : 0;
                    chatMessages.dataset.lastMessageId = String(last);
                };

                scrollToBottom();

                if (chatForm) {
                    chatForm.addEventListener('submit', async (event) => {
                        event.preventDefault();

                        const input = chatForm.querySelector('input[name$="[content]"]');
                        const submit = chatForm.querySelector('button[type="submit"]');
                        if (!input || !submit || !input.value.trim()) {
                            return;
                        }

                        submit.disabled = true;
                        try {
                            const response = await fetch(chatForm.action, {
                                method: 'POST',
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest',
                                },
                                body: new FormData(chatForm),
                            });

                            if (!response.ok) {
                                return;
                            }

                            const payload = await response.json();
                            if (payload && payload.ok && payload.html) {
                                chatMessages.insertAdjacentHTML('beforeend', payload.html);
                                setLastIdFromDom();
                                input.value = '';
                                scrollToBottom();
                            }
                        } finally {
                            submit.disabled = false;
                        }
                    });
                }

                const pollUrl = chatMessages.dataset.pollUrl;
                if (!pollUrl) {
                    return;
                }

                let polling = false;
                const poll = async () => {
                    if (polling) {
                        return;
                    }

                    polling = true;
                    try {
                        const response = await fetch(`${pollUrl}?sinceId=${encodeURIComponent(getLastId())}`, {
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                        });

                        if (!response.ok) {
                            return;
                        }

                        const payload = await response.json();
                        if (payload && payload.ok && payload.html) {
                            chatMessages.insertAdjacentHTML('beforeend', payload.html);
                            setLastIdFromDom();
                            scrollToBottom();
                        }
                    } finally {
                        polling = false;
                    }
                };

                window.setInterval(poll, 3500);
            })();
        </script>
    </section>
{% endblock %}
