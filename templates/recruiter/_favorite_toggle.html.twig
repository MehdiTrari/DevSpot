{% set redirectPath = redirectPath|default(app.request.requestUri) %}
{% set isFavorite = isFavorite|default(false) %}
{% set formClass = formClass|default('') %}
{% set addButtonClass = addButtonClass|default('inline-flex items-center justify-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-semibold text-emerald-300 transition-all duration-300 hover:bg-emerald-500/15 active:scale-95') %}
{% set removeButtonClass = removeButtonClass|default('inline-flex items-center justify-center rounded-full border border-red-500/30 bg-red-500/10 px-4 py-2 text-sm font-semibold text-red-300 transition-all duration-300 hover:bg-red-500/15 active:scale-95') %}
{% set addLabel = addLabel|default('Ajouter aux favoris') %}
{% set removeLabel = removeLabel|default('Retirer des favoris') %}
{% set iconOnly = iconOnly|default(false) %}
{% set iconButtonClass = iconButtonClass|default('inline-flex h-10 w-10 items-center justify-center rounded-full border transition-all duration-300 active:scale-95') %}
{% set removeCardOnRemove = removeCardOnRemove|default(false) %}

{% if profile is defined and profile.id is not null %}
    {% set addUrl = path('app_recruiter_favorite_add', {id: profile.id}) %}
    {% set removeUrl = path('app_recruiter_favorite_remove', {id: profile.id}) %}
    {% set addToken = csrf_token('favorite_add_' ~ profile.id) %}
    {% set removeToken = csrf_token('favorite_remove_' ~ profile.id) %}
    {% set addResolvedButtonClass = iconOnly ? iconButtonClass ~ ' border-white/15 bg-white/5 text-slate-300 hover:border-emerald-500/30 hover:bg-emerald-500/10 hover:text-emerald-300' : addButtonClass %}
    {% set removeResolvedButtonClass = iconOnly ? iconButtonClass ~ ' border-red-500/30 bg-red-500/10 text-red-300 hover:bg-red-500/15' : removeButtonClass %}
    {% set currentAction = isFavorite ? 'remove' : 'add' %}
    {% set currentLabel = isFavorite ? removeLabel : addLabel %}
    {% set currentUrl = isFavorite ? removeUrl : addUrl %}
    {% set currentToken = isFavorite ? removeToken : addToken %}
    {% set currentButtonClass = isFavorite ? removeResolvedButtonClass : addResolvedButtonClass %}

    <form
        method="post"
        action="{{ currentUrl }}"
        class="{{ formClass }}"
        data-favorite-toggle="true"
        data-favorite-profile-id="{{ profile.id }}"
        data-favorite-icon-only="{{ iconOnly ? '1' : '0' }}"
        data-favorite-add-url="{{ addUrl }}"
        data-favorite-remove-url="{{ removeUrl }}"
        data-favorite-add-token="{{ addToken }}"
        data-favorite-remove-token="{{ removeToken }}"
        data-favorite-add-label="{{ addLabel }}"
        data-favorite-remove-label="{{ removeLabel }}"
        data-favorite-add-button-class="{{ addResolvedButtonClass }}"
        data-favorite-remove-button-class="{{ removeResolvedButtonClass }}"
        data-favorite-remove-card-on-remove="{{ removeCardOnRemove ? '1' : '0' }}"
    >
        <input type="hidden" name="_token" data-favorite-token="true" value="{{ currentToken }}">
        <input type="hidden" name="_redirect" value="{{ redirectPath }}">
        <button type="submit" data-favorite-button="true" data-favorite-action="{{ currentAction }}" class="{{ currentButtonClass }}" aria-label="{{ currentLabel }}" title="{{ currentLabel }}">
            <span data-favorite-content="true">
                {% if iconOnly %}
                    {% if isFavorite %}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                            <path d="M11.645 20.91a.75.75 0 0 0 .71 0c1.055-.518 9.145-4.707 9.145-11.41A5.25 5.25 0 0 0 12 6.084 5.25 5.25 0 0 0 2.5 9.5c0 6.703 8.09 10.892 9.145 11.41Z" />
                        </svg>
                    {% else %}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m12 20.25-.32-.17C9.24 18.8 3 15.37 3 9.75A4.5 4.5 0 0 1 7.5 5.25c1.74 0 3.16.81 4.5 2.09 1.34-1.28 2.76-2.09 4.5-2.09A4.5 4.5 0 0 1 21 9.75c0 5.62-6.24 9.05-8.68 10.33L12 20.25Z" />
                        </svg>
                    {% endif %}
                {% else %}
                    {{ currentLabel }}
                {% endif %}
            </span>
        </button>
    </form>
{% endif %}
