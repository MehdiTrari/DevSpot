{% extends 'base.html.twig' %}

{% form_theme form 'form/my_theme.html.twig' %}

{% block title %}Modifier une offre | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-3xl rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:shadow-emerald-500/10 sm:p-10">
        <div class="mb-8">
            <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                Offre recruteur
            </p>
            <h1 class="text-3xl font-semibold tracking-tight text-white">Modifier l'offre</h1>
            <p class="mt-2 text-[15px] text-slate-400">Mets a jour les informations de l'annonce pour qu'elle reste claire et a jour.</p>
        </div>

        <div class="mb-8 flex items-start gap-3 rounded-2xl border border-white/10 bg-white/5 px-5 py-4">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>
            </svg>
            <p class="text-sm leading-relaxed text-slate-400">Les champs marques d'une <span class="text-rose-300">*</span> sont obligatoires. Les changements sont pris en compte des la sauvegarde.</p>
        </div>

        {% if form.vars.errors|length > 0 %}
            <div class="mb-6 rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-3.5 text-[15px] font-medium text-red-400 animate-fade-in-down">
                {{ form_errors(form) }}
            </div>
        {% endif %}

        {{ form_start(form, { attr: { class: 'space-y-8', id: 'recruiter-offer-form', novalidate: 'novalidate' } }) }}
            <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
                <div class="mb-6">
                    <h2 class="text-xl font-semibold tracking-tight text-white">Presentation du poste</h2>
                    <p class="mt-2 text-sm text-slate-400">Mets a jour le contexte, les missions et le profil recherche.</p>
                </div>

                {{ form_row(form.title, { attr: { placeholder: 'Ex : Developpeur Symfony Senior' } }) }}
                {{ form_row(form.description, { attr: { class: 'min-h-[140px]', placeholder: 'Precise le contexte, les missions, la stack, les attentes et les points forts du poste.' } }) }}
            </div>

            <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
                <div class="mb-6">
                    <h2 class="text-xl font-semibold tracking-tight text-white">Cadre de travail</h2>
                    <p class="mt-2 text-sm text-slate-400">Ajuste la localisation, le mode de travail et le niveau d'experience attendu.</p>
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    {{ form_row(form.location, { attr: { placeholder: 'Paris, Lyon, France entiere...' } }) }}
                    {{ form_row(form.locationType) }}
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    {{ form_row(form.contractType) }}
                    {{ form_row(form.experienceLevel, { attr: { placeholder: 'Ex : 3' } }) }}
                </div>
            </div>

            <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
                <div class="mb-6">
                    <h2 class="text-xl font-semibold tracking-tight text-white">Remuneration et diffusion</h2>
                    <p class="mt-2 text-sm text-slate-400">Mets a jour la fourchette salariale, la date limite et le statut.</p>
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    {{ form_row(form.salaryMin) }}
                    {{ form_row(form.salaryMax) }}
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    {{ form_row(form.applicationDeadline) }}
                    {{ form_row(form.status) }}
                </div>
            </div>

            <div class="mt-10 rounded-[2rem] border p-5 shadow-xl dashboard-actions-card">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <p class="max-w-2xl text-sm leading-relaxed dashboard-actions-text">
                        Tu peux revenir au detail de l'offre ou enregistrer tes modifications.
                    </p>
                    <div class="flex flex-col-reverse gap-3 sm:flex-row">
                        <a href="{{ path('app_recruiter_offer_detail', { id: offer.id }) }}" class="inline-flex items-center justify-center rounded-full border px-5 py-3 text-center text-[13px] font-semibold whitespace-nowrap transition dashboard-exit-secondary">
                            Retour au detail
                        </a>
                        <button type="submit" class="inline-flex items-center justify-center rounded-full border px-6 py-3 text-center text-[13px] font-bold whitespace-nowrap transition dashboard-actions-next-success">
                            Enregistrer les modifications
                        </button>
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    </section>

    <style>
        .dashboard-actions-card {
            border-color: var(--ui-panel-border);
            background: var(--ui-panel-bg);
            box-shadow: 0 18px 40px rgba(var(--indeed-shadow-rgb), 0.18);
        }

        .dashboard-actions-text {
            color: var(--ui-text-muted);
        }

        .dashboard-exit-secondary {
            border-color: var(--ui-button-secondary-border);
            background: var(--ui-button-secondary-bg);
            color: var(--ui-button-secondary-text);
        }

        .dashboard-exit-secondary:hover {
            background: var(--ui-button-secondary-hover);
        }

        .dashboard-actions-next-success {
            border-color: var(--ui-success-border);
            background: var(--ui-success-bg);
            color: var(--ui-success-text-muted);
            box-shadow: 0 10px 22px rgba(var(--indeed-shadow-rgb), 0.12);
        }

        .dashboard-actions-next-success:hover {
            filter: brightness(0.98);
        }
    </style>
{% endblock %}
