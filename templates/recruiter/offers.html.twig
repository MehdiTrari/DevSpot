{% extends 'base.html.twig' %}

{% block title %}Mes offres | DevSpot{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            const pct = (v) => typeof v === 'number' ? `${v.toFixed(1)}%` : '-';
            const esc = (v) => String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
            const nextFrame = () => new Promise(resolve => requestAnimationFrame(() => resolve()));

            const initCards = () => {
                document.querySelectorAll('[data-offer-card]').forEach(card => {
                    if (card.dataset.init === '1') return;
                    card.dataset.init = '1';

                    const endpoint = card.dataset.offerEndpoint;
                    const detailUrl = card.dataset.offerDetailUrl;
                    const btn = card.querySelector('[data-offer-btn]');
                    const dropdown = card.querySelector('[data-offer-dropdown]');
                    const dropdownBody = card.querySelector('[data-offer-dropdown-body]');
                    const progressWrap = card.querySelector('[data-offer-progress]');
                    const progressBar = card.querySelector('[data-offer-progress-bar]');
                    const progressLabel = card.querySelector('[data-offer-progress-label]');
                    const clickZone = card.querySelector('[data-offer-click-zone]');

                    if (!endpoint || !btn) return;

                    /* Navigate to detail page when clicking card header */
                    if (clickZone && detailUrl) {
                        clickZone.style.cursor = 'pointer';
                        clickZone.addEventListener('click', (e) => {
                            if (e.target.closest('button') || e.target.closest('a')) return;
                            window.location.href = detailUrl;
                        });
                    }

                    let loaded = false, open = false, loading = false;
                    let timer = null, prog = 0;

                    const setProgress = (v, label) => {
                        prog = v;
                        if (!progressWrap || !progressBar || !progressLabel) return;
                        const safeValue = Math.max(0, Math.min(100, Number(v) || 0));
                        progressWrap.classList.remove('hidden', 'opacity-0');
                        progressBar.style.display = 'block';
                        progressBar.style.opacity = '1';
                        progressBar.style.minWidth = safeValue > 0 ? '0.75rem' : '0';
                        progressBar.style.width = safeValue > 0 ? `max(${safeValue}%, 0.75rem)` : '0%';
                        progressBar.style.background = 'linear-gradient(90deg, rgb(5 150 105) 0%, rgb(52 211 153) 55%, rgb(110 231 183) 100%)';
                        progressBar.style.boxShadow = safeValue >= 100 ? '0 0 20px rgba(16,185,129,.5)' : 'none';
                        progressLabel.textContent = `${label} ${safeValue}%`;
                    };
                    const resetProgress = async () => {
                        if (!progressWrap || !progressBar || !progressLabel) return;
                        progressWrap.classList.remove('hidden', 'opacity-0', 'transition-opacity', 'duration-700');
                        progressBar.style.display = 'block';
                        progressBar.style.opacity = '1';
                        progressBar.style.minWidth = '0';
                        progressBar.style.width = '0%';
                        progressBar.style.boxShadow = 'none';
                        progressLabel.textContent = 'Préparation... 0%';
                        await nextFrame();
                        await nextFrame();
                    };
                    const startTimer = () => { timer = setInterval(() => { const nv = Math.min(prog + (prog < 50 ? 7 : 3), 88); setProgress(nv, nv < 40 ? 'Analyse...' : 'Scoring...'); }, 320); };
                    const stopTimer = () => { if (timer) { clearInterval(timer); timer = null; } };

                    const updateBtn = () => {
                        if (!loaded) { btn.innerHTML = 'Calculer le matching'; return; }
                        btn.textContent = open ? '\u25B2 Masquer le top 5' : '\u25BC Voir le top 5';
                    };
                    updateBtn();

                    btn.addEventListener('click', async (e) => {
                        e.preventDefault();
                        e.stopPropagation();

                        if (loaded) {
                            open = !open;
                            dropdown.classList.toggle('hidden', !open);
                            updateBtn();
                            return;
                        }

                        if (loading) return;
                        loading = true;
                        btn.disabled = true;
                        btn.classList.add('opacity-60','cursor-not-allowed');

                        await resetProgress();
                        setProgress(5, 'Preparation...');
                        startTimer();

                        try {
                            const resp = await fetch(endpoint, { headers: { Accept: 'application/json' }, credentials: 'same-origin' });
                            const data = await resp.json();
                            if (!resp.ok) throw new Error(data.message || `HTTP ${resp.status}`);

                            stopTimer();
                            setProgress(100, 'Termine !');

                            const top5 = (data.matches || []).slice(0, 5);
                            if (!dropdownBody) return;
                            dropdownBody.innerHTML = '';

                            if (top5.length === 0) {
                                dropdownBody.innerHTML = '<p class="px-4 py-3 text-sm text-slate-500">Aucun profil correspondant.</p>';
                            } else {
                                top5.forEach((m, i) => {
                                    const link = m.profileUrl ? `<a href="${esc(m.profileUrl)}" class="text-emerald-300 hover:underline">${esc(m.fullName||'Profil')}</a>` : esc(m.fullName||'Profil');
                                    dropdownBody.insertAdjacentHTML('beforeend', `
                                        <div class="flex items-center justify-between gap-4 rounded-xl border border-white/5 bg-white/[.02] px-4 py-3 transition hover:bg-white/5">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-300">${i+1}</span>
                                                <div class="min-w-0">
                                                    <p class="truncate text-sm font-semibold text-white">${link}</p>
                                                    <p class="truncate text-xs text-slate-400">${esc(m.headline||'')}</p>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-3 shrink-0">
                                                <div class="text-right">
                                                    <p class="text-[10px] uppercase tracking-wider text-emerald-400/70">DevSpot</p>
                                                    <p class="text-sm font-bold text-emerald-300">${pct(m.semanticEnrichedPercentage)}</p>
                                                </div>
                                                <div class="text-right">
                                                    <p class="text-[10px] uppercase tracking-wider text-violet-400/70">CamemBERT</p>
                                                    <p class="text-sm font-semibold text-violet-300">${pct(m.semanticPercentage)}</p>
                                                </div>
                                            </div>
                                        </div>
                                    `);
                                });
                            }

                            const badge = card.querySelector('[data-offer-top-badge]');
                            if (badge && data.topMatchPercentage != null) {
                                badge.textContent = pct(data.topMatchPercentage);
                            }

                            if (detailUrl && top5.length > 0) {
                                dropdownBody.insertAdjacentHTML('beforeend', `
                                    <a href="${esc(detailUrl)}" class="mt-2 flex items-center justify-center gap-2 rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-2.5 text-sm font-semibold text-emerald-300 transition hover:bg-emerald-500/20">
                                        Voir tous les resultats (${data.matchesCount} profils) &rarr;
                                    </a>
                                `);
                            }

                            dropdown.classList.remove('hidden');
                            loaded = true;
                            open = true;
                            updateBtn();

                            setTimeout(() => { if (progressWrap) { progressWrap.classList.add('opacity-0','transition-opacity','duration-700'); setTimeout(() => progressWrap.classList.add('hidden'), 800); } }, 1200);

                        } catch (err) {
                            stopTimer();
                            setProgress(100, 'Erreur.');
                            if (dropdownBody) {
                                dropdown.classList.remove('hidden');
                                dropdownBody.innerHTML = `<div class="rounded-xl border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-sm text-rose-200">${esc(String(err))}</div>`;
                            }
                        } finally {
                            loading = false;
                            btn.disabled = false;
                            btn.classList.remove('opacity-60','cursor-not-allowed');
                        }
                    });
                });
            };

            document.addEventListener('DOMContentLoaded', initCards);
            document.addEventListener('turbo:load', initCards);
        })();
    </script>
{% endblock %}

{% block body %}
    <section class="w-full max-w-5xl space-y-8 font-sans">
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <p class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-300">Espace recruteur</p>
                    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white">Mes offres</h1>
                    <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-slate-400">Clique sur une offre pour voir sa description et tous les matchings, ou utilise le bouton pour un apercu rapide du top 5.</p>
                </div>
                <a href="{{ path('app_recruiter_home') }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10">&larr; Dashboard</a>
            </div>
        </div>

        <div class="space-y-4">
            {% for job in offerRows %}
                <article
                    data-offer-card
                    data-offer-endpoint="{{ path('app_recruiter_offer_matching', { id: job.id }) }}"
                    data-offer-detail-url="{{ job.detailUrl }}"
                    class="group rounded-[2rem] border border-white/10 bg-slate-900/50 shadow-2xl shadow-black/40 backdrop-blur-xl transition hover:border-emerald-400/20 hover:shadow-emerald-500/10"
                >
                    {# Clickable zone navigates to detail page #}
                    <div data-offer-click-zone class="p-6 transition hover:bg-slate-900/60 rounded-t-[2rem]">
                        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                            <div>
                                <div class="flex items-center gap-3">
                                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Offre #{{ job.id }}</p>
                                    <span class="inline-flex items-center rounded-full border {{ job.isActive ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-300' : 'border-yellow-400/20 bg-yellow-400/10 text-yellow-300' }} px-2.5 py-0.5 text-[10px] font-semibold">{{ job.status }}</span>
                                </div>
                                <h2 class="mt-2 text-2xl font-semibold text-white group-hover:text-emerald-200 transition-colors">{{ job.title }}</h2>
                                <div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-300">
                                    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{{ job.contract }}</span>
                                    {% if job.location %}
                                        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{{ job.location }}</span>
                                    {% endif %}
                                    {% if job.updatedAt %}
                                        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{{ job.updatedAt|date('d/m/Y') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="rounded-2xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-right">
                                    <p class="text-[10px] uppercase tracking-wider text-emerald-200/70">Top DevSpot</p>
                                    <p data-offer-top-badge class="mt-1 text-lg font-bold text-white">{{ job.topMatchPercentage is not null ? job.topMatchPercentage|number_format(1, '.', ' ') ~ '%' : '—' }}</p>
                                </div>
                                {% if job.cachedAt is defined and job.cachedAt %}
                                    <span class="inline-flex items-center gap-1 rounded-full border border-amber-500/20 bg-amber-500/10 px-2.5 py-1 text-[10px] font-semibold text-amber-300" title="Résultats en cache">
                                        <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                                        En cache
                                    </span>
                                {% endif %}
                                <svg class="h-5 w-5 text-slate-500 group-hover:text-emerald-400 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
                            </div>
                        </div>
                    </div>

                    {# Action bar #}
                    <div class="border-t border-white/5 px-6 py-3 flex items-center justify-between">
                        <button type="button" data-offer-btn class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-semibold text-emerald-300 transition hover:bg-emerald-500/20 hover:border-emerald-400/40">
                            &#9889; Calculer le matching
                        </button>
                        <a href="{{ job.detailUrl }}" class="text-xs font-medium text-slate-500 hover:text-emerald-300 transition">Voir le detail &rarr;</a>
                    </div>

                    {# Progress bar #}
                    <div data-offer-progress class="hidden px-6 pb-4">
                        <div class="flex items-center justify-between px-1">
                            <p class="text-xs font-semibold uppercase tracking-wider text-emerald-300">Matching en cours</p>
                            <p data-offer-progress-label class="text-xs font-medium text-emerald-200/80">0%</p>
                        </div>
                        <div class="mt-1.5 h-3.5 overflow-hidden rounded-full border border-emerald-500/30 bg-slate-950/80 shadow-inner">
                            <div data-offer-progress-bar class="h-full rounded-full bg-gradient-to-r from-emerald-600 via-emerald-400 to-emerald-300 transition-all duration-300 ease-out" style="width:0%"></div>
                        </div>
                    </div>

                    {# Collapsible dropdown top 5 #}
                    <div data-offer-dropdown class="hidden border-t border-white/5">
                        <div class="px-6 py-2">
                            <p class="text-[10px] font-semibold uppercase tracking-widest text-emerald-400/60">Top 5 des profils correspondants</p>
                        </div>
                        <div data-offer-dropdown-body class="space-y-1 px-6 pb-5"></div>
                    </div>
                </article>
            {% else %}
                <div class="rounded-[2rem] border border-dashed border-white/10 bg-slate-900/30 px-6 py-10 text-center text-slate-400">
                    Aucune offre recruteur a afficher pour le moment.
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
