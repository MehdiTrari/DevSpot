{% extends 'base.html.twig' %}

{% block title %}{{ offer.title }} | DevSpot{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            const ENDPOINT = {{ matchingEndpoint|json_encode|raw }};
            const CONTACT_ENDPOINT = {{ matchingContactEndpoint|json_encode|raw }};
            const CONTACT_CSRF = {{ matchingContactCsrfToken|json_encode|raw }};
            const OFFER_TITLE = {{ offer.title|json_encode|raw }};
            const DEFAULT_RECRUITER_NAME = {{ app.user and app.user.recruiterProfile ? ((app.user.recruiterProfile.firstName ~ ' ' ~ app.user.recruiterProfile.lastName)|trim)|json_encode|raw : '""' }};
            const DEFAULT_RECRUITER_EMAIL = {{ app.user and app.user.email ? app.user.email|json_encode|raw : '""' }};
            const PER_PAGE = 10;
            const CACHED_DATA = {{ cachedMatching|default('null')|raw }};
            const nextFrame = () => new Promise(resolve => requestAnimationFrame(() => resolve()));

            let allData = null;
            let currentPage = 1;
            let totalPages = 1;
            let loading = false;
            let currentMatches = [];
            let activeContactMatch = null;

            const $ = (sel, ctx) => (ctx || document).querySelector(sel);
            const escapeHtml = (v) => String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
            const pct = (v) => typeof v === 'number' ? `${v.toFixed(1)}%` : '-';
            const num = (v) => typeof v === 'number' ? v.toFixed(2) : '-';

            const tonePanel = 'border-color: var(--ui-panel-border); background: var(--ui-panel-bg); color: var(--ui-text-primary);';
            const toneMuted = 'color: var(--ui-text-muted);';
            const toneSuccess = 'border-color: var(--ui-success-border); background: var(--ui-success-bg); color: var(--ui-success-text);';
            const toneWarning = 'border-color: var(--ui-warning-border); background: var(--ui-warning-bg); color: var(--ui-warning-text);';
            const toneDanger = 'border-color: var(--ui-danger-border); background: var(--ui-danger-bg); color: var(--ui-danger-text);';
            const toneInfo = 'border-color: var(--ui-info-border); background: var(--ui-info-bg); color: var(--ui-info-text);';
            const renderTags = (values, style) => values.map(v => `<span class="rounded-full border px-3 py-1 text-xs font-semibold" style="${style}">${escapeHtml(v)}</span>`).join('');
            const renderTechTags = (values) => values.map(i => `<span class="rounded-full border px-3 py-1 text-xs font-semibold" style="${toneSuccess}">${escapeHtml(i.skill||'')} · ${escapeHtml(i.level||'')}</span>`).join('');

            /* ---------- Progress bar ---------- */
            let timer = null, prog = 0;
            const setProgress = (value, label) => {
                prog = value;
                const bar = $('#matching-progress-bar');
                const lbl = $('#matching-progress-label');
                const wrap = $('#matching-progress');
                if (!bar || !lbl || !wrap) return;
                const safeValue = Math.max(0, Math.min(100, Number(value) || 0));
                wrap.classList.remove('hidden', 'opacity-0');
                bar.style.display = 'block';
                bar.style.opacity = '1';
                bar.style.minWidth = safeValue > 0 ? '0.75rem' : '0';
                bar.style.width = safeValue > 0 ? `max(${safeValue}%, 0.75rem)` : '0%';
                bar.style.background = 'var(--ui-progress-fill)';
                bar.style.boxShadow = safeValue >= 100 ? 'var(--ui-progress-glow)' : 'none';
                lbl.textContent = `${label} ${safeValue}%`;
            };
            const resetProgress = async () => {
                const bar = $('#matching-progress-bar');
                const lbl = $('#matching-progress-label');
                const wrap = $('#matching-progress');
                if (!bar || !lbl || !wrap) return;
                wrap.classList.remove('hidden', 'opacity-0', 'transition-opacity', 'duration-700');
                bar.style.display = 'block';
                bar.style.opacity = '1';
                bar.style.minWidth = '0';
                bar.style.width = '0%';
                bar.style.boxShadow = 'none';
                lbl.textContent = 'Préparation du matching… 0%';
                await nextFrame();
                await nextFrame();
            };
            const startTimer = () => { timer = setInterval(() => { const nv = Math.min(prog + (prog < 50 ? 7 : 3), 88); setProgress(nv, nv < 40 ? 'Analyse des profils publics…' : 'Calcul des scores sémantiques…'); }, 320); };
            const stopTimer = () => { if (timer !== null) { clearInterval(timer); timer = null; } };

            /* ---------- Heart icons ---------- */
            const outlinedHeart = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="m12 20.25-.32-.17C9.24 18.8 3 15.37 3 9.75A4.5 4.5 0 0 1 7.5 5.25c1.74 0 3.16.81 4.5 2.09 1.34-1.28 2.76-2.09 4.5-2.09A4.5 4.5 0 0 1 21 9.75c0 5.62-6.24 9.05-8.68 10.33L12 20.25Z"/></svg>`;
            const filledHeart = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M11.645 20.91a.75.75 0 0 0 .71 0c1.055-.518 9.145-4.707 9.145-11.41A5.25 5.25 0 0 0 12 6.084 5.25 5.25 0 0 0 2.5 9.5c0 6.703 8.09 10.892 9.145 11.41Z"/></svg>`;

            const favBtn = (m) => {
                if (!m.developerId || !m.favoriteAddUrl) return '';
                const isFav = m.isFavorite;
                const tone = isFav ? toneDanger : 'border-color: var(--ui-panel-border); background: var(--ui-panel-bg); color: var(--ui-text-muted);';
                return `<button type="button" data-fav-dev="${m.developerId}" data-is-fav="${isFav?'1':'0'}" data-add-url="${escapeHtml(m.favoriteAddUrl)}" data-remove-url="${escapeHtml(m.favoriteRemoveUrl)}" data-add-token="${escapeHtml(m.favoriteAddToken)}" data-remove-token="${escapeHtml(m.favoriteRemoveToken)}" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border transition-all duration-300 active:scale-90" style="${tone}" title="${isFav?'Retirer des favoris':'Ajouter aux favoris'}">${isFav?filledHeart:outlinedHeart}</button>`;
            };

            const contactBtn = (m, index) => {
                if (!m.canContact || !m.contactToken) return '';

                return `<button type="button" data-contact-index="${index}" class="inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-semibold transition" style="${toneSuccess}">Contacter ce profil</button>`;
            };

            /* ---------- Render one match card ---------- */
            const matchCard = (m, rank, index) => {
                const hardSkills = Array.isArray(m.matchedHardSkills) ? m.matchedHardSkills : [];
                const softSkills = Array.isArray(m.matchedSoftSkills) ? m.matchedSoftSkills : [];
                const inferredTech = Array.isArray(m.inferredTechnicalSkills) ? m.inferredTechnicalSkills : [];
                const inferredSoft = Array.isArray(m.inferredSoftSkills) ? m.inferredSoftSkills : [];
                const inferredTransf = Array.isArray(m.inferredTransferableSkills) ? m.inferredTransferableSkills : [];
                const title = m.revealed
                    ? (m.profileUrl ? `<a href="${escapeHtml(m.profileUrl)}" class="hover:text-emerald-300 underline underline-offset-2">${escapeHtml(m.fullName||'Profil')}</a>` : escapeHtml(m.fullName||'Profil'))
                    : escapeHtml(m.candidateLabel || 'Candidat');
                const subtitle = m.revealed
                    ? escapeHtml(m.headline || '')
                    : 'Identité masquée jusqu’au premier contact.';
                const action = m.revealed
                    ? (m.conversationUrl ? `<a href="${escapeHtml(m.conversationUrl)}" class="inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-semibold transition" style="${tonePanel}">Ouvrir la conversation</a>` : '')
                    : contactBtn(m, index);

                return `
                <article class="rounded-[1.5rem] border p-5 transition" style="border-color: var(--ui-panel-border); background: var(--ui-panel-bg);">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                        <div class="flex items-start gap-3">
                            ${m.revealed ? favBtn(m) : ''}
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--ui-success-text);">#${rank}</p>
                                <h3 class="mt-2 text-lg font-semibold" style="color: var(--ui-heading);">${title}</h3>
                                <p class="mt-1 text-sm" style="color: var(--ui-text-secondary);">${subtitle}</p>
                                <p class="mt-2 text-xs" style="color: var(--ui-text-muted);">${escapeHtml(String(m.yearsExperience??0))} an(s) d'expérience</p>
                                <div class="mt-3">${action}</div>
                            </div>
                        </div>
                        <div class="grid gap-2 sm:grid-cols-3">
                            <div class="rounded-2xl border px-4 py-3 text-right" style="${toneSuccess}">
                                <p class="text-xs uppercase tracking-wider">Matching DevSpot</p>
                                <p class="mt-1 text-sm font-bold">${pct(m.semanticEnrichedPercentage)}</p>
                            </div>
                            <div class="rounded-2xl border px-4 py-3 text-right" style="${toneInfo}">
                                <p class="text-xs uppercase tracking-wider">CamemBERT</p>
                                <p class="mt-1 text-sm font-semibold">${pct(m.semanticPercentage)}</p>
                            </div>
                            <div class="rounded-2xl border px-4 py-3 text-right" style="${tonePanel}">
                                <p class="text-xs uppercase tracking-wider" style="${toneMuted}">Baseline</p>
                                <p class="mt-1 text-sm font-semibold" style="color: var(--ui-text-primary);">${pct(m.percentage)}</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 grid gap-4 lg:grid-cols-2">
                        <div class="rounded-2xl border p-4" style="border-color: var(--ui-panel-border); background: var(--ui-panel-subtle-bg);">
                            <p class="text-xs font-semibold uppercase tracking-wider" style="${toneMuted}">Compétences correspondantes</p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                ${renderTags(hardSkills, toneSuccess)}
                                ${renderTags(softSkills, toneInfo)}
                                ${hardSkills.length===0&&softSkills.length===0?'<span class="text-sm" style="color: var(--ui-text-muted);">Aucune correspondance directe détectée.</span>':''}
                            </div>
                        </div>
                        <div class="rounded-2xl border p-4" style="border-color: var(--ui-panel-border); background: var(--ui-panel-subtle-bg);">
                            <p class="text-xs font-semibold uppercase tracking-wider" style="${toneMuted}">Compétences inférées</p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                ${renderTags(inferredSoft, toneInfo)}
                                ${renderTags(inferredTransf, toneWarning)}
                                ${renderTechTags(inferredTech)}
                                ${inferredSoft.length===0&&inferredTransf.length===0&&inferredTech.length===0?'<span class="text-sm" style="color: var(--ui-text-muted);">Aucune compétence implicite détectée.</span>':''}
                            </div>
                        </div>
                    </div>
                </article>`;
            };

            /* ---------- Render pagination ---------- */
            const renderPagination = () => {
                const wrap = $('#matching-pagination');
                if (!wrap) return;
                if (totalPages <= 1) { wrap.innerHTML = ''; return; }

                let html = '<nav class="flex items-center justify-center gap-2 pt-2">';
                html += `<button data-page="${currentPage-1}" ${currentPage<=1?'disabled':''} class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10 disabled:opacity-30 disabled:cursor-not-allowed">← Préc.</button>`;

                const maxVisible = 5;
                let start = Math.max(1, currentPage - Math.floor(maxVisible/2));
                let end = Math.min(totalPages, start + maxVisible - 1);
                if (end - start < maxVisible - 1) start = Math.max(1, end - maxVisible + 1);

                if (start > 1) {
                    html += `<button data-page="1" class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-white hover:bg-white/10">1</button>`;
                    if (start > 2) html += '<span class="text-slate-500 px-1">…</span>';
                }
                for (let p = start; p <= end; p++) {
                    const active = p === currentPage;
                    html += `<button data-page="${p}" class="rounded-full border ${active?'border-emerald-400/40 bg-emerald-500/20 text-emerald-300':'border-white/10 bg-white/5 text-white hover:bg-white/10'} px-3 py-1.5 text-sm font-semibold">${p}</button>`;
                }
                if (end < totalPages) {
                    if (end < totalPages - 1) html += '<span class="text-slate-500 px-1">…</span>';
                    html += `<button data-page="${totalPages}" class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-white hover:bg-white/10">${totalPages}</button>`;
                }

                html += `<button data-page="${currentPage+1}" ${currentPage>=totalPages?'disabled':''} class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10 disabled:opacity-30 disabled:cursor-not-allowed">Suiv. →</button>`;
                html += '</nav>';
                wrap.innerHTML = html;

                wrap.querySelectorAll('button[data-page]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const p = parseInt(btn.dataset.page, 10);
                        if (p >= 1 && p <= totalPages && p !== currentPage) loadPage(p);
                    });
                });
            };

            /* ---------- Render summary ---------- */
            const renderSummary = (data) => {
                const s = $('#matching-summary');
                if (!s) return;
                s.classList.remove('hidden');
                $('#summary-top-score').textContent = pct(data.topMatchPercentage);
                $('#summary-fairness').textContent = num(data?.enriched?.fairness?.disparate_impact_ratio);
                $('#summary-count').textContent = `${data.matchesCount} profils`;
                $('#summary-pages').textContent = `Page ${data.page} / ${data.totalPages}`;

                // Show cache indicator
                const cacheEl = $('#summary-cache');
                if (cacheEl && data.cachedAt) {
                    const ago = Math.round((Date.now() - new Date(data.cachedAt).getTime()) / 60000);
                    cacheEl.textContent = ago < 1 ? 'À l\u2019instant' : `Il y a ${ago} min`;
                    cacheEl.closest('[data-cache-card]')?.classList.remove('hidden');
                }
            };

            /* ---------- Wire favorite buttons ---------- */
            const wireFavButtons = (container) => {
                container.querySelectorAll('[data-fav-dev]').forEach(b => {
                    if (b.dataset.favInit === '1') return;
                    b.dataset.favInit = '1';
                    b.addEventListener('click', async (ev) => {
                        ev.preventDefault();
                        ev.stopPropagation();
                        const isFav = b.dataset.isFav === '1';
                        const url = isFav ? b.dataset.removeUrl : b.dataset.addUrl;
                        const token = isFav ? b.dataset.removeToken : b.dataset.addToken;
                        b.disabled = true;
                        b.classList.add('opacity-50','cursor-not-allowed');
                        try {
                            const fd = new FormData();
                            fd.append('_token', token);
                            fd.append('_redirect', window.location.pathname);
                            const r = await fetch(url, { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'}, body:fd, credentials:'same-origin' });
                            const p = await r.json().catch(()=>({}));
                            if (r.ok && p.success) {
                                const nowFav = p.isFavorite === true;
                                b.dataset.isFav = nowFav ? '1' : '0';
                                b.title = nowFav ? 'Retirer des favoris' : 'Ajouter aux favoris';
                                b.className = `inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border transition-all duration-300 active:scale-90 ${nowFav ? 'border-red-500/30 bg-red-500/10 text-red-300 hover:bg-red-500/15' : 'border-white/15 bg-white/5 text-slate-300 hover:border-emerald-500/30 hover:bg-emerald-500/10 hover:text-emerald-300'}`;
                                b.innerHTML = nowFav ? filledHeart : outlinedHeart;
                                if (typeof pushNotification === 'function') pushNotification(p.message || 'Favoris mis à jour.', p.type || 'success');
                            } else {
                                if (typeof pushNotification === 'function') pushNotification(p?.message || 'Action impossible.', 'error');
                            }
                        } catch(_) {
                            if (typeof pushNotification === 'function') pushNotification('Erreur réseau.', 'error');
                        } finally {
                            b.disabled = false;
                            b.classList.remove('opacity-50','cursor-not-allowed');
                        }
                    });
                });
            };

            const resetContactStatus = () => {
                const status = $('#matching-contact-status');
                if (status) {
                    status.className = 'hidden rounded-2xl border px-4 py-3 text-sm';
                    status.textContent = '';
                }

                document.querySelectorAll('[data-error-for]').forEach(node => {
                    node.textContent = '';
                    node.classList.add('hidden');
                });
            };

            const setContactStatus = (message, tone = 'error') => {
                const status = $('#matching-contact-status');
                if (!status) return;

                const palette = tone === 'success'
                    ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-100'
                    : 'border-rose-500/20 bg-rose-500/10 text-rose-100';

                status.className = `rounded-2xl border px-4 py-3 text-sm ${palette}`;
                status.textContent = message;
            };

            const showContactErrors = (errors = {}) => {
                Object.entries(errors).forEach(([field, messages]) => {
                    const node = document.querySelector(`[data-error-for="${field}"]`);
                    if (!node) return;
                    node.textContent = Array.isArray(messages) ? messages.join(' ') : String(messages || '');
                    node.classList.remove('hidden');
                });
            };

            const openContactModal = (match) => {
                activeContactMatch = match;
                resetContactStatus();

                $('#matching-contact-target').textContent = match.candidateLabel || 'Candidat';
                $('#matching-contact-token').value = match.contactToken || '';
                $('#matching-contact-recruiter-name').value = DEFAULT_RECRUITER_NAME || '';
                $('#matching-contact-recruiter-email').value = DEFAULT_RECRUITER_EMAIL || '';
                $('#matching-contact-subject').value = OFFER_TITLE ? `À propos de ${OFFER_TITLE}` : '';
                $('#matching-contact-message').value = '';

                const modal = $('#matching-contact-modal');
                if (!modal) return;

                modal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
                setTimeout(() => $('#matching-contact-message')?.focus(), 0);
            };

            const closeContactModal = () => {
                activeContactMatch = null;
                const modal = $('#matching-contact-modal');
                if (modal) modal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            };

            const mergeRevealedMatch = (revealedMatch) => {
                if (!activeContactMatch) return;

                const mergeOne = (match) => {
                    if ((activeContactMatch.contactToken && match.contactToken === activeContactMatch.contactToken) || match.candidateLabel === activeContactMatch.candidateLabel) {
                        const merged = {
                            ...match,
                            ...revealedMatch,
                            revealed: true,
                            canContact: false,
                        };
                        delete merged.contactToken;

                        return merged;
                    }

                    return match;
                };

                currentMatches = currentMatches.map(mergeOne);

                if (allData && Array.isArray(allData.matches)) {
                    allData.matches = allData.matches.map(mergeOne);
                }
            };

            const wireContactButtons = (container) => {
                container.querySelectorAll('[data-contact-index]').forEach(button => {
                    if (button.dataset.contactInit === '1') return;
                    button.dataset.contactInit = '1';

                    button.addEventListener('click', () => {
                        const index = parseInt(button.dataset.contactIndex || '', 10);
                        const match = Number.isNaN(index) ? null : currentMatches[index] || null;
                        if (!match) return;
                        openContactModal(match);
                    });
                });
            };

            const wireContactModal = () => {
                const modal = $('#matching-contact-modal');
                const form = $('#matching-contact-form');
                const closeButtons = modal ? modal.querySelectorAll('[data-close-contact-modal]') : [];
                const submitButton = $('#matching-contact-submit');

                if (!modal || !form || form.dataset.init === '1') return;
                form.dataset.init = '1';

                closeButtons.forEach(button => button.addEventListener('click', closeContactModal));
                modal.addEventListener('click', (event) => {
                    if (event.target === modal) {
                        closeContactModal();
                    }
                });
                document.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
                        closeContactModal();
                    }
                });

                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    resetContactStatus();

                    if (!activeContactMatch) {
                        setContactStatus('Aucun profil à contacter.');

                        return;
                    }

                    submitButton.disabled = true;
                    submitButton.classList.add('opacity-60', 'cursor-not-allowed');

                    try {
                        const response = await fetch(CONTACT_ENDPOINT, {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                            credentials: 'same-origin',
                            body: JSON.stringify({
                                _token: CONTACT_CSRF,
                                contactToken: $('#matching-contact-token').value,
                                recruiterName: $('#matching-contact-recruiter-name').value,
                                recruiterEmail: $('#matching-contact-recruiter-email').value,
                                subject: $('#matching-contact-subject').value,
                                message: $('#matching-contact-message').value,
                            }),
                        });

                        const payload = await response.json().catch(() => ({}));

                        if (response.status === 422) {
                            setContactStatus(payload.message || 'Le formulaire contient des erreurs.');
                            showContactErrors(payload.errors || {});

                            return;
                        }

                        if (!response.ok || payload.success !== true) {
                            setContactStatus(payload.message || 'Envoi impossible.');

                            return;
                        }

                        mergeRevealedMatch(payload.match || {});
                        renderMatches(currentMatches, (currentPage - 1) * PER_PAGE);
                        closeContactModal();

                        if (typeof pushNotification === 'function') {
                            pushNotification(payload.message || 'Votre message a bien été envoyé au développeur.', 'success');
                        }
                    } catch (_) {
                        setContactStatus('Erreur réseau.');
                    } finally {
                        submitButton.disabled = false;
                        submitButton.classList.remove('opacity-60', 'cursor-not-allowed');
                    }
                });
            };

            /* ---------- Render matches ---------- */
            const renderMatches = (matches, pageOffset) => {
                const container = $('#matching-results');
                if (!container) return;
                currentMatches = Array.isArray(matches) ? matches.map(match => ({ ...match })) : [];
                container.innerHTML = '';
                if (!currentMatches.length) {
                    container.innerHTML = '<div class="rounded-2xl border border-dashed border-white/10 bg-slate-950/30 px-4 py-5 text-sm text-slate-500">Aucun profil correspondant.</div>';
                    return;
                }
                currentMatches.forEach((m, i) => container.insertAdjacentHTML('beforeend', matchCard(m, pageOffset + i + 1, i)));
                wireFavButtons(container);
                wireContactButtons(container);
            };

            /* ---------- Load a page ---------- */
            const loadPage = async (page) => {
                if (loading) return;
                loading = true;

                const container = $('#matching-results');
                if (container) container.innerHTML = '<div class="py-10 text-center text-sm text-slate-400">Chargement…</div>';

                try {
                    const sep = ENDPOINT.includes('?') ? '&' : '?';
                    const resp = await fetch(`${ENDPOINT}${sep}page=${page}`, { headers: { Accept: 'application/json' }, credentials: 'same-origin' });
                    const data = await resp.json();
                    if (!resp.ok) throw new Error(data.message || `HTTP ${resp.status}`);

                    currentPage = data.page;
                    totalPages = data.totalPages;
                    allData = data;
                    renderSummary(data);
                    renderMatches(data.matches || [], (currentPage - 1) * PER_PAGE);
                    renderPagination();

                    /* scroll to results */
                    const anchor = $('#matching-section');
                    if (anchor) anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
                } catch (err) {
                    if (container) container.innerHTML = `<div class="rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-5 text-sm text-rose-100">${escapeHtml(String(err))}</div>`;
                } finally {
                    loading = false;
                }
            };

            /* ---------- Initial load (first page) ---------- */
            const init = () => {
                const btn = $('#btn-launch-matching');
                const refreshBtn = $('#btn-refresh-matching');
                if (!btn || btn.dataset.init === '1') return;
                btn.dataset.init = '1';

                // If we have cached data, auto-display it
                if (CACHED_DATA) {
                    currentPage = CACHED_DATA.page;
                    totalPages = CACHED_DATA.totalPages;
                    allData = CACHED_DATA;

                    btn.classList.add('hidden');
                    if (refreshBtn) refreshBtn.classList.remove('hidden');
                    $('#matching-section').classList.remove('hidden');

                    renderSummary(CACHED_DATA);
                    renderMatches(CACHED_DATA.matches || [], (currentPage - 1) * PER_PAGE);
                    renderPagination();
                }

                // Launch fresh matching
                const launchMatching = async (isRefresh) => {
                    if (loading) return;
                    const activeBtn = isRefresh ? refreshBtn : btn;
                    if (activeBtn) {
                        activeBtn.disabled = true;
                        activeBtn.classList.add('opacity-60','cursor-not-allowed');
                    }
                    loading = true;

                    await resetProgress();
                    setProgress(5, 'Préparation du matching…');
                    startTimer();

                    try {
                        const refreshParam = isRefresh ? '&refresh=1' : '';
                        const resp = await fetch(`${ENDPOINT}?page=1${refreshParam}`, { headers: { Accept: 'application/json' }, credentials: 'same-origin' });
                        const data = await resp.json();
                        if (!resp.ok) throw new Error(data.message || `HTTP ${resp.status}`);

                        stopTimer();
                        setProgress(100, 'Matching terminé !');

                        currentPage = data.page;
                        totalPages = data.totalPages;
                        allData = data;

                        btn.classList.add('hidden');
                        if (refreshBtn) refreshBtn.classList.remove('hidden');
                        $('#matching-section').classList.remove('hidden');

                        renderSummary(data);
                        renderMatches(data.matches || [], 0);
                        renderPagination();

                        setTimeout(() => { const p = $('#matching-progress'); if (p) p.classList.add('opacity-0','transition-opacity','duration-700'); setTimeout(() => { if (p) p.classList.add('hidden'); }, 800); }, 1500);
                    } catch (err) {
                        stopTimer();
                        setProgress(100, 'Erreur.');
                        const container = $('#matching-results');
                        if (container) {
                            $('#matching-section').classList.remove('hidden');
                            container.innerHTML = `<div class="rounded-2xl border border-rose-500/20 bg-rose-500/10 px-4 py-5 text-sm text-rose-100">${escapeHtml(String(err))}</div>`;
                        }
                    } finally {
                        loading = false;
                        if (activeBtn) {
                            activeBtn.disabled = false;
                            activeBtn.classList.remove('opacity-60','cursor-not-allowed');
                        }
                    }
                };

                btn.addEventListener('click', () => launchMatching(false));
                if (refreshBtn) refreshBtn.addEventListener('click', () => launchMatching(true));
                wireContactModal();
            };

            document.addEventListener('DOMContentLoaded', init);
            document.addEventListener('turbo:load', init);
        })();
    </script>
{% endblock %}

{% block body %}
    <section class="w-full max-w-5xl space-y-8 font-sans">

        {# ── Header ── #}
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <p class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-300">Détail de l'offre</p>
                    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white">{{ offer.title }}</h1>
                    <div class="mt-3 flex flex-wrap gap-2 text-xs">
                        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300">
                            {% if offer.contractType %}
                                {{ offer.contractType.value == 'full_time' ? 'Temps plein' :
                                   offer.contractType.value == 'part_time' ? 'Temps partiel' :
                                   offer.contractType.value == 'permanent' ? 'CDI' :
                                   offer.contractType.value == 'fixed_term' ? 'CDD' :
                                   offer.contractType.value == 'internship' ? 'Stage' :
                                   offer.contractType.value == 'apprenticeship' ? 'Alternance' :
                                   offer.contractType.value == 'freelance' ? 'Freelance' :
                                   offer.contractType.value == 'contract' ? 'Contrat' : 'Non défini' }}
                            {% else %}
                                Type non défini
                            {% endif %}
                        </span>
                        {% if offer.location %}
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300">{{ offer.location }}</span>
                        {% endif %}
                        {% if offer.locationType %}
                            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300">{{ offer.locationType.value|capitalize }}</span>
                        {% endif %}
                        <span class="ui-pill inline-flex items-center rounded-full px-3 py-1 font-semibold {{ offer.isActive ? 'ui-pill-success' : 'ui-pill-warning' }}">{{ offer.isActive ? 'Publiée' : 'Brouillon' }}</span>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <a href="{{ path('app_recruiter_offer_edit', { id: offer.id }) }}" class="inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-semibold transition" style="border-color: var(--ui-success-border); background: var(--ui-success-bg); color: var(--ui-success-text);">Modifier</a>
                    <form method="post" action="{{ path('app_recruiter_offer_delete', { id: offer.id }) }}" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('offer_delete_' ~ offer.id) }}">
                        <button type="submit" class="inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-semibold transition" style="border-color: var(--ui-danger-border); background: var(--ui-danger-bg); color: var(--ui-danger-text);" onclick="return confirm('Supprimer cette offre ? Cette action est définitive.')">Supprimer</button>
                    </form>
                    <a href="{{ path('app_recruiter_offers') }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10">Retour</a>
                </div>
            </div>
        </div>

        {# ── Offer details ── #}
        <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
            <h2 class="text-xl font-semibold text-white">Description de l'offre</h2>
            <div class="mt-4 prose prose-sm prose-invert max-w-none text-slate-300 leading-relaxed whitespace-pre-line">{{ offer.description }}</div>

            <div class="mt-6 grid gap-4 sm:grid-cols-3">
                <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                    <p class="text-xs uppercase tracking-wider text-slate-400">Date limite</p>
                    <p class="mt-2 text-sm font-semibold text-white">{{ offer.applicationDeadline ? offer.applicationDeadline|date('d/m/Y') : 'Non définie' }}</p>
                </div>
                {% if offer.experienceLevel is not null %}
                    <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                        <p class="text-xs uppercase tracking-wider text-slate-400">Expérience requise</p>
                        <p class="mt-2 text-sm font-semibold text-white">{{ offer.experienceLevel }} an(s)</p>
                    </div>
                {% endif %}
                {% if offer.salaryMin or offer.salaryMax %}
                    <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                        <p class="text-xs uppercase tracking-wider text-slate-400">Salaire</p>
                        <p class="mt-2 text-sm font-semibold text-white">
                            {% if offer.salaryMin and offer.salaryMax %}
                                {{ offer.salaryMin|number_format(0, ',', ' ') }} – {{ offer.salaryMax|number_format(0, ',', ' ') }} €
                            {% elseif offer.salaryMin %}
                                À partir de {{ offer.salaryMin|number_format(0, ',', ' ') }} €
                            {% else %}
                                Jusqu'à {{ offer.salaryMax|number_format(0, ',', ' ') }} €
                            {% endif %}
                        </p>
                    </div>
                {% endif %}
                <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                    <p class="text-xs uppercase tracking-wider text-slate-400">Mise à jour</p>
                    <p class="mt-2 text-sm font-semibold text-white">{{ offer.updatedAt|date('d/m/Y à H:i') }}</p>
                </div>
            </div>
        </div>

        {# ── Launch matching ── #}
        <div class="flex flex-col items-center gap-4">
            <button
                id="btn-launch-matching"
                type="button"
                class="group relative inline-flex items-center gap-3 rounded-full px-8 py-3.5 text-base font-bold transition active:scale-[.97]"
                style="background: var(--ui-button-primary-bg); color: var(--ui-button-primary-text); box-shadow: var(--premium-section-shadow);"
            >
                Calcul du matching
            </button>
            <button
                id="btn-refresh-matching"
                type="button"
                class="hidden group relative inline-flex items-center gap-2 rounded-full border px-6 py-2.5 text-sm font-semibold transition active:scale-[.97]"
                style="border-color: var(--ui-success-border); background: var(--ui-success-bg); color: var(--ui-success-text);"
            >
                Recalculer le matching
            </button>

            {# Progress bar — video-game style #}
            <div id="matching-progress" class="hidden w-full max-w-2xl">
                <div class="flex items-center justify-between px-1">
                    <p class="text-xs font-semibold uppercase tracking-wider text-emerald-300">Matching en cours</p>
                    <p id="matching-progress-label" class="text-xs font-medium text-emerald-200/80">En attente 0%</p>
                </div>
                <div class="mt-2 h-4 overflow-hidden rounded-full border shadow-inner" style="border-color: var(--ui-success-border); background: var(--ui-panel-bg);">
                    <div
                        id="matching-progress-bar"
                        class="h-full rounded-full transition-all duration-300 ease-out"
                        style="width:0%"
                    ></div>
                </div>
            </div>
        </div>

        {# ── Matching results section (hidden until loaded) ── #}
        <div id="matching-section" class="hidden space-y-6">

            {# Summary cards #}
            <div id="matching-summary" class="rounded-[1.5rem] border border-emerald-500/20 bg-emerald-500/10 p-5">
                <div class="grid gap-3 sm:grid-cols-5">
                    <div class="rounded-2xl border border-white/10 bg-slate-950/40 px-4 py-3">
                        <p class="text-xs uppercase tracking-wider text-slate-400">Top Matching DevSpot</p>
                        <p id="summary-top-score" class="mt-2 text-lg font-semibold text-white">-</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-slate-950/40 px-4 py-3">
                        <p class="text-xs uppercase tracking-wider text-slate-400">Fairness ratio</p>
                        <p id="summary-fairness" class="mt-2 text-lg font-semibold text-white">-</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-slate-950/40 px-4 py-3">
                        <p class="text-xs uppercase tracking-wider text-slate-400">Total profils</p>
                        <p id="summary-count" class="mt-2 text-lg font-semibold text-white">-</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-slate-950/40 px-4 py-3">
                        <p class="text-xs uppercase tracking-wider text-slate-400">Pagination</p>
                        <p id="summary-pages" class="mt-2 text-lg font-semibold text-white">-</p>
                    </div>
                    <div data-cache-card class="hidden rounded-2xl border border-amber-500/20 bg-amber-500/10 px-4 py-3">
                        <p class="text-xs uppercase tracking-wider text-amber-300/80">Cache</p>
                        <p id="summary-cache" class="mt-2 text-lg font-semibold text-amber-200">-</p>
                    </div>
                </div>
            </div>

            {# Match cards #}
            <div id="matching-results" class="space-y-3"></div>

            {# Pagination #}
            <div id="matching-pagination" class="pb-4"></div>
        </div>

        <div id="matching-contact-modal" class="hidden fixed inset-0 z-50 bg-slate-950/80 px-4 py-8 backdrop-blur-sm">
            <div class="mx-auto flex min-h-full max-w-2xl items-center justify-center">
                <div class="w-full rounded-[2rem] border border-white/10 bg-slate-900/95 p-6 shadow-2xl shadow-black/50 sm:p-8">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-emerald-300">Premier contact</p>
                            <h2 class="mt-2 text-2xl font-semibold text-white" id="matching-contact-target">Candidat</h2>
                            <p class="mt-2 text-sm text-slate-400">L’identité complète sera révélée après l’envoi du message.</p>
                        </div>
                        <button type="button" data-close-contact-modal class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-slate-300 transition hover:bg-white/10">✕</button>
                    </div>

                    <form id="matching-contact-form" class="mt-6 space-y-4">
                        <input type="hidden" id="matching-contact-token" name="contactToken">

                        <div id="matching-contact-status" class="hidden rounded-2xl border px-4 py-3 text-sm"></div>

                        <div>
                            <label for="matching-contact-recruiter-name" class="mb-2 block text-sm font-semibold text-white">Nom</label>
                            <input id="matching-contact-recruiter-name" name="recruiterName" type="text" class="w-full rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-white outline-none transition focus:border-emerald-400/40">
                            <p data-error-for="recruiterName" class="mt-2 hidden text-sm text-rose-300"></p>
                        </div>

                        <div>
                            <label for="matching-contact-recruiter-email" class="mb-2 block text-sm font-semibold text-white">Email</label>
                            <input id="matching-contact-recruiter-email" name="recruiterEmail" type="email" class="w-full rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-white outline-none transition focus:border-emerald-400/40">
                            <p data-error-for="recruiterEmail" class="mt-2 hidden text-sm text-rose-300"></p>
                        </div>

                        <div>
                            <label for="matching-contact-subject" class="mb-2 block text-sm font-semibold text-white">Sujet</label>
                            <input id="matching-contact-subject" name="subject" type="text" class="w-full rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-white outline-none transition focus:border-emerald-400/40">
                            <p data-error-for="subject" class="mt-2 hidden text-sm text-rose-300"></p>
                        </div>

                        <div>
                            <label for="matching-contact-message" class="mb-2 block text-sm font-semibold text-white">Message</label>
                            <textarea id="matching-contact-message" name="message" rows="6" maxlength="5000" class="w-full rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-white outline-none transition focus:border-emerald-400/40"></textarea>
                            <p data-error-for="message" class="mt-2 hidden text-sm text-rose-300"></p>
                        </div>

                        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                            <button type="button" data-close-contact-modal class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">Annuler</button>
                            <button id="matching-contact-submit" type="submit" class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-5 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-emerald-500/25 transition hover:bg-emerald-400">Envoyer le message</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
