{% set conversation = row.conversation %}
{% set profile = row.developerProfile %}
{% set applicantName = (profile and profile.public) ? (profile.firstName ~ ' ' ~ profile.lastName) : 'Postulant anonyme' %}
{% set active = selectedConversationId is defined and selectedConversationId == conversation.id %}

<div id="conversation-row-{{ conversation.id }}" data-conversation-id="{{ conversation.id }}">
    <a
        href="{{ path('app_recruiter_message_show', {conversationId: conversation.id}) }}"
        data-turbo="false"
        data-chat-conversation-link="true"
        data-chat-active-class="border-blue-300 bg-blue-100/80"
        data-chat-inactive-class="border-blue-100 bg-white hover:border-blue-200 hover:bg-blue-50"
        class="block rounded-xl border px-3 py-2.5 transition {{ active ? 'border-blue-300 bg-blue-100/80' : 'border-blue-100 bg-white hover:border-blue-200 hover:bg-blue-50' }}"
    >
        <div class="flex items-start justify-between gap-2">
            <p class="truncate text-sm font-semibold text-slate-800">{{ applicantName }}</p>
            {% if row.unreadCount > 0 %}
                <span class="inline-flex min-h-5 min-w-5 items-center justify-center rounded-full bg-blue-600 px-1.5 text-[11px] font-bold text-white">{{ row.unreadCount }}</span>
            {% endif %}
        </div>
        <div class="mt-1 flex items-end justify-between gap-2">
            <p class="min-w-0 truncate text-xs text-slate-600">{{ row.lastMessage.content|replace({'\n': ' '}) }}</p>
            <span class="shrink-0 text-[11px] text-slate-500">{{ row.lastMessage.createdAt|date('H:i') }}</span>
        </div>
    </a>
</div>
