<div id="chat-message-{{ message.id }}" class="js-chat-message flex items-end gap-2 {{ mine ? 'justify-end' : 'justify-start' }}" data-message-id="{{ message.id }}">
    <div class="max-w-[78%] rounded-2xl px-4 py-2.5 {{ mine ? 'ui-chat-bubble-me' : 'ui-chat-bubble-other' }}">
        <p class="whitespace-pre-line break-words text-sm">{{ message.content }}</p>
        <p class="mt-1 text-right text-[11px] {{ mine ? 'ui-chat-meta-me' : 'ui-chat-meta-other' }}">{{ message.createdAt|date('H:i') }}</p>
    </div>
</div>
