<div id="chat-message-{{ message.id }}" class="js-chat-message flex items-end gap-2 {{ mine ? 'justify-end' : 'justify-start' }}" data-message-id="{{ message.id }}">
    <div class="max-w-[78%] rounded-2xl px-4 py-2.5 {{ mine ? 'bg-emerald-500/90 text-slate-950' : 'bg-slate-800 text-slate-100' }}">
        <p class="whitespace-pre-line text-sm break-words">{{ message.content }}</p>
        <p class="mt-1 text-right text-[11px] {{ mine ? 'text-slate-900/70' : 'text-slate-400' }}">{{ message.createdAt|date('H:i') }}</p>
    </div>
</div>
