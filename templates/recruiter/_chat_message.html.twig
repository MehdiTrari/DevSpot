<div class="js-chat-message flex items-end gap-2 {{ mine ? 'justify-end' : 'justify-start' }}" data-message-id="{{ message.id }}">
    <div class="max-w-[78%] rounded-2xl px-4 py-2.5 {{ mine ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-900' }}">
        <p class="whitespace-pre-line text-sm break-words">{{ message.content }}</p>
        <p class="mt-1 text-right text-[11px] {{ mine ? 'text-blue-100/80' : 'text-slate-500' }}">{{ message.createdAt|date('H:i') }}</p>
    </div>
</div>
