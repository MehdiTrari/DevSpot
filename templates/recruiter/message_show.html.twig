{% extends 'base.html.twig' %}

{% block title %}Conversation recruteur | DevSpot{% endblock %}

{% block body %}
    {% set applicantName = profile.public ? (profile.firstName ~ ' ' ~ profile.lastName) : 'Postulant anonyme' %}

    <section class="w-full max-w-6xl space-y-8 font-sans">
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                        Conversation
                    </p>
                    <h1 class="text-3xl font-semibold tracking-tight text-white">{{ applicantName }}</h1>
                    <p class="mt-2 text-[15px] text-slate-300">{{ conversation.subject ?: 'Conversation' }}</p>
                    <p class="mt-1 text-[15px] text-slate-400">{{ profile.headline ?: 'Profil développeur' }}</p>
                </div>

                <a href="{{ path('app_recruiter_messages') }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[15px] font-semibold tracking-tight text-white shadow-lg backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105 hover:bg-white/10 hover:shadow-blue-500/20 active:scale-95">
                    Retour aux conversations
                </a>
            </div>
        </div>

        <article class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
            <div class="space-y-4">
                {% for message in messages %}
                    {% set isRecruiterMessage = message.senderUser and app.user and message.senderUser.id == app.user.id %}
                    <div class="flex {{ isRecruiterMessage ? 'justify-end' : 'justify-start' }}">
                        <div class="max-w-[85%] rounded-2xl border px-4 py-3 {{ isRecruiterMessage ? 'border-blue-300 bg-blue-500/15 text-blue-50' : 'border-white/10 bg-white/5 text-slate-100' }}">
                            <p class="text-xs font-semibold uppercase tracking-wider {{ isRecruiterMessage ? 'text-blue-200' : 'text-slate-400' }}">{{ isRecruiterMessage ? 'Vous' : applicantName }}</p>
                            <p class="mt-2 whitespace-pre-line text-sm leading-relaxed">{{ message.content }}</p>
                            <p class="mt-2 text-right text-xs {{ isRecruiterMessage ? 'text-blue-200/80' : 'text-slate-500' }}">{{ message.createdAt|date('d/m/Y H:i') }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="mt-6 border-t border-white/10 pt-6">
                {{ form_start(replyForm, {attr: {class: 'space-y-3'}}) }}
                    {{ form_row(replyForm.content, {
                        attr: {
                            class: 'min-h-[120px]',
                            placeholder: 'Écrivez votre réponse...'
                        }
                    }) }}
                    <div class="flex justify-end">
                        <button type="submit" class="inline-flex items-center justify-center rounded-full bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-500/20 transition-all duration-300 hover:scale-[1.02] hover:bg-blue-500 active:scale-95">
                            Envoyer
                        </button>
                    </div>
                {{ form_end(replyForm) }}
            </div>
        </article>
    </section>
{% endblock %}
