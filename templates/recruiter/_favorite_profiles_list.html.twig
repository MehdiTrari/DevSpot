{% set favoriteProfiles = favoriteProfiles|default([]) %}
{% set redirectPath = redirectPath|default(app.request.requestUri) %}
{% set emptyTitle = emptyTitle|default('Aucun profil favori pour le moment.') %}
{% set emptyDescription = emptyDescription|default("Ajoute des profils depuis l'annuaire public ou depuis la fiche d'un développeur pour les retrouver ici.") %}

<div data-favorite-list="true" class="space-y-4">
    <div data-favorite-empty-state="true" class="{{ favoriteProfiles is empty ? '' : 'hidden ' }}premium-card-soft rounded-[1.75rem] border border-dashed premium-divider px-5 py-5">
        <p class="ui-title text-sm font-medium">{{ emptyTitle }}</p>
        <p class="ui-text-muted mt-2 text-sm">{{ emptyDescription }}</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {% for favorite in favoriteProfiles %}
            {% set profile = favorite.developerProfile %}
            {% set canOpenProfile = profile and profile.public and profile.portfolioGeneratedAt and profile.user and profile.user.status.value == 'active' %}

            <div
                data-favorite-entry="true"
                {% if canOpenProfile %}data-card-href="{{ path('app_public_profile_show', {slug: profile.slug}) }}" data-card-clickable="true" tabindex="0" role="link"{% endif %}
                class="premium-action-card rounded-[1.75rem] px-5 py-5 {{ canOpenProfile ? 'cursor-pointer' : '' }}"
            >
                <div class="flex h-full flex-col gap-4">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <p class="ui-title truncate text-sm font-semibold">{{ profile ? profile.firstName ~ ' ' ~ profile.lastName : 'Profil indisponible' }}</p>
                            <p class="ui-text-muted mt-1 text-sm">{{ profile and profile.headline ? profile.headline : 'Titre non renseigné' }}</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            {% if not canOpenProfile %}
                                <span class="ui-pill ui-pill-muted rounded-full px-3 py-1 text-xs font-semibold">
                                    Profil non consultable
                                </span>
                            {% endif %}

                            {% if profile %}
                                {% include 'recruiter/_favorite_toggle.html.twig' with {
                                    profile: profile,
                                    isFavorite: true,
                                    redirectPath: redirectPath,
                                    iconOnly: true,
                                    removeCardOnRemove: true
                                } only %}
                            {% endif %}
                        </div>
                    </div>

                    <div class="premium-divider mt-auto flex flex-wrap gap-2 border-t pt-4 text-xs">
                        <span class="ui-text-muted">{{ profile and (profile.city or profile.country) ? [profile.city, profile.country]|filter(v => v)|join(', ') : 'Localisation non renseignée' }}</span>
                        <span class="ui-text-soft">&bull;</span>
                        <span class="ui-text-muted">Ajouté le {{ favorite.createdAt ? favorite.createdAt|date('d/m/Y') : 'N/A' }}</span>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
