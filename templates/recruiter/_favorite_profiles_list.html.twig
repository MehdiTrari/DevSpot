{% set favoriteProfiles = favoriteProfiles|default([]) %}
{% set redirectPath = redirectPath|default(app.request.requestUri) %}
{% set experienceLevelLabels = experienceLevelLabels|default({
    'intern': 'Stagiaire',
    'junior': 'Junior',
    'mid': 'Intermédiaire',
    'senior': 'Senior',
    'lead': 'Lead'
}) %}
{% set locationTypeLabels = locationTypeLabels|default({
    'remote': 'Remote',
    'hybrid': 'Hybride',
    'onsite': 'Sur site'
}) %}
{% set emptyTitle = emptyTitle|default('Aucun profil favori pour le moment.') %}
{% set emptyDescription = emptyDescription|default("Ajoute des profils depuis la page d'accueil ou depuis une fiche portfolio pour les retrouver ici.") %}
{% set favoriteProfilesCount = favoriteProfilesCount|default(favoriteProfiles|length) %}
{% set currentPage = currentPage|default(1) %}
{% set totalPages = totalPages|default(1) %}

<div data-favorite-list="true" class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-[260px] w-full lg:w-1/2 lg:flex-none">
            <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3 transition focus-within:border-emerald-400/40 focus-within:ring-2 focus-within:ring-emerald-500/20">
                <svg class="h-5 w-5 shrink-0 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
                <input
                    id="favorites-search"
                    type="text"
                    placeholder="Rechercher par nom, titre, localisation…"
                    class="w-full bg-transparent text-sm text-white placeholder-slate-500 outline-none"
                >
            </div>
            <p id="favorites-search-count" class="mt-2 hidden text-xs text-slate-400"></p>
        </div>

        <div class="flex items-center gap-2">
            <span class="favorite-showcase-toolbar-pill inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold">
                Filtres
            </span>
            <span class="favorite-showcase-toolbar-pill inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold">
                Réinitialiser
            </span>
            <span data-favorite-count-value="true" class="favorite-showcase-toolbar-count inline-flex h-9 min-w-9 items-center justify-center rounded-full px-3 text-sm font-bold">
                {{ favoriteProfilesCount }}
            </span>
        </div>
    </div>

    <div data-favorite-empty-state="true" class="{{ favoriteProfiles is empty ? '' : 'hidden ' }}favorite-showcase-empty rounded-[2.2rem] px-6 py-10 text-center sm:px-8">
        <p class="ui-title text-xl font-semibold">{{ emptyTitle }}</p>
        <p class="ui-text-secondary mx-auto mt-3 max-w-2xl text-sm leading-relaxed sm:text-[15px]">{{ emptyDescription }}</p>
        <a href="{{ path('app_home') }}" class="favorite-showcase-primary-link mx-auto mt-6 max-w-xs">
            Explorer des profils
        </a>
    </div>

    <div class="favorite-showcase-grid">
        {% for favorite in favoriteProfiles %}
            {% set profile = favorite.developerProfile %}
            {% set canOpenProfile = profile and profile.public and profile.portfolioGeneratedAt and profile.user and profile.user.status.value == 'active' %}
            {% set isFeatured = loop.first %}
            {% set profileName = profile ? profile.firstName ~ ' ' ~ profile.lastName : 'Profil indisponible' %}
            {% set headline = profile and profile.headline ? profile.headline : 'Titre non renseigne' %}
            {% set experienceLabel = profile and profile.experienceLevel ? (experienceLevelLabels[profile.experienceLevel.value] ?? 'Niveau non renseigne') : 'Niveau non renseigne' %}
            {% set locationModeLabel = profile and profile.locationType ? (locationTypeLabels[profile.locationType.value] ?? null) : null %}
            {% set locationLabel = profile and (profile.city or profile.country) ? [profile.city, profile.country]|filter(v => v)|join(', ') : 'Localisation Non renseignée' %}
            {% set yearsValue = profile and profile.yearsExperience is not null ? profile.yearsExperience : null %}
            {% set portfolioLabel = profile and profile.portfolioGeneratedAt ? 'Portfolio publié' : 'Portfolio non généré' %}
            {% set statusLabel = canOpenProfile ? 'Consultable maintenant' : 'Profil non consultable' %}

            <article
                data-favorite-entry="true"
                {% if canOpenProfile %}data-card-href="{{ path('app_public_profile_show', {slug: profile.slug}) }}" data-card-clickable="true" tabindex="0" role="link"{% endif %}
                class="favorite-showcase-card {{ isFeatured ? 'favorite-showcase-card-featured' : '' }} {{ canOpenProfile ? 'cursor-pointer' : '' }}"
            >
                <div class="favorite-showcase-card-top p-6">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="favorite-showcase-card-badge {{ isFeatured ? 'favorite-showcase-card-badge-featured' : '' }}">
                                    {{ isFeatured ? 'Récent' : 'Favori' }}
                                </span>
                                <span class="favorite-showcase-card-badge favorite-showcase-card-badge-soft">
                                    {{ canOpenProfile ? 'Actif' : 'Archivé' }}
                                </span>
                            </div>
                            <h2 class="ui-title mt-5 truncate text-[1.30rem] font-semibold tracking-tight">{{ profileName }}</h2>
                            <p class="ui-text-secondary mt-2 text-[13px] leading-relaxed">{{ headline }}</p>
                        </div>

                        {% if profile %}
                            {% include 'recruiter/_favorite_toggle.html.twig' with {
                                profile: profile,
                                isFavorite: true,
                                redirectPath: redirectPath,
                                iconOnly: true,
                                removeCardOnRemove: true,
                                iconButtonClass: 'favorite-showcase-heart-button'
                            } only %}
                        {% endif %}
                    </div>

                    <div class="mt-4 flex items-end gap-2">
                        <p class="favorite-showcase-metric-value">{{ yearsValue is not null ? yearsValue : '—' }}</p>
                        <p class="favorite-showcase-metric-label text-[10px]">
                            {{ yearsValue is not null ? "ans d'expérience" : 'profil suivi' }}
                        </p>
                    </div>

                    <div class="mt-5 flex flex-wrap gap-2">
                        <span class="favorite-showcase-chip text-[10px]">{{ experienceLabel }}</span>
                        {% if locationModeLabel %}
                            <span class="favorite-showcase-chip text-[10px]">{{ locationModeLabel }}</span>
                        {% endif %}
                    </div>

                    {% if canOpenProfile %}
                        <a href="{{ path('app_public_profile_show', {slug: profile.slug}) }}" class="mt-7 inline-flex w-full items-center justify-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-2.5 text-sm font-semibold text-emerald-300 transition hover:bg-emerald-500/20">
                            Voir le profil
                        </a>
                    {% else %}
                        <span class="mt-7 inline-flex w-full items-center justify-center rounded-full border border-slate-500/30 bg-slate-500/10 px-4 py-2.5 text-sm font-semibold text-slate-300">
                            Profil indisponible
                        </span>
                    {% endif %}
                </div>

                <div class="favorite-showcase-card-divider px-6 pb-6 pt-5">
                    <ul class="favorite-showcase-feature-list">
                        <li class="favorite-showcase-feature-item text-[11px]">
                            <span class="favorite-showcase-feature-icon" aria-hidden="true">+</span>
                            <span>Ajouté le {{ favorite.createdAt ? favorite.createdAt|date('d/m/Y') : 'N/A' }}</span>
                        </li>
                    </ul>
                </div>
            </article>
        {% endfor %}
    </div>

    {% if totalPages > 1 %}
        <nav class="flex flex-wrap items-center justify-center gap-2" aria-label="Pagination des favoris">
            {% set prevPage = currentPage - 1 %}
            {% set nextPage = currentPage + 1 %}

            <a
                href="{{ currentPage > 1 ? path('app_recruiter_favorites', {page: prevPage}) : '#' }}"
                class="inline-flex items-center rounded-full border px-4 py-2 text-sm font-semibold transition {{ currentPage > 1 ? 'border-blue-200 bg-white text-slate-700 hover:bg-blue-50' : 'cursor-not-allowed border-slate-200 bg-slate-100 text-slate-400' }}"
                {% if currentPage <= 1 %}aria-disabled="true" tabindex="-1"{% endif %}
            >
                Précédent
            </a>

            <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">
                Page {{ currentPage }} / {{ totalPages }}
            </span>

            <a
                href="{{ currentPage < totalPages ? path('app_recruiter_favorites', {page: nextPage}) : '#' }}"
                class="inline-flex items-center rounded-full border px-4 py-2 text-sm font-semibold transition {{ currentPage < totalPages ? 'border-blue-200 bg-white text-slate-700 hover:bg-blue-50' : 'cursor-not-allowed border-slate-200 bg-slate-100 text-slate-400' }}"
                {% if currentPage >= totalPages %}aria-disabled="true" tabindex="-1"{% endif %}
            >
                Suivant
            </a>
        </nav>
    {% endif %}
</div>
