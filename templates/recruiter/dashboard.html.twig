{% extends 'base.html.twig' %}

{% block title %}Mon espace | DevSpot{% endblock %}

{% block body %}
    {% set mockJobs = [
        {
            title: 'Développeur Symfony confirmé',
            contract: 'CDI',
            status: 'Brouillon',
            applicants: 0
        },
        {
            title: 'Lead backend PHP / Symfony',
            contract: 'Temps plein',
            status: 'Publiée',
            applicants: 12
        }
    ] %}

    <section class="w-full max-w-6xl space-y-8 font-sans">
        <div class="ui-shell ui-shell-hover rounded-[2.5rem] p-8 backdrop-blur-2xl sm:p-10">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex-1">
                    <p class="ui-kicker mb-4 rounded-full px-3 py-1.5 text-xs font-semibold uppercase tracking-wider">
                        <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.6)] animate-pulse"></span>
                        Espace recruteur
                    </p>
                    <h1 class="ui-title text-4xl font-semibold tracking-tight">Bienvenue sur ton espace.</h1>
                    <p class="ui-text-muted mt-2 text-[15px]">Gère tes recherches de profils et suis tes interactions depuis un espace dédié.</p>
                </div>
            </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <article class="ui-shell rounded-[2rem] p-6 backdrop-blur-xl">
                <p class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Mes offres</p>
                <p class="ui-title mt-3 text-3xl font-semibold">{{ mockJobs|length }}</p>
                <p class="ui-text-muted mt-2 text-sm">Offre{{ mockJobs|length > 1 ? 's' : '' }} de poste pour définir votre espace de publication.</p>
            </article>

            <a href="{{ path('app_recruiter_favorites') }}" class="ui-shell ui-panel-accent-hover block rounded-[2rem] p-6 backdrop-blur-xl">
                <p class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Mes favoris</p>
                <p data-favorite-count-value="true" class="ui-title mt-3 text-3xl font-semibold">{{ favoriteProfilesCount|default(0) }}</p>
                <p class="ui-text-muted mt-2 text-sm">Retrouve rapidement les profils que tu as sauvegardés.</p>
            </a>
        </div>

        <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
            <div class="ui-shell rounded-[2rem] p-8 backdrop-blur-xl">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <h2 class="ui-title text-2xl font-semibold tracking-tight">Informations du compte recruteur</h2>
                        <p class="ui-text-muted mt-3 max-w-2xl text-[15px] leading-relaxed">
                            Cet espace te permet de centraliser tes recherches, préparer tes prises de contact et suivre les profils développeurs qui t'intéressent.
                        </p>
                    </div>
                </div>

                <div class="mt-6">
                    <article class="ui-panel rounded-[1.75rem] p-6">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <h3 class="ui-title text-lg font-semibold">Mes offres</h3>
                                <p class="ui-text-muted mt-1 text-sm">Prévisualisation des offres que vous pourrez publier et suivre.</p>
                            </div>
                            <span class="ui-pill ui-pill-success rounded-full px-3 py-1 text-xs font-semibold">Bientôt</span>
                        </div>

                        <div class="mt-5 space-y-3">
                            {% for job in mockJobs %}
                                <div class="ui-panel-subtle rounded-2xl px-4 py-4">
                                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                        <div>
                                            <p class="ui-title text-sm font-semibold">{{ job.title }}</p>
                                            <p class="ui-text-secondary mt-1 text-sm">{{ job.contract }}</p>
                                            <p class="ui-text-muted mt-2 text-xs">{{ job.applicants }} candidature{{ job.applicants > 1 ? 's' : '' }} simulée{{ job.applicants > 1 ? 's' : '' }} pour cette offre.</p>
                                        </div>
                                        <span class="ui-pill {{ job.status == 'Publiée' ? 'ui-pill-success' : 'ui-pill-warning' }} rounded-full px-2.5 py-1 text-xs font-semibold">{{ job.status }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </article>
                </div>
            </div>

            <aside class="space-y-6">
                <div class="ui-shell rounded-[2rem] p-6 backdrop-blur-xl">
                    <h2 class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Vue d'ensemble</h2>
                    <ul class="mt-5 space-y-3 text-[15px]">
                        <li class="ui-panel rounded-2xl px-4 py-3 ui-text-primary">
                            Recherche de développeurs à partir des portfolios publics.
                        </li>
                        <li class="ui-panel rounded-2xl px-4 py-3 ui-text-primary">
                            Suivi des profils favoris et des opportunités que vous préparez.
                        </li>
                        <li class="ui-panel rounded-2xl px-4 py-3 ui-text-primary">
                            Préparation des futures interactions recruteur dans un espace sécurisé.
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>
{% endblock %}
