{% extends 'base.html.twig' %}

{% block title %}Mon espace | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-5xl space-y-8 font-sans" data-controller="matching-preview" data-matching-preview-endpoint-value="{{ matchingPreviewEndpoint }}">
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:bg-slate-900/60 hover:shadow-emerald-500/10 sm:p-10">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex-1">
                    <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                        <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.6)] animate-pulse"></span>
                        Espace recruteur
                    </p>
                    <h1 class="text-4xl font-semibold tracking-tight text-white">Bienvenue sur ton espace.</h1>
                    <p class="mt-2 text-[15px] text-slate-400">Gère tes recherches de profils et suis tes interactions depuis un espace dédié.</p>
                </div>
            </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <a href="{{ path('app_recruiter_offers') }}" class="block rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl transition duration-300 hover:border-emerald-400/30 hover:bg-slate-900/70">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Mes offres</p>
                <p class="mt-3 text-3xl font-semibold text-white">{{ offersCount }}</p>
                <p class="mt-2 text-sm text-slate-400">Clique pour voir la liste complète des offres et leurs meilleurs matchs.</p>
            </a>

            <a href="{{ path('app_recruiter_favorites') }}" class="block rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl transition-all duration-300 hover:border-blue-300/40 hover:bg-blue-50/10">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Mes favoris</p>
                <p data-favorite-count-value="true" class="mt-3 text-3xl font-semibold text-white">{{ favoriteProfilesCount|default(0) }}</p>
                <p class="mt-2 text-sm text-slate-400">Retrouve rapidement les profils que tu as sauvegardés.</p>
            </a>
        </div>

        <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
            <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-xl transition-all duration-500">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <h2 class="text-2xl font-semibold tracking-tight text-white">Informations du compte recruteur</h2>
                        <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-slate-400">
                            Cet espace te permet de centraliser tes recherches, préparer tes prises de contact et suivre les profils développeurs qui t'intéressent.
                        </p>
                    </div>
                </div>

                <div class="mt-6">
                    <article class="rounded-[1.75rem] border border-white/10 bg-white/5 p-6">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <h3 class="text-lg font-semibold text-white">Mes offres</h3>
                                <p class="mt-1 text-sm text-slate-400">Clique sur une offre pour ouvrir ta liste dédiée.</p>
                            </div>
                            <a href="{{ path('app_recruiter_offers') }}" class="inline-flex items-center rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300 transition hover:bg-emerald-500/20">Voir mes offres</a>
                        </div>

                        <div class="mt-5 space-y-3">
                            {% for job in offerRows %}
                                <a href="{{ path('app_recruiter_offers') }}#offer-{{ job.id }}" class="block rounded-2xl border border-white/10 bg-slate-950/40 px-4 py-4 transition duration-300 hover:border-emerald-400/30 hover:bg-slate-950/60">
                                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                        <div>
                                            <p class="text-sm font-semibold text-white">{{ job.title }}</p>
                                            <p class="mt-1 text-sm text-slate-300">{{ job.contract }}</p>
                                            <p class="mt-2 text-xs text-slate-400">{{ job.applicants }} candidature{{ job.applicants > 1 ? 's' : '' }} simulée{{ job.applicants > 1 ? 's' : '' }} pour cette offre.</p>
                                            {% if job.topMatchPercentage is not null %}
                                                <p class="mt-2 text-xs text-emerald-300">Top matching enrichi : {{ job.topMatchPercentage|number_format(1, '.', ' ') }}%</p>
                                            {% endif %}
                                        </div>
                                        <span class="inline-flex items-center rounded-full border {{ job.isActive ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-300' : 'border-yellow-400/20 bg-yellow-400/10 text-yellow-300' }} px-2.5 py-1 text-xs font-semibold">{{ job.status }}</span>
                                    </div>
                                </a>
                            {% else %}
                                <div class="rounded-2xl border border-dashed border-white/10 bg-slate-950/30 px-4 py-5 text-sm text-slate-500">
                                    Aucune offre recruteur pour le moment.
                                </div>
                            {% endfor %}
                        </div>
                    </article>
                </div>
            </div>

            <aside class="space-y-6">
                <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Profils favoris</h2>
                    <div class="mt-5 space-y-3">
                        {% for favorite in favoriteRows %}
                            <a href="{{ path('app_public_profile_show', { slug: favorite.slug }) }}" class="block rounded-2xl border border-white/10 bg-white/5 px-4 py-3 transition duration-300 hover:border-emerald-400/30 hover:bg-white/10">
                                <div class="flex flex-col gap-3">
                                    <div class="flex items-start justify-between gap-4">
                                        <div>
                                            <p class="text-sm font-semibold text-white">{{ favorite.fullName }}</p>
                                            <p class="mt-1 text-sm text-slate-300">{{ favorite.headline }}</p>
                                        </div>
                                        {% if favorite.bestMatchPercentage is not null %}
                                            <span class="rounded-full border border-fuchsia-500/20 bg-fuchsia-500/10 px-2.5 py-1 text-xs font-semibold text-fuchsia-200">{{ favorite.bestMatchPercentage|number_format(1, '.', ' ') }}%</span>
                                        {% endif %}
                                    </div>
                                    <div class="flex flex-wrap gap-2 text-xs text-slate-400">
                                        <span>{{ favorite.location ?: 'Localisation non renseignée' }}</span>
                                        <span>•</span>
                                        <span>{{ favorite.availability }}</span>
                                        <span>•</span>
                                        <span>{{ favorite.yearsExperience }} an(s)</span>
                                    </div>
                                    {% if favorite.bestOfferTitle %}
                                        <p class="text-xs text-emerald-300">Meilleur match enrichi sur : {{ favorite.bestOfferTitle }}</p>
                                    {% endif %}
                                </div>
                            </a>
                        {% else %}
                            <div class="rounded-2xl border border-dashed border-white/10 bg-white/5 px-4 py-5 text-sm text-slate-500">
                                Aucun profil favori pour le moment.
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Vue d'ensemble</h2>
                    <ul class="mt-5 space-y-3 text-[15px] text-slate-300">
                        <li class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                            Recherche de développeurs à partir des portfolios publics.
                        </li>
                        <li class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                            Suivi des profils favoris et des opportunités que vous préparez.
                        </li>
                        <li class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                            Préparation des futures interactions recruteur dans un espace sécurisé.
                        </li>
                    </ul>
                </div>
            </aside>
        </div>

        <section class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-xl">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-emerald-300">Laboratoire matching</p>
                    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-white">Tester le matching directement dans le site</h2>
                    <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-slate-400">
                        Modifie le JSON, lance le test, puis vérifie le classement, le détail du score, l'anonymisation et l'indicateur de fairness sans passer par curl.
                    </p>
                </div>
                <button
                    type="button"
                    data-action="matching-preview#run"
                    class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-5 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-emerald-500/20 transition-all duration-300 hover:scale-[1.02] hover:bg-emerald-400 active:scale-95"
                >
                    Lancer le matching
                </button>
            </div>

            <div class="mt-6 grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
                <div class="space-y-3">
                    <label for="matching-preview-payload" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Payload JSON</label>
                    <textarea
                        id="matching-preview-payload"
                        data-matching-preview-target="payload"
                        class="min-h-[34rem] w-full rounded-[1.5rem] border border-white/10 bg-slate-950/70 px-4 py-4 font-mono text-sm leading-6 text-slate-100 outline-none transition duration-300 placeholder:text-slate-500 focus:border-emerald-400/60 focus:ring-2 focus:ring-emerald-500/20"
                        spellcheck="false"
                    >{{ matchingPreviewPayload }}</textarea>
                </div>

                <div class="space-y-4">
                    <div data-matching-preview-target="status" class="rounded-[1.5rem] border border-white/10 bg-white/5 px-4 py-4 text-sm text-slate-300">
                        Prêt à exécuter le scénario de test.
                    </div>

                    <div data-matching-preview-target="summary" class="hidden rounded-[1.5rem] border border-emerald-500/20 bg-emerald-500/10 p-5">
                        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-300">Synthèse</p>
                        <div class="mt-4 grid gap-3 sm:grid-cols-3">
                            <div class="rounded-2xl border border-white/10 bg-slate-950/40 px-4 py-3">
                                <p class="text-xs uppercase tracking-wider text-slate-400">Top candidat</p>
                                <p data-matching-preview-target="topCandidate" class="mt-2 text-lg font-semibold text-white">-</p>
                            </div>
                            <div class="rounded-2xl border border-white/10 bg-slate-950/40 px-4 py-3">
                                <p class="text-xs uppercase tracking-wider text-slate-400">Top enrichi</p>
                                <p data-matching-preview-target="topScore" class="mt-2 text-lg font-semibold text-white">-</p>
                            </div>
                            <div class="rounded-2xl border border-white/10 bg-slate-950/40 px-4 py-3">
                                <p class="text-xs uppercase tracking-wider text-slate-400">Fairness ratio</p>
                                <p data-matching-preview-target="fairness" class="mt-2 text-lg font-semibold text-white">-</p>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Résultats</h3>
                        <div data-matching-preview-target="results" class="mt-4 space-y-3">
                            <div class="rounded-[1.5rem] border border-dashed border-white/10 bg-slate-950/30 px-4 py-6 text-sm text-slate-500">
                                Aucun résultat affiché pour l'instant.
                            </div>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Réponse brute</h3>
                        <pre data-matching-preview-target="rawResponse" class="mt-4 max-h-[18rem] overflow-auto rounded-[1.5rem] border border-white/10 bg-slate-950/70 px-4 py-4 font-mono text-xs leading-6 text-slate-300">En attente d'un test.</pre>
                    </div>
                </div>
            </div>
        </section>
    </section>
{% endblock %}
