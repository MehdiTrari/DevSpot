{% extends 'base.html.twig' %}

{% block title %}Mon espace | DevSpot{% endblock %}

{% block body %}
    {% set mockJobs = [
        {
            title: 'Développeur Symfony confirmé',
            contract: 'CDI',
            status: 'Brouillon',
            applicants: 0
        },
        {
            title: 'Lead backend PHP / Symfony',
            contract: 'Temps plein',
            status: 'Publiée',
            applicants: 12
        }
    ] %}

    <section class="w-full max-w-5xl space-y-8 font-sans">
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:bg-slate-900/60 hover:shadow-emerald-500/10 sm:p-10">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex-1">
                    <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-300">
                        <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.6)] animate-pulse"></span>
                        Espace recruteur
                    </p>
                    <h1 class="text-4xl font-semibold tracking-tight text-white">Bienvenue sur ton espace.</h1>
                    <p class="mt-2 text-[15px] text-slate-400">Gère tes recherches de profils développeurs et suis tes interactions depuis un espace dédié.</p>
                </div>
            </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <article class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Mes offres</p>
                <p class="mt-3 text-3xl font-semibold text-white">{{ mockJobs|length }}</p>
                <p class="mt-2 text-sm text-slate-400">offre{{ mockJobs|length > 1 ? 's' : '' }} de poste fictive{{ mockJobs|length > 1 ? 's' : '' }} pour définir votre futur espace de publication.</p>
            </article>

            <article class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Favoris</p>
                <p class="mt-3 text-3xl font-semibold text-white">{{ favoriteProfilesCount|default(0) }}</p>
                <p class="mt-2 text-sm text-slate-400">profil{{ favoriteProfilesCount|default(0) > 1 ? 's' : '' }} développeur{{ favoriteProfilesCount|default(0) > 1 ? 's' : '' }} enregistré{{ favoriteProfilesCount|default(0) > 1 ? 's' : '' }}.</p>
            </article>
        </div>

        <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
            <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-xl transition-all duration-500 hover:bg-slate-900/60">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <h2 class="text-2xl font-semibold tracking-tight text-white">Informations du compte recruteur</h2>
                        <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-slate-400">
                            Cet espace te permet de centraliser tes recherches, préparer tes prises de contact et suivre les profils développeurs qui t'intéressent.
                        </p>
                    </div>
                </div>

                <div class="mt-8 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 p-5">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-emerald-300">Objectif de cet espace</h3>
                    <p class="mt-3 text-[15px] leading-relaxed text-emerald-100/90">
                        Utilise ce dashboard pour explorer les portfolios publics, identifier les bons profils techniques et suivre tes futures interactions avec les développeurs présents sur DevSpot.
                    </p>
                </div>

                <div class="mt-6">
                    <article class="rounded-[1.75rem] border border-white/10 bg-white/5 p-6">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <h3 class="text-lg font-semibold text-white">Mes offres</h3>
                                <p class="mt-1 text-sm text-slate-400">Prévisualisation des offres que vous pourrez publier et suivre.</p>
                            </div>
                            <span class="inline-flex items-center rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300">Bientôt</span>
                        </div>

                        <div class="mt-5 space-y-3">
                            {% for job in mockJobs %}
                                <div class="rounded-2xl border border-white/10 bg-slate-950/40 px-4 py-4">
                                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                        <div>
                                            <p class="text-sm font-semibold text-white">{{ job.title }}</p>
                                            <p class="mt-1 text-sm text-slate-300">{{ job.contract }}</p>
                                            <p class="mt-2 text-xs text-slate-400">{{ job.applicants }} candidature{{ job.applicants > 1 ? 's' : '' }} simulée{{ job.applicants > 1 ? 's' : '' }} pour cette offre.</p>
                                        </div>
                                        <span class="inline-flex items-center rounded-full border {{ job.status == 'Publiée' ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-300' : 'border-yellow-400/20 bg-yellow-400/10 text-yellow-300' }} px-2.5 py-1 text-xs font-semibold">{{ job.status }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </article>
                </div>
            </div>

            <aside class="space-y-6">
                <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Profils favoris</h2>
                    <div class="mt-5 space-y-3">
                        {% if favoriteProfiles|default([]) is empty %}
                            <div class="rounded-2xl border border-dashed border-white/10 bg-white/5 px-4 py-4">
                                <p class="text-sm font-medium text-white">Aucun profil favori pour le moment.</p>
                                <p class="mt-2 text-sm text-slate-400">Ajoute des profils depuis l’annuaire public ou depuis la fiche d’un développeur pour les retrouver ici.</p>
                            </div>
                        {% else %}
                            {% for favorite in favoriteProfiles %}
                                {% set profile = favorite.developerProfile %}
                                {% set canOpenProfile = profile and profile.public and profile.portfolioGeneratedAt and profile.user and profile.user.status.value == 'active' %}
                                <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-4">
                                    <div class="flex flex-col gap-4">
                                        <div class="flex items-start justify-between gap-4">
                                            <div class="min-w-0">
                                                <p class="text-sm font-semibold text-white">{{ profile ? profile.firstName ~ ' ' ~ profile.lastName : 'Profil indisponible' }}</p>
                                                <p class="mt-1 text-sm text-slate-300">{{ profile and profile.headline ? profile.headline : 'Titre non renseigné' }}</p>
                                            </div>
                                            <span class="inline-flex shrink-0 items-center rounded-full border {{ profile and profile.public ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-300' : 'border-yellow-400/20 bg-yellow-400/10 text-yellow-300' }} px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider">
                                                {{ profile and profile.public ? 'Public' : 'Privé' }}
                                            </span>
                                        </div>

                                        <div class="flex flex-wrap gap-2 text-xs text-slate-400">
                                            <span>{{ profile and (profile.city or profile.country) ? [profile.city, profile.country]|filter(v => v)|join(', ') : 'Localisation non renseignée' }}</span>
                                            <span>•</span>
                                            <span>Ajouté le {{ favorite.createdAt ? favorite.createdAt|date('d/m/Y') : 'N/A' }}</span>
                                        </div>

                                        <div class="flex flex-wrap items-center gap-3">
                                            {% if canOpenProfile %}
                                                <a href="{{ path('app_public_profile_show', {slug: profile.slug}) }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10 active:scale-95">
                                                    Voir le profil
                                                </a>
                                            {% else %}
                                                <span class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-400">
                                                    Profil non consultable
                                                </span>
                                            {% endif %}

                                            {% if profile %}
                                                {% include 'recruiter/_favorite_toggle.html.twig' with {
                                                    profile: profile,
                                                    isFavorite: true,
                                                    redirectPath: path('app_recruiter_home'),
                                                    removeLabel: 'Retirer'
                                                } only %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>

                <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Vue d'ensemble</h2>
                    <ul class="mt-5 space-y-3 text-[15px] text-slate-300">
                        <li class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                            Recherche de développeurs à partir des portfolios publics.
                        </li>
                        <li class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                            Suivi des profils favoris et des opportunités que vous préparez.
                        </li>
                        <li class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                            Préparation des futures interactions recruteur dans un espace sécurisé.
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>
{% endblock %}
