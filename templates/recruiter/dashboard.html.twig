{% extends 'base.html.twig' %}

{% block title %}Mon espace | DevSpot{% endblock %}

{% block body %}
    {% set mockJobs = [
        {
            title: 'Développeur Symfony confirmé',
            contract: 'CDI',
            status: 'Brouillon',
            applicants: 0
        },
        {
            title: 'Lead backend PHP / Symfony',
            contract: 'Temps plein',
            status: 'Publiée',
            applicants: 12
        }
    ] %}

    <section class="w-full max-w-6xl space-y-8 font-sans">
        <div class="favorite-showcase-hero mx-auto w-full max-w-5xl px-1 py-2 text-center sm:px-2 sm:py-3">
            <div class="mx-auto max-w-3xl">
                    <p class="favorite-showcase-kicker">
                        Espace recruteur
                    </p>
                    <h1 class="ui-title mt-6 text-3xl font-semibold tracking-tight sm:text-4xl">Mon dashboard.</h1>
                    <p class="ui-text-secondary mt-4 max-w-2xl text-[15px]">Gère tes recherches de profils et suis tes interactions depuis un espace dédié.</p>
            </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <article class="premium-stat-card rounded-[1.9rem] p-6">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Mes offres</p>
                        <p class="ui-title mt-3 text-3xl font-semibold">{{ mockJobs|length }}</p>
                        <p class="ui-text-muted mt-2 text-sm">Offre{{ mockJobs|length > 1 ? 's' : '' }} de poste pour définir votre espace de publication.</p>
                    </div>
                    <span class="premium-icon premium-icon-info">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3 4 7v10l8 4 8-4V7z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m4 7 8 4 8-4"></path>
                        </svg>
                    </span>
                </div>
            </article>

            <a href="{{ path('app_recruiter_favorites') }}" class="premium-stat-card premium-action-card block rounded-[1.9rem] p-6">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Mes favoris</p>
                        <p data-favorite-count-value="true" class="ui-title mt-3 text-3xl font-semibold">{{ favoriteProfilesCount|default(0) }}</p>
                        <p class="ui-text-muted mt-2 text-sm">Retrouve rapidement les profils que tu as sauvegardés.</p>
                    </div>
                    <span class="premium-icon premium-icon-success">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m12 21-1.45-1.32C5.4 15.04 2 11.95 2 8.15 2 5.06 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.06 22 8.15c0 3.8-3.4 6.89-8.55 11.54z"></path>
                        </svg>
                    </span>
                </div>
            </a>
        </div>

        <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
            <div class="theme-settings-card rounded-[2.35rem] p-8">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <h2 class="ui-title text-2xl font-semibold tracking-tight">Informations du compte recruteur</h2>
                        <p class="ui-text-muted mt-3 max-w-2xl text-[15px] leading-relaxed">
                            Cet espace te permet de centraliser tes recherches, préparer tes prises de contact et suivre les profils développeurs qui t'intéressent.
                        </p>
                    </div>
                    <span class="premium-kicker rounded-full px-3 py-1.5 text-xs font-semibold">Pilotage en cours</span>
                </div>

                <div class="mt-6">
                    <article class="premium-card rounded-[1.9rem] p-6">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <h3 class="ui-title text-lg font-semibold">Mes offres</h3>
                                <p class="ui-text-muted mt-1 text-sm">Prévisualisation des offres que vous pourrez publier et suivre.</p>
                            </div>
                            <span class="ui-pill ui-pill-success rounded-full px-3 py-1 text-xs font-semibold">Bientôt</span>
                        </div>

                        <div class="mt-5 space-y-3">
                            {% for job in mockJobs %}
                                <div class="premium-list-row rounded-[1.4rem] px-4 py-4">
                                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                        <div>
                                            <p class="ui-title text-sm font-semibold">{{ job.title }}</p>
                                            <p class="ui-text-secondary mt-1 text-sm">{{ job.contract }}</p>
                                            <p class="ui-text-muted mt-2 text-xs">{{ job.applicants }} candidature{{ job.applicants > 1 ? 's' : '' }} simulée{{ job.applicants > 1 ? 's' : '' }} pour cette offre.</p>
                                        </div>
                                        <span class="ui-pill {{ job.status == 'Publiée' ? 'ui-pill-success' : 'ui-pill-warning' }} rounded-full px-2.5 py-1 text-xs font-semibold">{{ job.status }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </article>
                </div>
            </div>

            <aside class="space-y-6">
                <div class="theme-settings-card rounded-[2.35rem] p-6">
                    <h2 class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Vue d'ensemble</h2>
                    <ul class="mt-5 space-y-3 text-[15px]">
                        <li class="premium-list-row rounded-[1.4rem] px-4 py-3 ui-text-primary">
                            Recherche de développeurs à partir des portfolios publics.
                        </li>
                        <li class="premium-list-row rounded-[1.4rem] px-4 py-3 ui-text-primary">
                            Suivi des profils favoris et des opportunités que vous préparez.
                        </li>
                        <li class="premium-list-row rounded-[1.4rem] px-4 py-3 ui-text-primary">
                            Préparation des futures interactions recruteur dans un espace sécurisé.
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>
{% endblock %}
