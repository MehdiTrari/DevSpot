{% extends 'base.html.twig' %}

{% block title %}Mes favoris | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-6xl self-start space-y-8 font-sans">
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-500 hover:shadow-emerald-500/10 sm:p-8">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex-1">
                    <h1 class="text-3xl font-semibold tracking-tight text-white">Tes profils favoris.</h1>
                    <p class="mt-2 text-sm text-slate-400">Ici sont regroupés les profils qui t'intéressent.</p>
                </div>

                <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm text-slate-300 shadow-inner sm:min-w-72">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Profil(s) enregistré(s)</p>
                    <p data-favorite-count-value="true" class="mt-1 text-2xl font-semibold text-white">{{ favoriteProfilesCount|default(0) }}</p>
                </div>
            </div>
        </div>

        <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
            {# Search / filter bar #}
            <div class="mb-5">
                <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3 transition focus-within:border-emerald-400/40 focus-within:ring-2 focus-within:ring-emerald-500/20">
                    <svg class="h-5 w-5 shrink-0 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
                    <input
                        id="favorites-search"
                        type="text"
                        placeholder="Rechercher par nom, titre, localisation…"
                        class="w-full bg-transparent text-sm text-white placeholder-slate-500 outline-none"
                    >
                </div>
                <p id="favorites-search-count" class="mt-2 hidden text-xs text-slate-400"></p>
            </div>

            {% include 'recruiter/_favorite_profiles_list.html.twig' with {
                favoriteProfiles: favoriteProfiles|default([]),
                redirectPath: path('app_recruiter_favorites')
            } only %}
        </div>
    </section>

    <script>
    (() => {
        const init = () => {
            const input = document.getElementById('favorites-search');
            const countEl = document.getElementById('favorites-search-count');
            if (!input) return;
            if (input.dataset.init === '1') return;
            input.dataset.init = '1';

            const cards = Array.from(document.querySelectorAll('[data-favorite-entry="true"]'));
            const emptyState = document.querySelector('[data-favorite-empty-state="true"]');
            if (!cards.length) return;

            input.addEventListener('input', () => {
                const q = input.value.trim().toLowerCase();
                let visible = 0;

                cards.forEach(card => {
                    const text = card.textContent.toLowerCase();
                    const match = !q || text.includes(q);
                    card.style.display = match ? '' : 'none';
                    if (match) visible++;
                });

                if (q) {
                    countEl.textContent = `${visible} résultat${visible !== 1 ? 's' : ''} sur ${cards.length}`;
                    countEl.classList.remove('hidden');
                } else {
                    countEl.classList.add('hidden');
                }

                if (emptyState) {
                    emptyState.style.display = (visible === 0 && q) ? '' : 'none';
                    if (visible === 0 && q) {
                        emptyState.querySelector('p')?.replaceWith(Object.assign(document.createElement('p'), {
                            className: 'text-sm font-medium text-white',
                            textContent: `Aucun profil ne correspond à « ${input.value.trim()} ».`
                        }));
                    }
                }
            });
        };
        document.addEventListener('DOMContentLoaded', init);
        document.addEventListener('turbo:load', init);
    })();
    </script>
{% endblock %}
