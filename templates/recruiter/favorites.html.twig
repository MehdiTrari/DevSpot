{% extends 'base.html.twig' %}

{% block title %}Mes favoris | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-6xl self-start font-sans">
        <div class="theme-settings-card rounded-[2.75rem] p-6 sm:p-8">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex-1">
                    <p class="premium-kicker mb-4 inline-flex rounded-full px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.24em]">
                        Favoris recruteur
                    </p>
                    <h1 class="ui-title text-3xl font-semibold tracking-tight">Tes profils favoris.</h1>
                    <p class="ui-text-muted mt-2 text-sm">Ici sont regroupés les profils qui t'intéressent.</p>
                </div>

                <div class="premium-card-soft rounded-[1.75rem] p-4 text-sm sm:min-w-72">
                    <p class="ui-text-muted text-xs font-semibold uppercase tracking-wider">Profil(s) enregistré(s)</p>
                    <p data-favorite-count-value="true" class="ui-title mt-1 text-2xl font-semibold">{{ favoriteProfilesCount|default(0) }}</p>
                </div>
            </div>

            <div class="premium-divider mt-10 border-t pt-8">
                {% include 'recruiter/_favorite_profiles_list.html.twig' with {
                    favoriteProfiles: favoriteProfiles|default([]),
                    redirectPath: path('app_recruiter_favorites')
                } only %}
            </div>
        </div>
    </section>
{% endblock %}
