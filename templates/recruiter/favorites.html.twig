{% extends 'base.html.twig' %}

{% block title %}Mes favoris | DevSpot{% endblock %}

{% block body %}
    {% set experienceLevelLabels = {
        'intern': 'Stagiaire',
        'junior': 'Junior',
        'mid': 'Intermediaire',
        'senior': 'Senior',
        'lead': 'Lead'
    } %}
    {% set locationTypeLabels = {
        'remote': 'Remote',
        'hybrid': 'Hybride',
        'onsite': 'Sur site'
    } %}

    <section class="favorites-showcase-page relative z-[1] w-full max-w-[86rem] self-start px-5 pb-8 pt-2 font-sans sm:px-8 sm:pb-10 sm:pt-3 lg:px-10 lg:pb-12 lg:pt-4">
        <div class="favorite-showcase-hero mx-auto max-w-3xl text-center">
            <p class="favorite-showcase-kicker">
                Collection recruteur
            </p>
            <h1 class="ui-title mt-6 text-3xl font-semibold tracking-tight sm:text-4xl">Mes profils favoris.</h1>
            <p class="ui-text-secondary mx-auto mt-4 max-w-2xl text-[13px] leading-relaxed sm:text-[15px]">
                Retrouve ici les profils les plus prometteurs, compare-les rapidement et ouvre leur portfolio dès que tu veux.
            </p>
        </div>

        <div class="mt-10 lg:mt-12">
            <div class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
                {% include 'recruiter/_favorite_profiles_list.html.twig' with {
                    favoriteProfiles: favoriteProfiles|default([]),
                    redirectPath: path('app_recruiter_favorites'),
                    experienceLevelLabels: experienceLevelLabels,
                    locationTypeLabels: locationTypeLabels,
                    favoriteProfilesCount: favoriteProfilesCount|default(0),
                    currentPage: currentPage|default(1),
                    totalPages: totalPages|default(1)
                } only %}
            </div>
        </div>


        <p class="favorite-showcase-footnote mt-10 text-center text-sm sm:text-[15px]">
            Garde sous la main les profils à fort potentiel et retire-les instantanément quand ta short-list évolue.
        </p>
    </section>

    <script>
    (() => {
        const init = () => {
            const input = document.getElementById('favorites-search');
            const countEl = document.getElementById('favorites-search-count');
            if (!input) return;
            if (input.dataset.init === '1') return;
            input.dataset.init = '1';

            const cards = Array.from(document.querySelectorAll('[data-favorite-entry="true"]'));
            const emptyState = document.querySelector('[data-favorite-empty-state="true"]');
            if (!cards.length) return;

            input.addEventListener('input', () => {
                const q = input.value.trim().toLowerCase();
                let visible = 0;

                cards.forEach(card => {
                    const text = card.textContent.toLowerCase();
                    const match = !q || text.includes(q);
                    card.style.display = match ? '' : 'none';
                    if (match) visible++;
                });

                if (q) {
                    countEl.textContent = `${visible} résultat${visible !== 1 ? 's' : ''} sur ${cards.length}`;
                    countEl.classList.remove('hidden');
                } else {
                    countEl.classList.add('hidden');
                }

                if (emptyState) {
                    emptyState.style.display = (visible === 0 && q) ? '' : 'none';
                    if (visible === 0 && q) {
                        emptyState.querySelector('p')?.replaceWith(Object.assign(document.createElement('p'), {
                            className: 'text-sm font-medium text-white',
                            textContent: `Aucun profil ne correspond à « ${input.value.trim()} ».`
                        }));
                    }
                }
            });
        };
        document.addEventListener('DOMContentLoaded', init);
        document.addEventListener('turbo:load', init);
    })();
    </script>
{% endblock %}
