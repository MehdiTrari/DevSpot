{% extends 'base.html.twig' %}

{% block title %}Matching Demo | DevSpot{% endblock %}

{% block body %}
    <section class="w-full max-w-6xl space-y-8 font-sans">
        <div class="rounded-[2.5rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl sm:p-10">
            <p class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-300">
                Démo matching
            </p>
            <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white">Offres, profils complets et pourcentages de matching</h1>
            <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-slate-400">
                Cette page exploite les vraies entités DevSpot en base. Les développeurs reprennent les champs exacts du site
                (identité, bio, localisation, experience, compétences, expériences, formations et postes recherchés), puis chaque offre est comparée aux profils avec un score baseline et un score sémantique CamemBERT.
            </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
            <article class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Développeurs</p>
                <p class="mt-3 text-3xl font-semibold text-white">{{ developersCount }}</p>
                <p class="mt-2 text-sm text-slate-400">profils chargés depuis la base.</p>
            </article>
            <article class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Offres</p>
                <p class="mt-3 text-3xl font-semibold text-white">{{ offersCount }}</p>
                <p class="mt-2 text-sm text-slate-400">offres actives comparées aux profils.</p>
            </article>
            <article class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Jeu de données</p>
                <p class="mt-3 text-sm font-semibold text-white">{{ datasetPath }}</p>
                <p class="mt-2 text-sm text-slate-400">Compte recruteur démo : <span class="text-slate-200">recruiter.demo@demo.devspot.local / Demo1234!</span></p>
            </article>
        </div>

        {% if totalPages > 1 %}
            <section class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Pagination des offres</p>
                        <p class="mt-2 text-sm text-slate-300">Affichage d'une offre par page pour lire le matching plus facilement.</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {% if currentPage > 1 %}
                            <a href="{{ path('app_matching_demo', { page: currentPage - 1 }) }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10">
                                ← Offre précédente
                            </a>
                        {% endif %}
                        {% if currentPage < totalPages %}
                            <a href="{{ path('app_matching_demo', { page: currentPage + 1 }) }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10">
                                Offre suivante →
                            </a>
                        {% endif %}
                    </div>
                </div>

                <div class="mt-5 flex flex-wrap gap-2">
                    {% for title in offerTitles %}
                        <a
                            href="{{ path('app_matching_demo', { page: loop.index }) }}"
                            class="rounded-full border px-3 py-2 text-xs font-semibold transition-all duration-300 {{ currentPage == loop.index ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-200' : 'border-white/10 bg-white/5 text-slate-300 hover:bg-white/10' }}"
                        >
                            {{ loop.index }}. {{ title }}
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if matchingMatrix is empty %}
            <div class="rounded-[2rem] border border-dashed border-white/10 bg-slate-900/30 px-6 py-10 text-center text-slate-400">
                Aucun dataset chargé. Lance <code class="rounded bg-white/10 px-2 py-1 text-slate-100">php bin/console app:seed:matching-demo</code>.
            </div>
        {% endif %}

        {% for offerMatch in matchingMatrix %}
            <section class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-xl">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                    <div class="max-w-3xl">
                        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-300">Offre #{{ offerMatch.offer.id }}</p>
                        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-white">{{ offerMatch.offer.title }}</h2>
                        <div class="mt-3">
                            {% if offerMatch.semantic.available %}
                                <span class="inline-flex items-center rounded-full border border-violet-500/20 bg-violet-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-violet-200">CamemBERT actif</span>
                            {% else %}
                                <span class="inline-flex items-center rounded-full border border-amber-500/20 bg-amber-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-amber-200">CamemBERT indisponible</span>
                            {% endif %}
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-300">
                            {% if offerMatch.offer.location %}
                                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{{ offerMatch.offer.location }}</span>
                            {% endif %}
                            {% if offerMatch.offer.locationType %}
                                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{{ offerMatch.offer.locationType }}</span>
                            {% endif %}
                            {% if offerMatch.offer.contractType %}
                                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{{ offerMatch.offer.contractType }}</span>
                            {% endif %}
                            {% if offerMatch.offer.experienceLevel is not null %}
                                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{{ offerMatch.offer.experienceLevel }} ans visés</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-3">
                        <div class="rounded-[1.5rem] border border-emerald-500/20 bg-emerald-500/10 p-5">
                            <p class="text-xs font-semibold uppercase tracking-wider text-emerald-200">Fairness baseline</p>
                            <p class="mt-2 text-2xl font-semibold text-white">{{ offerMatch.fairness.disparate_impact_ratio }}</p>
                            <p class="mt-1 text-sm text-emerald-100/80">ratio junior / non-junior</p>
                        </div>
                        <div class="rounded-[1.5rem] border border-violet-500/20 bg-violet-500/10 p-5">
                            <p class="text-xs font-semibold uppercase tracking-wider text-violet-200">Fairness CamemBERT</p>
                            <p class="mt-2 text-2xl font-semibold text-white">
                                {% if offerMatch.semantic.available %}
                                    {{ offerMatch.semantic.fairness.disparate_impact_ratio }}
                                {% else %}
                                    —
                                {% endif %}
                            </p>
                            <p class="mt-1 text-sm text-violet-100/80">
                                {% if offerMatch.semantic.available %}
                                    ratio junior / non-junior
                                {% else %}
                                    démarre le service ML pour comparer
                                {% endif %}
                            </p>
                        </div>
                        <div class="rounded-[1.5rem] border border-fuchsia-500/20 bg-fuchsia-500/10 p-5">
                            <p class="text-xs font-semibold uppercase tracking-wider text-fuchsia-200">Fairness enrichi</p>
                            <p class="mt-2 text-2xl font-semibold text-white">
                                {% if offerMatch.enriched.available %}
                                    {{ offerMatch.enriched.fairness.disparate_impact_ratio }}
                                {% else %}
                                    —
                                {% endif %}
                            </p>
                            <p class="mt-1 text-sm text-fuchsia-100/80">
                                {% if offerMatch.enriched.available %}
                                    après inférence de compétences
                                {% else %}
                                    service ML indisponible
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>

                <div class="mt-6 grid gap-4 lg:grid-cols-2">
                    <article class="rounded-[1.5rem] border border-white/10 bg-white/5 p-5">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Hard skills extraites</h3>
                        <div class="mt-4 flex flex-wrap gap-2">
                            {% for item in offerMatch.extractedRequirements.hardSkills %}
                                <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-200">{{ item }}</span>
                            {% else %}
                                <span class="text-sm text-slate-500">Aucune compétence dure détectée dans le texte.</span>
                            {% endfor %}
                        </div>
                    </article>
                    <article class="rounded-[1.5rem] border border-white/10 bg-white/5 p-5">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Soft skills extraites</h3>
                        <div class="mt-4 flex flex-wrap gap-2">
                            {% for item in offerMatch.extractedRequirements.softSkills %}
                                <span class="u-border-pale-pink u-bg-pale-pink u-text-pale-pink rounded-full border px-3 py-1 text-xs font-semibold">{{ item }}</span>
                            {% else %}
                                <span class="text-sm text-slate-500">Aucune soft skill détectée dans le texte.</span>
                            {% endfor %}
                        </div>
                    </article>
                </div>

                <div class="mt-6 space-y-4">
                    {% for match in offerMatch.matches %}
                        <article class="rounded-[1.5rem] border border-white/10 bg-slate-950/40 p-5">
                            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Développeur #{{ match.developerId }}</p>
                                    <h3 class="mt-2 text-xl font-semibold text-white">
                                        {% if match.slug %}
                                            <a href="{{ path('app_public_profile_show', { slug: match.slug }) }}" class="hover:text-emerald-300">{{ match.fullName }}</a>
                                        {% else %}
                                            {{ match.fullName }}
                                        {% endif %}
                                    </h3>
                                    <p class="mt-1 text-sm text-slate-300">{{ match.headline }}</p>
                                    <p class="mt-2 text-sm text-slate-400">{{ match.yearsExperience }} an(s) d'expérience</p>
                                </div>
                                <div class="rounded-[1.5rem] border border-emerald-500/20 bg-emerald-500/10 px-5 py-4 text-right">
                                    <p class="text-xs font-semibold uppercase tracking-wider text-emerald-200">Matching enrichi</p>
                                    <p class="mt-1 text-3xl font-semibold text-white">{% if match.semanticEnrichedPercentage is not null %}
                                            {{ match.semanticEnrichedPercentage }}%
                                        {% else %}
                                            —
                                        {% endif %}</p>
                                    <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-violet-200">Matching CamemBERT</p>
                                    <p class="mt-1 text-xl font-semibold text-white">
                                        {% if match.semanticPercentage is not null %}
                                            {{ match.semanticPercentage }}%
                                        {% else %}
                                            —
                                        {% endif %}
                                    </p>
                                    <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-fuchsia-200">Matching baseline</p>
                                    <p class="mt-1 text-xl font-semibold text-white">{{ match.percentage }}%</p>
                                </div>
                            </div>

                            <div class="mt-4 grid gap-3 sm:grid-cols-5">
                                <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                                    <p class="text-xs uppercase tracking-wider text-slate-400">Hard skills</p>
                                    <p class="mt-2 text-sm font-semibold text-white">{{ (match.scoreBreakdown.hard_skills * 100)|number_format(1, '.', ' ') }}%</p>
                                </div>
                                <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                                    <p class="text-xs uppercase tracking-wider text-slate-400">Soft skills</p>
                                    <p class="mt-2 text-sm font-semibold text-white">{{ (match.scoreBreakdown.soft_skills * 100)|number_format(1, '.', ' ') }}%</p>
                                </div>
                                <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                                    <p class="text-xs uppercase tracking-wider text-slate-400">Junior boost</p>
                                    <p class="mt-2 text-sm font-semibold text-white">{{ (match.scoreBreakdown.junior_boost * 100)|number_format(1, '.', ' ') }}%</p>
                                </div>
                                <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                                    <p class="text-xs uppercase tracking-wider text-slate-400">CamemBERT</p>
                                    <p class="mt-2 text-sm font-semibold text-white">
                                        {% if match.semanticPercentage is not null %}
                                            {{ match.semanticPercentage|number_format(1, '.', ' ') }}%
                                        {% else %}
                                            Service indisponible
                                        {% endif %}
                                    </p>
                                </div>
                                <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                                    <p class="text-xs uppercase tracking-wider text-slate-400">Enrichi</p>
                                    <p class="mt-2 text-sm font-semibold text-white">
                                        {% if match.semanticEnrichedPercentage is not null %}
                                            {{ match.semanticEnrichedPercentage|number_format(1, '.', ' ') }}%
                                        {% else %}
                                            Service indisponible
                                        {% endif %}
                                    </p>
                                </div>
                            </div>

                            <div class="mt-4 grid gap-4 lg:grid-cols-2">
                                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Correspondances hard skills</p>
                                    <div class="mt-3 flex flex-wrap gap-2">
                                        {% for skill in match.matchedHardSkills %}
                                            <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-200">{{ skill }}</span>
                                        {% else %}
                                            <span class="text-sm text-slate-500">Aucune correspondance détectée.</span>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Correspondances soft skills</p>
                                    <div class="mt-3 flex flex-wrap gap-2">
                                        {% for skill in match.matchedSoftSkills %}
                                            <span class="u-border-pale-pink u-bg-pale-pink u-text-pale-pink rounded-full border px-3 py-1 text-xs font-semibold">{{ skill }}</span>
                                        {% else %}
                                            <span class="text-sm text-slate-500">Aucune correspondance détectée.</span>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 rounded-2xl border border-white/10 bg-white/5 p-4">
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Compétences implicites inférées</p>
                                <div class="mt-3 flex flex-wrap gap-2">
                                    {% for skill in match.inferredSoftSkills %}
                                        <span class="u-border-pale-pink u-bg-pale-pink u-text-pale-pink rounded-full border px-3 py-1 text-xs font-semibold">{{ skill }}</span>
                                    {% endfor %}
                                    {% for skill in match.inferredTransferableSkills %}
                                        <span class="rounded-full border border-amber-500/20 bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-200">{{ skill }}</span>
                                    {% endfor %}
                                    {% for technicalSkill in match.inferredTechnicalSkills %}
                                        <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-200">{{ technicalSkill.skill }} · {{ technicalSkill.level }}</span>
                                    {% endfor %}
                                    {% if match.inferredSoftSkills is empty and match.inferredTransferableSkills is empty and match.inferredTechnicalSkills is empty %}
                                        <span class="text-sm text-slate-500">Aucune compétence implicite détectée.</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="mt-4 rounded-2xl border border-white/10 bg-white/5 p-4">
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">CV anonymisé utilisé pour le test</p>
                                <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-slate-200">{{ match.anonymizedCv }}</p>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}

        <section class="rounded-[2rem] border border-white/10 bg-slate-900/50 p-8 shadow-2xl shadow-black/40 backdrop-blur-xl">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-2xl font-semibold tracking-tight text-white">JSON utilisé pour le seed</h2>
                    <p class="mt-3 text-[15px] text-slate-400">Le chargement du JSON complet est maintenant désactivé par défaut pour garder la page fluide.</p>
                </div>
                {% if showDatasetJson %}
                    <a href="{{ path('app_matching_demo', { page: currentPage }) }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10">Masquer le JSON</a>
                {% else %}
                    <a href="{{ path('app_matching_demo', { page: currentPage, showDataset: 1 }) }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10">Afficher le JSON complet</a>
                {% endif %}
            </div>

            {% if datasetJson %}
                <pre class="mt-6 max-h-[34rem] overflow-auto rounded-[1.5rem] border border-white/10 bg-slate-950/70 px-4 py-4 font-mono text-xs leading-6 text-slate-300">{{ datasetJson }}</pre>
            {% endif %}
        </section>
    </section>
{% endblock %}
